---
/**
 * Shared property detail UI for can-ho, tho-cu and biet-thu.
 * Usage: <PropertyDetail property={entry.data} kind="can-ho"><Content /></PropertyDetail>
 * kind: 'can-ho' | 'tho-cu' | 'biet-thu'
 */
interface Property {
  title: string;
  description?: string | null;
  image?: string | null;
  imageAlt?: string | null;
  gallery?: string[] | null;
  price?: string | null;
  priceValue?: number | null; // million VND
  area?: string | null;
  areaValue?: number | null; // square metres
  bedrooms?: number | null;
  bathrooms?: number | null;
  floors?: number | null;
  frontage?: string | null;
  address?: string | null;
  district?: string | null;
  ward?: string | null;
  direction?: string | null;
  legal?: string | null;
  transaction?: 'ban' | 'cho-thue' | 'cho-thue-ngay';
  listingStatus?: 'available' | 'closed' | 'paused';
  propertyType?: string | null;
}
interface Props {
  property: Property;
  kind?: 'can-ho' | 'tho-cu' | 'biet-thu';
  phone?: string;
  zalo?: string;
}
const {
  property,
  kind = 'can-ho',
  phone = '0869437415',
  zalo = '0869437415',
} = Astro.props;
const gallery = Array.from(new Set([property.image, ...(property.gallery ?? [])].filter((item): item is string => typeof item === 'string' && item.trim().length > 0)));
const isSale = (property.transaction ?? 'ban') === 'ban';
const pricePerSqm = isSale && typeof property.priceValue === 'number' && property.priceValue > 0 && typeof property.areaValue === 'number' && property.areaValue > 0
  ? new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 2 }).format(property.priceValue / property.areaValue)
  : null;
const areaLabel = kind === 'can-ho' ? 'Diện tích' : 'Diện tích đất';
const specs = [
  { label: isSale ? 'Giá bán' : 'Giá thuê', value: property.price || 'Liên hệ', price: true },
  { label: areaLabel, value: property.area || (property.areaValue ? `${property.areaValue} m²` : 'Đang cập nhật') },
  kind === 'can-ho'
    ? { label: 'Phòng ngủ', value: typeof property.bedrooms === 'number' ? `${property.bedrooms} PN` : 'Đang cập nhật' }
    : { label: 'Số tầng', value: typeof property.floors === 'number' ? `${property.floors} tầng` : 'Đang cập nhật' },
];
const details = [
  { label: 'Loại hình', value: property.propertyType },
  { label: 'Địa chỉ', value: property.address },
  { label: 'Phường / xã', value: property.ward },
  { label: 'Khu vực', value: property.district },
  { label: 'Phòng ngủ', value: kind !== 'can-ho' && property.bedrooms != null ? `${property.bedrooms} phòng` : null },
  { label: 'Phòng tắm', value: property.bathrooms != null ? `${property.bathrooms} phòng` : null },
  { label: 'Số tầng', value: kind !== 'can-ho' && property.floors != null ? `${property.floors} tầng` : null },
  { label: 'Mặt tiền', value: kind !== 'can-ho' ? property.frontage : null },
  { label: 'Hướng', value: property.direction },
  { label: 'Pháp lý', value: property.legal },
].filter((item) => item.value !== null && item.value !== undefined && String(item.value).trim() !== '');
const uniqueId = `property-${Math.random().toString(36).slice(2, 10)}`;
---

<section class="property-detail" data-property-detail={uniqueId} aria-label={`Thông tin ${property.title}`}>
  {gallery.length > 0 && (
    <div class="property-gallery" aria-label="Thư viện hình ảnh bất động sản">
      <div class="gallery-main">
        <img class="gallery-featured" src={gallery[0]} alt={property.imageAlt || property.title} loading="eager" decoding="async" />
        {gallery.length > 1 && (
          <>
            <button type="button" class="gallery-arrow prev" aria-label="Ảnh trước">&#10094;</button>
            <button type="button" class="gallery-arrow next" aria-label="Ảnh tiếp theo">&#10095;</button>
            <span class="gallery-count" aria-live="polite">1 / {gallery.length}</span>
          </>
        )}
      </div>
      {gallery.length > 1 && (
        <div class="gallery-thumbs" aria-label="Chọn ảnh">
          {gallery.map((src, index) => (
            <button type="button" class:list={['gallery-thumb', { active: index === 0 }]} data-index={index} aria-label={`Xem ảnh ${index + 1}`} aria-pressed={index === 0}>
              <img src={src} alt={`Ảnh ${index + 1} của ${property.title}`} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      )}
    </div>
  )}

  <h1 class="property-title">{property.title}</h1>
  {property.listingStatus === 'closed' && <p class="property-status">Bất động sản này đã giao dịch</p>}
  {property.listingStatus === 'paused' && <p class="property-status">Bất động sản đang tạm ngừng giao dịch</p>}

  <div class="spec-grid">
    {specs.map((spec) => (
      <div class="spec-card">
        <strong class:list={['spec-value', { 'price-text': spec.price }]}>{spec.value}</strong>
        <span class="spec-label">{spec.label}</span>
      </div>
    ))}
  </div>

  {pricePerSqm && (
    <div class="unit-price-card">
      <strong>{pricePerSqm} triệu/m²</strong>
      <span>Đơn giá theo diện tích {kind === 'can-ho' ? 'căn hộ' : 'đất'}</span>
    </div>
  )}

  <div class="contact-actions" aria-label="Liên hệ tư vấn">
    <a class="contact-call" href={`tel:${phone.replace(/[^\d+]/g, '')}`}><span aria-hidden="true">☎</span> Gọi tư vấn</a>
    <a class="contact-zalo" href={`https://zalo.me/${encodeURIComponent(zalo)}`} target="_blank" rel="noopener noreferrer">Nhắn Zalo</a>
  </div>

  <section class="property-info" aria-label="Thông tin chi tiết">
    <h2>Thông tin chi tiết {kind === 'can-ho' ? 'căn hộ' : kind === 'tho-cu' ? 'nhà đất' : 'biệt thự / shophouse'}</h2>
    <div class="property-description is-collapsed" id={`${uniqueId}-description`}>
      {property.description && <p class="summary-description">{property.description}</p>}
      {details.length > 0 && (
        <dl class="details-list">
          {details.map((item) => (
            <div class="detail-row"><dt>{item.label}</dt><dd>{item.value}</dd></div>
          ))}
        </dl>
      )}
      <div class="cms-body"><slot /></div>
    </div>
    <button type="button" class="description-toggle" aria-controls={`${uniqueId}-description`} aria-expanded="false">
      <span>Xem thêm thông tin</span> <span class="toggle-chevron" aria-hidden="true">⌄</span>
    </button>
  </section>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-property-detail]').forEach((root) => {
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const featured = root.querySelector<HTMLImageElement>('.gallery-featured');
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('.gallery-thumb'));
    const counter = root.querySelector<HTMLElement>('.gallery-count');
    let current = 0;
    const showImage = (index: number) => {
      if (!featured || !thumbs.length) return;
      current = (index + thumbs.length) % thumbs.length;
      const img = thumbs[current].querySelector<HTMLImageElement>('img');
      if (!img) return;
      featured.src = img.src;
      featured.alt = img.alt;
      thumbs.forEach((button, i) => {
        button.classList.toggle('active', i === current);
        button.setAttribute('aria-pressed', String(i === current));
      });
      if (counter) counter.textContent = `${current + 1} / ${thumbs.length}`;
    };
    thumbs.forEach((button, index) => button.addEventListener('click', () => showImage(index)));
    root.querySelector('.gallery-arrow.prev')?.addEventListener('click', () => showImage(current - 1));
    root.querySelector('.gallery-arrow.next')?.addEventListener('click', () => showImage(current + 1));
    const content = root.querySelector<HTMLElement>('.property-description');
    const toggle = root.querySelector<HTMLButtonElement>('.description-toggle');
    if (content && toggle) {
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(expanded));
        content.classList.toggle('is-collapsed', !expanded);
        const label = toggle.querySelector('span');
        if (label) label.textContent = expanded ? 'Thu gọn' : 'Xem thêm thông tin';
      });
    }
  });
</script>

<style>
  .property-detail{width:100%;max-width:1100px;margin:0 auto;color:#202b32;font-family:inherit}
  .property-gallery{margin-bottom:22px}.gallery-main{position:relative;overflow:hidden;border-radius:18px;background:#edf0f2;aspect-ratio:16/9}
  .gallery-featured{width:100%;height:100%;object-fit:cover;display:block}.gallery-arrow{position:absolute;top:50%;transform:translateY(-50%);width:43px;height:43px;border:0;border-radius:50%;background:rgba(255,255,255,.92);color:#26343b;cursor:pointer;font-size:22px;box-shadow:0 2px 12px #0002}
  .gallery-arrow.prev{left:14px}.gallery-arrow.next{right:14px}.gallery-arrow:hover{background:#fff}.gallery-count{position:absolute;right:16px;bottom:14px;border-radius:20px;background:#0009;color:#fff;padding:6px 12px;font-size:13px}
  .gallery-thumbs{display:flex;gap:10px;overflow-x:auto;padding:12px 2px 3px}.gallery-thumb{flex:0 0 108px;height:72px;border:3px solid transparent;border-radius:11px;overflow:hidden;padding:0;background:#eee;cursor:pointer}.gallery-thumb.active{border-color:#176347}.gallery-thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .property-title{font-size:clamp(23px,3vw,32px);line-height:1.35;font-weight:750;margin:8px 0 18px}.property-status{display:inline-block;padding:8px 12px;background:#fff1ed;border-radius:8px;color:#a3432a;font-weight:600;margin:0 0 14px}
  .spec-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.spec-card,.unit-price-card{background:#f3f5f6;border-radius:14px;padding:18px 14px;text-align:center;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:6px;min-width:0}
  .spec-value{font-size:clamp(18px,2.8vw,26px);line-height:1.3;overflow-wrap:anywhere}.price-text,.unit-price-card strong{color:#a82424}.spec-label,.unit-price-card span{font-size:14px;color:#66737a}.unit-price-card{margin-top:12px;padding:15px}.unit-price-card strong{font-size:clamp(19px,2.8vw,25px)}
  .contact-actions{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0 22px}.contact-actions a{display:flex;justify-content:center;align-items:center;gap:9px;min-height:52px;border-radius:12px;text-decoration:none;font-size:16px;font-weight:700;transition:filter .2s}.contact-actions a:hover{filter:brightness(.95)}.contact-call{background:#176347;color:white}.contact-zalo{background:#e9edef;color:#25353b}
  .property-info{background:#f5f6f7;border-radius:16px;padding:22px}.property-info h2{font-size:21px;margin:0 0 14px}.property-description{position:relative;line-height:1.75;overflow-wrap:anywhere}.property-description.is-collapsed{max-height:148px;overflow:hidden}.property-description.is-collapsed:after{content:"";position:absolute;left:0;right:0;bottom:0;height:66px;background:linear-gradient(transparent,#f5f6f7);pointer-events:none}.summary-description{margin:0 0 12px;white-space:pre-line}.details-list{display:grid;grid-template-columns:1fr 1fr;gap:0 20px;margin:0 0 14px}.detail-row{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid #e3e7e9;padding:9px 0}.detail-row dt{color:#6a777e}.detail-row dd{margin:0;font-weight:600;text-align:right}.cms-body :global(img){max-width:100%;height:auto;border-radius:10px}.cms-body :global(p){margin:0 0 12px}.cms-body :global(h2),.cms-body :global(h3){margin:18px 0 10px}
  .description-toggle{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:44px;margin-top:12px;background:#fff;border:1px solid #d9dfe2;border-radius:10px;color:#176347;font-weight:700;font-size:15px;cursor:pointer}.description-toggle:hover{background:#edf4f0}.description-toggle[aria-expanded="true"] .toggle-chevron{transform:rotate(180deg)}.toggle-chevron{font-size:22px;line-height:1;transition:transform .2s}
  @media(max-width:640px){.gallery-main{aspect-ratio:4/3;border-radius:13px}.gallery-thumb{flex-basis:78px;height:57px}.spec-grid{gap:7px}.spec-card{padding:13px 5px;min-height:86px}.spec-value{font-size:17px}.spec-label,.unit-price-card span{font-size:12px}.contact-actions{gap:8px}.contact-actions a{font-size:14px;min-height:49px}.property-info{padding:16px}.property-info h2{font-size:19px}.details-list{grid-template-columns:1fr}.gallery-arrow{width:35px;height:35px}}
</style>
