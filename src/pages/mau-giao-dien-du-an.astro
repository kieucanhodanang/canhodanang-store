import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Escape CMS-authored Markdown before converting supported formatting to HTML.
const escapeHtml = (value: string) => value.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const layerMarkdown = (value: unknown) => {
  const source=String(value||'').replace(/\r\n?/g,'\n');
  const inline=(v:string)=>escapeHtml(v)
    .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
    .replace(/\*(.+?)\*/g,'<em>$1</em>')
    .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,(_m,label,url)=>'<a href="'+url.replace(/&amp;/g,'&')+'" target="_blank" rel="noopener noreferrer">'+label+'</a>');
  const lines=source.split('\n');const result:string[]=[];let list='';
  const closeList=()=>{if(list){result.push('</'+list+'>');list='';}};
  for(const raw of lines){
    const line=raw.trim();
    if(!line){closeList();continue;}
    const heading=line.match(/^(#{1,6})\s+(.+)$/);
    if(heading){closeList();const level=Math.min(6,heading[1].length+2);result.push('<h'+level+'>'+inline(heading[2])+'</h'+level+'>');continue;}
    const bullet=line.match(/^[-*+]\s+(.+)$/),numbered=line.match(/^\d+[.)]\s+(.+)$/);
    if(bullet||numbered){const next=bullet?'ul':'ol';if(list!==next){closeList();result.push('<'+next+'>');list=next;}result.push('<li>'+inline((bullet||numbered)![1])+'</li>');continue;}
    closeList();result.push('<p>'+inline(line)+'</p>');
  }
  closeList();return result.join('\n');
};

const projects = (await getCollection('du-an')).filter(p => p.data.status === 'published');
const project = projects.find(p => p.id === 'capital-square') || projects[0];
const d = project?.data;
const images = [...new Set([d?.image, ...(d?.gallery || [])].filter((x): x is string => !!x))];
const facts = [
  ['Chủ đầu tư', d?.developer],
  ['Quy mô', d?.totalArea],
  ['Số tòa', d?.towerCount],
  ['Sản phẩm', d?.unitCount],
  ['Bàn giao dự kiến', d?.handoverDate],
  ['Mật độ xây dựng', d?.buildingDensity],
].filter((x): x is string[] => !!x[1]);
const apartmentListings = project ? (await getCollection('can-ho')).filter(p => p.data.project === project.id && p.data.status === 'published' && p.data.listingStatus === 'available') : [];
const specialListings = project?.id === 'vinhomes-hai-van-bay'
  ? (await getCollection('nha-dat-tho-cu')).filter(p => p.data.project === project.id && p.data.status === 'published' && p.data.listingStatus === 'available')
  : [];
const listings = [
  ...apartmentListings.map(item => ({ id:item.id, data:item.data, href:`/can-ho/${item.id}/`, kind:'can-ho' })),
  ...specialListings.map(item => ({ id:item.id, data:item.data, href:`/nha-dat-tho-cu/${item.id}/`, kind:'nha-dat' })),
];
const listingGroups = [
  { key:'ban', title:'Căn hộ đang bán', items:listings.filter(item=>item.data.transaction === 'ban') },
  { key:'cho-thue', title:'Căn hộ cho thuê', items:listings.filter(item=>item.data.transaction !== 'ban') },
].filter(group=>group.items.length);
const relatedProjects = project ? projects
  .filter(item => item.id !== project.id)
  .sort((a,b) => Number(!!d?.district && b.data.district === d.district) - Number(!!d?.district && a.data.district === d.district)) : [];
const relatedNews = project ? (await getCollection('bai-viet'))
  .filter(item => item.data.status !== 'draft' && item.data.project === project.id)
  .sort((a,b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()) : [];
const legacyPlanImages = [...String(d?.floorPlanText || '').matchAll(/!\[([^\]]*)\]\((\/[^\s)]+)(?:\s+["'][^"']*["'])?\)/g)].map((match,i)=>({
  image: match[2],
  title: match[1] || 'Mặt bằng '+String(i+1).padStart(2,'0'),
  description: match[1] || d?.description || '',
  imageAlt: match[1] || 'Mặt bằng '+(i+1)
}));
const floorPlanItems = (d?.floorPlanItems?.length ? d.floorPlanItems : (d?.floorPlanImages?.length ? d.floorPlanImages.map((image,i)=>({image,title:'Mặt bằng '+String(i+1).padStart(2,'0'),description:d?.description||'',imageAlt:'Mặt bằng '+(i+1)})) : legacyPlanImages)).filter(item=>item.image);
const contentLayers = (d?.contentLayers || []).filter(layer=>layer.enabled !== false && !['property-cards','related-cards'].includes(layer.type || ''));
const highlights = [
  d?.location && 'Vị trí: ' + d.location,
  d?.developer && 'Chủ đầu tư: ' + d.developer,
  d?.towerCount && 'Quy mô: ' + d.towerCount + ' tòa',
  d?.unitCount && 'Sản phẩm: ' + d.unitCount,
  d?.totalArea && 'Diện tích dự án: ' + d.totalArea,
  d?.handoverDate && 'Bàn giao dự kiến: ' + d.handoverDate,
  d?.buildingDensity && 'Mật độ xây dựng: ' + d.buildingDensity,
  'Khám phá kiến trúc và không gian sống',
  'Xem mặt bằng và thông tin sản phẩm',
  'Liên hệ tư vấn trực tiếp qua Gọi điện hoặc Zalo'
].filter(Boolean).slice(0,10);
const dateLabel = (value: unknown) => { if (!value) return ''; const t = new Date(String(value)); return Number.isNaN(t.getTime()) ? '' : new Intl.DateTimeFormat('vi-VN').format(t); };
const displayPrice = (value: unknown) => {
  const raw = String(value ?? '').trim();
  if (!raw) return 'Liên hệ';
  if (/(tỷ|triệu|tr\b|vnđ|vnd|đồng|₫|usd|\$)/i.test(raw)) return raw;
  if (/^\d+(?:[.,]\d+)?$/.test(raw)) {
    const n = Number(raw.replace(',','.'));
    if (n >= 1000000000) return (n/1000000000).toLocaleString('vi-VN',{maximumFractionDigits:3})+' tỷ';
    if (n >= 1000000) return (n/1000000).toLocaleString('vi-VN',{maximumFractionDigits:1})+' triệu';
    return raw+' tỷ';
  }
  return raw;
};
const safeMapUrl = (html: unknown) => {
  const match=String(html||'').match(/<iframe\b[^>]*\bsrc\s*=\s*["']([^"']+)["']/i);
  if(!match)return '';
  try {const url=new URL(match[1].replace(/&amp;/g,'&'));return url.protocol==='https:' && ['www.google.com','google.com'].includes(url.hostname) && url.pathname.startsWith('/maps/embed') ? url.toString():'';}catch{return '';}
};
const mapEmbedUrl = (() => {
  if (d?.showGoogleMap === false) return '';
  const html = String(d?.googleMapsEmbed || '');
  const match = html.match(/<iframe\b[^>]*\bsrc\s*=\s*["']([^"']+)["']/i);
  if (!match) return '';
  try {
    const url = new URL(match[1].replace(/&amp;/g,'&'));
    return url.protocol === 'https:' && (url.hostname === 'www.google.com' || url.hostname === 'google.com') && url.pathname.startsWith('/maps/embed') ? url.toString() : '';
  } catch { return ''; }
})();
const nearbyAmenities = (d?.nearbyAmenities || []).filter(item=>item.name?.trim());
const unitPrice = (item: typeof listings[number]) => {
  if (item.data.transaction !== 'ban') return '';
  const rawPrice = String(item.data.price ?? '').trim().toLowerCase();
  const rawArea = String(item.data.area ?? '').trim();
  const area = Number(rawArea.replace(/\s/g,'').replace(/\.(?=\d{3}(?:\D|$))/g,'').replace(',','.').match(/\d+(?:\.\d+)?/)?.[0]);
  const priceText = rawPrice.replace(/\s/g,'');
  const matched = priceText.match(/(\d+(?:[.,]\d+)?)\s*(tỷ|triệu)/);
  if (!matched || !area || area <= 0) return '';
  const value = Number(matched[1].replace(',','.'));
  if (!Number.isFinite(value)) return '';
  const millions = value * (matched[2] === 'tỷ' ? 1000 : 1);
  return (millions / area).toLocaleString('vi-VN',{maximumFractionDigits:1}) + ' triệu/m²';
};
---
<Base title="Bản mẫu giao diện dự án | Căn Hộ Đà Nẵng" description="Bản mẫu trải nghiệm hình ảnh dự án bất động sản đang được thử nghiệm.">
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <main class="experience">
    <div class="preview-bar"><span>✦ BẢN MẪU GIAO DIỆN — CHƯA ÁP DỤNG CHO TRANG DỰ ÁN</span><a href={project ? `/du-an/${project.id}/` : '/du-an/'}>Xem trang hiện tại ↗</a></div>
    <section class="cinema" id="dau-trang">
      <div class="slides">
        {images.length ? images.map((src,i)=><img src={src} alt={`Phối cảnh ${d?.title || 'dự án'} ${i+1}`} class:list={['slide',{'active':i===0}]} loading={i===0?'eager':'lazy'} />) : <div class="no-image">Hình ảnh dự án đang cập nhật</div>}
      </div>
      <div class="cinema-shade"></div>
      <div class="cinema-top"><span>CANHO<span class="gold">DANANG</span>.STORE</span><span>PROJECT EXPERIENCE / 01</span></div>
      <div class="cinema-body"><span class="eyebrow">KHÁM PHÁ KHÔNG GIAN SỐNG</span><h1>{d?.title || 'Dự án bất động sản Đà Nẵng'}</h1><p>{d?.location || 'Đà Nẵng, Việt Nam'}</p><div class="cinema-actions"><a href="#tong-quan" class="primary">Khám phá dự án <span>↗</span></a><a href="#mat-bang" class="outline">Xem mặt bằng ↓</a></div></div>
      <div class="cinema-bottom"><span>CUỘN ĐỂ KHÁM PHÁ ↓</span><div class="slide-controls"><button type="button" data-prev aria-label="Ảnh trước">←</button><span data-slide-count>01 / {String(Math.max(1,images.length)).padStart(2,'0')}</span><button type="button" data-next aria-label="Ảnh sau">→</button></div></div>
    </section>
    <nav class="section-nav" aria-label="Điều hướng nội dung dự án"><a href="#tong-quan">Tổng quan</a><a href="#bo-suu-tap">Hình ảnh</a><a href="#mat-bang">Mặt bằng</a><a href="#vi-tri">Vị trí</a><a href="#can-ho-dang-ban">Sản phẩm</a><a href="#lien-he">Liên hệ</a></nav>
    {contentLayers.length ? contentLayers.map((layer,i)=><section class:list={['cms-layer','section','cms-layout-'+(layer.type || layer.layout || 'split'),{'cms-image-right':(layer.type || layer.layout || 'split')==='split' && (layer.imageSide==='right'||(layer.imageSide!=='left'&&i%2===1))}]} id={'layer-'+i}>
      <div class="cms-layer-copy">{layer.heading && <h2 id={'cms-heading-'+i}>{layer.heading}</h2>}{layer.subheading && <h3>{layer.subheading}</h3>}{layer.text && <div class="cms-layer-text" set:html={layerMarkdown(layer.text)} />}</div>
      {(['split','text-gallery','full-image','four-images'].includes((layer.type || layer.layout || 'split'))) && !!layer.images?.length && <div class:list={['cms-layer-images',{'cms-images-single':layer.images.length===1,'cms-images-double':layer.images.length===2}]} data-cms-gallery><div class="cms-image-track">{layer.images.map((item,j)=><figure class="cms-image-item"><button type="button" class="cms-zoom-button" data-full={item.image} aria-label={'Phóng to ảnh '+(j+1)}><img src={item.image} alt={item.imageAlt || item.captionTitle || layer.heading || 'Ảnh dự án'} loading="lazy"/></button>{(item.captionTitle || item.caption) && <figcaption>{item.captionTitle && <strong>{item.captionTitle}</strong>}{item.caption && <span>{item.caption}</span>}</figcaption>}</figure>)}</div>{layer.images.length>2 && <div class="cms-image-controls"><button type="button" data-cms-prev aria-label="Ảnh trước">←</button><button type="button" data-cms-next aria-label="Ảnh tiếp theo">→</button></div>}</div>}
      {(layer.type || layer.layout || 'split')==='map-amenities' && <div class="location-layout"><div class="location-map">{safeMapUrl(layer.mapEmbed) ? <iframe src={safeMapUrl(layer.mapEmbed)} title={'Bản đồ '+(layer.heading||d?.title||'dự án')} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe> : <div class="empty">Chưa có mã nhúng Google Maps hợp lệ.</div>}</div><div class="location-nearby"><h3>Tiện ích lân cận</h3>{layer.amenities?.length ? <ul>{layer.amenities.map(item=><li><span class="nearby-dot">✦</span><div><strong>{item.name}</strong>{item.note && <p>{item.note}</p>}</div><span class="nearby-distance">{[item.distance,item.travelTime].filter(Boolean).join(' · ')}</span></li>)}</ul> : <p class="nearby-empty">Chưa có tiện ích được nhập.</p>}</div></div>}
      {(layer.type || layer.layout || 'split')==='tabs' && <div class="builder-tabs" data-builder-tabs><div class="builder-tab-buttons" role="tablist">{(layer.tabs||[]).map((tab,j)=><button type="button" role="tab" class:list={[{'is-active':j===0}]} data-builder-tab={j} aria-selected={j===0?'true':'false'}>{tab.title}</button>)}</div>{(layer.tabs||[]).map((tab,j)=><div class="builder-tab-panel" data-builder-panel={j} hidden={j!==0} role="tabpanel">{tab.image && <button type="button" data-full={tab.image} class="builder-tab-image"><img src={tab.image} alt={tab.imageAlt||tab.title} loading="lazy"/></button>}<div><h3>{tab.title}</h3>{tab.text && <div class="cms-layer-text" set:html={layerMarkdown(tab.text)} />}</div></div>)}</div>}
      {(layer.type || layer.layout || 'split')==='related-cards' && (layer.dataSource==='related-projects' ? <div class="related-projects-builder"><div class="section-heading"><div><span class="kicker">DỰ ÁN KHÁC</span><h2>{layer.heading || 'Dự án liên quan'}</h2></div></div>{relatedProjects.length ? <div class="builder-project-grid">{relatedProjects.slice(0,layer.initialCount || 3).map(item=><a class="builder-project-card" href={`/du-an/${item.id}/`}><img src={item.data.image} alt={item.data.title} loading="lazy"/><div class="builder-project-info"><h3>{item.data.title}</h3><p>{item.data.location}</p><span>Xem dự án ↗</span></div></a>)}</div> : <p class="empty">Hiện chưa có dự án liên quan.</p>}</div> : relatedNews.length > 0 ? <div class="news-section" id="tin-tuc-du-an"><div class="section-heading"><div><span class="kicker">TIN TỨC DỰ ÁN</span><h2>Tin tức về {d?.title}</h2></div></div><div class="news-carousel" data-news-carousel><div class="news-track" data-news-track>{relatedNews.map(item=><a class="news-card" href={`/tin-tuc/${item.id}/`}>{item.data.image ? <img src={item.data.image} alt={item.data.imageAlt || item.data.title} loading="lazy"/> : <div class="news-image-placeholder" aria-hidden="true">TIN TỨC</div>}<div class="news-card-body"><span class="news-date">{dateLabel(item.data.date)}</span><h3>{item.data.title}</h3><span class="news-read">Đọc bài viết <span aria-hidden="true">↗</span></span></div></a>)}</div>{relatedNews.length>3 && <div class="news-controls"><button type="button" data-news-prev aria-label="Xem tin tức trước">←</button><span class="news-counter" data-news-counter>01 / {String(relatedNews.length).padStart(2,'0')}</span><button type="button" data-news-next aria-label="Xem tin tức tiếp theo">→</button></div>}</div></div> : null)}
    </section>) : <>
    <section class="intro section" id="tong-quan"><div class="intro-copy"><span class="kicker">01 / THE VISION</span><h2>{d?.introSlogan?.firstLine?.trim() || 'Một góc nhìn khác về'} <em>{d?.introSlogan?.highlight?.trim() || 'không gian sống.'}</em>{d?.introSlogan?.lastLine?.trim() && <span class="intro-slogan-last">{d.introSlogan.lastLine.trim()}</span>}</h2><p>{d?.description || 'Khám phá kiến trúc, vị trí và những giá trị nổi bật của dự án qua trải nghiệm hình ảnh trực quan.'}</p><a class="text-link" href="#lien-he">Nhận báo giá dự án ↗</a></div><div class="highlights">{highlights.map((value,i)=><div class="highlight"><span class="twinkle" style={`animation-delay:${i*0.2}s`} aria-hidden="true">★</span><span>{value}</span></div>)}</div></section>
    <section class="visual-section" id="bo-suu-tap"><div class="visual-heading"><span class="kicker">02 / VISUAL JOURNEY</span><h2>Chạm vào từng góc nhìn</h2><p>Mỗi hình ảnh là một câu chuyện về dự án.</p></div><div class="gallery-track" data-gallery-track>{images.map((src,i)=><article class="story-card"><button type="button" class="story-image" data-full={src} aria-label={`Phóng to ảnh ${i+1}`}><img src={src} alt={`Góc nhìn ${i+1} dự án`} loading="lazy"/></button><h3>Góc nhìn {String(i+1).padStart(2,'0')}</h3><p>{d?.description || ''}</p></article>)}</div>{images.length>3 && <div class="gallery-actions"><button type="button" data-gallery-prev aria-label="Ảnh trước">←</button><span data-gallery-count>01 / {images.length}</span><button type="button" data-gallery-next aria-label="Ảnh tiếp theo">→</button></div>}</section>
    <section class="plans section" id="mat-bang"><div class="section-heading"><div><span class="kicker">04 / FLOOR PLANS</span><h2>Khám phá mặt bằng</h2></div></div>{floorPlanItems.length ? <div class="plan-experience" data-plan-viewer><div class="plan-visual"><div class="plan-main"><img data-plan-main src={floorPlanItems[0].image} alt={floorPlanItems[0].imageAlt || floorPlanItems[0].title} loading="lazy"/><button class="plan-zoom" type="button" data-plan-zoom aria-label="Phóng to mặt bằng và nội dung mô tả" title="Phóng to"><svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H3v5M16 3h5v5M3 16v5h5M21 16v5h-5"/></svg></button></div><div class="plan-thumbnails" role="tablist" aria-label="Chọn mặt bằng">{floorPlanItems.map((item,i)=><button type="button" class:list={['plan-tab',{'is-active':i===0}]} role="tab" aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} aria-label={item.title} data-plan-index={i} data-plan-src={item.image} data-plan-title={item.title} data-plan-alt={item.imageAlt || item.title} data-plan-description={item.description || ''}><img src={item.image} alt="" loading="lazy"/></button>)}</div></div><div class="plan-description" data-plan-description role="tabpanel"><span class="kicker">MẶT BẰNG DỰ ÁN</span><h3 data-plan-title>{floorPlanItems[0].title}</h3><p data-plan-text>{floorPlanItems[0].description || 'Đang cập nhật mô tả mặt bằng.'}</p><span class="plan-position" data-plan-position>01 / {String(floorPlanItems.length).padStart(2,'0')}</span></div></div> : <div class="empty">Chưa có ảnh mặt bằng trong CMS. Khi anh tải lên, ảnh sẽ tự xuất hiện tại đây.</div>}</section>
    <section class="location-section section" id="vi-tri"><div class="section-heading"><div><span class="kicker">VỊ TRÍ & KẾT NỐI</span><h2>Vị trí dự án</h2></div></div><div class="location-layout"><div class="location-map">{mapEmbedUrl ? <iframe src={mapEmbedUrl} title={'Bản đồ vị trí '+(d?.title || 'dự án')} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe> : <div class="empty">Chưa có mã nhúng Google Maps hợp lệ trong CMS.</div>}</div><div class="location-nearby"><h3>Liên kết tiện ích</h3>{nearbyAmenities.length ? <ul>{nearbyAmenities.map(item=><li><span class="nearby-dot" aria-hidden="true">✦</span><div><strong>{item.name}</strong>{item.note && <p>{item.note}</p>}</div>{(item.distance || item.travelTime) && <span class="nearby-distance">{[item.distance,item.travelTime].filter(Boolean).join(' · ')}</span>}</li>)}</ul> : <p class="nearby-empty">Anh có thể thêm các địa điểm, khoảng cách và thời gian di chuyển tại CMS dự án.</p>}</div></div></section>
