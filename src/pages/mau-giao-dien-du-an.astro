---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('du-an')).filter(p => p.data.status === 'published');
const project = projects.find(p => p.id === 'sun-saphia-residence-da-nang') || projects[0];
const d = project?.data;
const images = [...new Set([d?.image, ...(d?.gallery || [])].filter((x): x is string => !!x))];
const facts = [
  ['Chủ đầu tư', d?.developer],
  ['Quy mô', d?.totalArea],
  ['Số tòa', d?.towerCount],
  ['Sản phẩm', d?.unitCount],
  ['Bàn giao dự kiến', d?.handoverDate],
  ['Mật độ xây dựng', d?.buildingDensity],
].filter((x): x is string[] => !!x[1]);
const listings = project ? (await getCollection('can-ho')).filter(p => p.data.project === project.id && p.data.status === 'published' && p.data.listingStatus === 'available').slice(0,6) : [];
const plans = d?.floorPlanImages || [];
---
<Base title="Bản mẫu giao diện dự án | Căn Hộ Đà Nẵng" description="Bản mẫu trải nghiệm hình ảnh dự án bất động sản đang được thử nghiệm.">
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <main class="experience">
    <div class="preview-bar"><span>✦ BẢN MẪU GIAO DIỆN — CHƯA ÁP DỤNG CHO TRANG DỰ ÁN</span><a href={project ? `/du-an/${project.id}/` : '/du-an/'}>Xem trang hiện tại ↗</a></div>
    <section class="cinema" id="dau-trang">
      <div class="slides">
        {images.length ? images.map((src,i)=><img src={src} alt={`Phối cảnh ${d?.title || 'dự án'} ${i+1}`} class:list={['slide',{'active':i===0}]} loading={i===0?'eager':'lazy'} />) : <div class="no-image">Hình ảnh dự án đang cập nhật</div>}
      </div>
      <div class="cinema-shade"></div>
      <div class="cinema-top"><span>CANHO<span class="gold">DANANG</span>.STORE</span><span>PROJECT EXPERIENCE / 01</span></div>
      <div class="cinema-body"><span class="eyebrow">KHÁM PHÁ KHÔNG GIAN SỐNG</span><h1>{d?.title || 'Dự án bất động sản Đà Nẵng'}</h1><p>{d?.location || 'Đà Nẵng, Việt Nam'}</p><div class="cinema-actions"><a href="#tong-quan" class="primary">Khám phá dự án <span>↗</span></a><a href="#mat-bang" class="outline">Xem mặt bằng ↓</a></div></div>
      <div class="cinema-bottom"><span>CUỘN ĐỂ KHÁM PHÁ ↓</span><div class="slide-controls"><button type="button" data-prev aria-label="Ảnh trước">←</button><span data-slide-count>01 / {String(Math.max(1,images.length)).padStart(2,'0')}</span><button type="button" data-next aria-label="Ảnh sau">→</button></div></div>
    </section>
    <nav class="section-nav" aria-label="Điều hướng nội dung dự án"><a href="#tong-quan">Tổng quan</a><a href="#bo-suu-tap">Hình ảnh</a><a href="#mat-bang">Mặt bằng</a><a href="#san-pham">Sản phẩm</a><a href="#lien-he">Liên hệ</a></nav>
    <section class="intro section" id="tong-quan"><div class="intro-copy"><span class="kicker">01 / THE VISION</span><h2>Một góc nhìn khác về <em>không gian sống.</em></h2><p>{d?.description || 'Khám phá kiến trúc, vị trí và những giá trị nổi bật của dự án qua trải nghiệm hình ảnh trực quan.'}</p><a class="text-link" href={project ? `/du-an/${project.id}/` : '/du-an/'}>Xem đầy đủ thông tin dự án ↗</a></div><div class="facts">{facts.length ? facts.map(([label,value])=><div class="fact"><small>{label}</small><strong>{value}</strong></div>) : <p>Thông số dự án sẽ được cập nhật từ CMS.</p>}</div></section>
    <section class="visual-section" id="bo-suu-tap"><div class="visual-heading"><span class="kicker">02 / VISUAL JOURNEY</span><h2>Chạm vào từng góc nhìn</h2><p>Bộ sưu tập ảnh lấy trực tiếp từ thư viện dự án trong CMS.</p></div><div class="visual-grid">{images.slice(0,5).map((src,i)=><button type="button" class:list={['visual-tile',{'large':i===0}]} data-full={src} aria-label={`Phóng to ảnh ${i+1}`}><img src={src} alt={`Hình ảnh dự án ${i+1}`} loading="lazy"/><span>KHÁM PHÁ 0{i+1} ↗</span></button>)}</div></section>
    <section class="plans section" id="mat-bang"><div class="section-heading"><div><span class="kicker">03 / FLOOR PLANS</span><h2>Khám phá mặt bằng</h2></div><p>Từng không gian, từng lựa chọn được trình bày rõ ràng và trực quan.</p></div>{plans.length ? <div class="plan-grid">{plans.map((src,i)=><button type="button" class="plan-card" data-full={src}><img src={src} alt={`Mặt bằng dự án ${i+1}`} loading="lazy"/><span>Mặt bằng {String(i+1).padStart(2,'0')} <b>Phóng to ↗</b></span></button>)}</div> : <div class="empty">Chưa có ảnh mặt bằng trong CMS. Khi anh tải lên, ảnh sẽ tự xuất hiện tại đây.</div>}</section>
    <section class="homes section" id="san-pham"><div class="section-heading"><div><span class="kicker">04 / RESIDENCES</span><h2>Khám phá sản phẩm</h2></div><p>Dữ liệu sản phẩm liên kết từ CMS, không cần nhập lại.</p></div>{listings.length ? <div class="home-grid">{listings.map(item=><a class="home-card" href={`/can-ho/${item.id}/`}><div class="home-image">{item.data.image && <img src={item.data.image} alt={item.data.title} loading="lazy"/>}<span>ĐANG GIAO DỊCH</span></div><div class="home-info"><h3>{item.data.title}</h3><p>{item.data.area} m² · {item.data.bedrooms || '—'} PN</p><strong>{item.data.price}</strong><span class="home-more">Khám phá căn hộ ↗</span></div></a>)}</div> : <div class="empty">Chưa có sản phẩm đang giao dịch thuộc dự án mẫu.</div>}</section>
    <section class="cta" id="lien-he"><span class="kicker">05 / YOUR NEXT CHAPTER</span><h2>Không gian sống tiếp theo<br/><em>đang chờ anh chị khám phá.</em></h2><p>Nhận thông tin và tư vấn trực tiếp từ Căn Hộ Đà Nẵng.</p><div class="cta-buttons"><a href="tel:0869437415">Gọi 0869 437 415 ↗</a><a href="https://zalo.me/0869437415" target="_blank" rel="noopener noreferrer">Tư vấn qua Zalo ↗</a></div></section>
    <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Xem ảnh lớn"><button type="button" data-close aria-label="Đóng ảnh">✕</button><img alt="Ảnh dự án phóng to"/></div>
  </main>
  <script is:inline>
    (() => {
      const slides=[...document.querySelectorAll('.experience .slide')];let active=0;
      const counter=document.querySelector('[data-slide-count]');
      const show=n=>{if(!slides.length)return;active=(n+slides.length)%slides.length;slides.forEach((el,i)=>el.classList.toggle('active',i===active));if(counter)counter.textContent=String(active+1).padStart(2,'0')+' / '+String(slides.length).padStart(2,'0')};
      document.querySelector('[data-prev]')?.addEventListener('click',()=>show(active-1));
      document.querySelector('[data-next]')?.addEventListener('click',()=>show(active+1));
      const modal=document.querySelector('[data-lightbox]');const big=modal?.querySelector('img');
      document.querySelectorAll('[data-full]').forEach(b=>b.addEventListener('click',()=>{if(!modal||!big)return;big.src=b.dataset.full;modal.hidden=false;document.body.style.overflow='hidden'}));
      const close=()=>{if(modal){modal.hidden=true;document.body.style.overflow=''}};
      modal?.querySelector('[data-close]')?.addEventListener('click',close);
      modal?.addEventListener('click',e=>{if(e.target===modal)close()});
      document.addEventListener('keydown',e=>{if(e.key==='Escape')close()});
    })();
  </script>
  <style>
    .experience{font-family:inherit;color:#1c2932;background:#f6f4ef}.experience *{box-sizing:border-box}.preview-bar{background:#162b38;color:#f1d8a7;padding:10px 4vw;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:11px;letter-spacing:.12em;font-weight:700}.preview-bar a{color:white;text-decoration:none}
    .cinema{height:min(840px,calc(100svh - 80px));min-height:560px;position:relative;background:#1c2b36;color:white;overflow:hidden}.slides,.slide,.cinema-shade{position:absolute;inset:0}.slide{width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .65s ease}.slide.active{opacity:1}.cinema-shade{background:linear-gradient(90deg,#0b1b2bd9 0%,#0b1b2b77 55%,#0b1b2b33 100%),linear-gradient(0deg,#091a2a9c,transparent 35%)}.cinema-top,.cinema-bottom{position:absolute;left:5%;right:5%;display:flex;justify-content:space-between;align-items:center;gap:12px}.cinema-top{top:34px;font-size:12px;font-weight:800;letter-spacing:.14em}.cinema-top>span:last-child{font-size:10px;opacity:.75}.gold{color:#dfbd80}.cinema-body{position:absolute;left:9%;top:50%;transform:translateY(-42%);max-width:850px}.eyebrow,.kicker{font-size:11px;letter-spacing:.25em;font-weight:800;color:#bb9253}.eyebrow{color:#e7c18a}.cinema h1{font-size:clamp(45px,6.8vw,106px);line-height:1.05;letter-spacing:-.045em;margin:20px 0 22px;font-weight:650}.cinema-body p{font-size:clamp(16px,1.7vw,21px);opacity:.9}.cinema-actions,.cta-buttons{display:flex;flex-wrap:wrap;gap:12px;margin-top:35px}.cinema-actions a,.cta-buttons a{display:inline-flex;align-items:center;justify-content:space-between;gap:36px;text-decoration:none;padding:16px 23px;font-weight:700;font-size:13px}.cinema-actions .primary{background:#c39a5b;color:#152330}.cinema-actions .outline{border:1px solid #ffffff99;color:white}.cinema-bottom{bottom:25px;font-size:10px;letter-spacing:.16em}.slide-controls{display:flex;align-items:center;gap:17px}.slide-controls button{background:#ffffff26;border:1px solid #ffffff66;color:white;width:38px;height:38px;border-radius:50%;cursor:pointer}.section-nav{position:sticky;top:58px;z-index:20;background:#f8f6f1ee;backdrop-filter:blur(12px);display:flex;justify-content:center;gap:clamp(12px,4vw,58px);padding:18px;overflow-x:auto;white-space:nowrap;border-bottom:1px solid #e4ded3}.section-nav a{color:#33414b;text-decoration:none;font-size:12px;font-weight:750;text-transform:uppercase;letter-spacing:.1em}.section{max-width:1300px;margin:auto;padding:110px 5%}.intro{display:grid;grid-template-columns:1.1fr 1fr;gap:10%;align-items:center}.intro h2,.section-heading h2,.visual-heading h2,.cta h2{font-size:clamp(34px,4.3vw,65px);line-height:1.12;letter-spacing:-.04em;font-weight:600;margin:20px 0}.intro h2 em,.cta h2 em{font-family:Georgia,serif;font-weight:400;color:#b48b4e}.intro-copy>p{font-size:17px;line-height:1.85;color:#66747b}.text-link{display:inline-block;margin-top:20px;color:#926d37;text-decoration:none;font-weight:750;border-bottom:1px solid #b48b4e;padding-bottom:8px}.facts{display:grid;grid-template-columns:1fr 1fr;gap:0 30px}.fact{padding:24px 0;border-bottom:1px solid #d9d6ce}.fact small{display:block;color:#849095;font-size:12px;margin-bottom:10px}.fact strong{font-size:clamp(16px,1.5vw,23px);font-weight:650}.visual-section{background:#162b38;color:white;padding:90px 5%}.visual-heading{max-width:1200px;margin:0 auto 35px}.visual-heading h2{margin-bottom:10px}.visual-heading p{color:#c4cdd0}.visual-grid{max-width:1400px;margin:auto;display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:210px;gap:12px}.visual-tile{position:relative;overflow:hidden;padding:0;border:0;background:#243a49;cursor:pointer}.visual-tile.large{grid-column:span 2;grid-row:span 2}.visual-tile img{width:100%;height:100%;object-fit:cover;transition:transform .4s}.visual-tile:hover img{transform:scale(1.06)}.visual-tile span{position:absolute;left:17px;bottom:17px;color:white;font-size:11px;letter-spacing:.14em;font-weight:750;text-shadow:0 2px 8px #000}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:35px}.section-heading>p{max-width:330px;color:#718087;line-height:1.7}.plan-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.plan-card{background:white;border:1px solid #e5e1d9;text-align:left;padding:16px;cursor:pointer}.plan-card img{width:100%;height:350px;object-fit:contain}.plan-card>span{display:flex;justify-content:space-between;padding:15px 0 4px;font-weight:700}.plan-card b{color:#a67b41}.home-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.home-card{background:white;color:#20333e;text-decoration:none;overflow:hidden}.home-image{position:relative;height:235px;background:#e0e5e6}.home-image img{width:100%;height:100%;object-fit:cover}.home-image span{position:absolute;top:14px;left:14px;background:#f7f4ed;padding:8px;font-size:10px;letter-spacing:.08em}.home-info{padding:22px}.home-info h3{font-size:20px;margin:0 0 12px}.home-info p{color:#829095}.home-info strong{display:block;color:#b27839;font-size:23px}.home-more{display:block;margin-top:20px;padding-top:15px;border-top:1px solid #e6e6e6;font-weight:700;font-size:12px}.empty{background:#ebe8df;padding:40px;text-align:center;color:#69777c;border:1px dashed #c9bca5}.cta{text-align:center;padding:100px 5%;background:#122a39;color:white}.cta h2{margin:22px 0}.cta p{color:#c6d0d4}.cta-buttons{justify-content:center}.cta-buttons a{background:#c49b5d;color:#172a34}.cta-buttons a+a{background:transparent;border:1px solid #c49b5d;color:#f4e2c4}.lightbox[hidden]{display:none}.lightbox{position:fixed;inset:0;z-index:9999;background:#07111deb;display:grid;place-items:center;padding:55px 20px}.lightbox img{max-width:100%;max-height:90vh;object-fit:contain}.lightbox button{position:absolute;top:15px;right:22px;background:transparent;color:white;border:0;font-size:28px;cursor:pointer}section[id]{scroll-margin-top:125px}
    @media(max-width:800px){.cinema{min-height:570px;height:75svh}.cinema-body{left:6%;right:6%}.cinema-top,.cinema-bottom{left:6%;right:6%}.section{padding:70px 6%}.intro{grid-template-columns:1fr;gap:40px}.visual-grid{grid-template-columns:repeat(2,1fr);grid-auto-rows:165px}.visual-tile.large{grid-column:span 2;grid-row:span 2}.home-grid{grid-template-columns:repeat(2,1fr)}.section-heading{display:block}.plan-card img{height:240px}.section-nav{justify-content:flex-start;top:72px}.cinema h1{font-size:clamp(42px,9vw,72px)}}
    @media(max-width:540px){.preview-bar{font-size:9px}.cinema-top>span:last-child{display:none}.cinema-actions a{padding:14px 17px;gap:12px}.cinema-bottom>span{font-size:9px}.facts{gap:0 14px}.visual-grid{grid-auto-rows:130px}.plan-grid,.home-grid{grid-template-columns:1fr}.home-image{height:230px}.section-nav{gap:22px}.intro h2,.section-heading h2,.visual-heading h2,.cta h2{font-size:35px}}
    @media(prefers-reduced-motion:reduce){.slide,.visual-tile img{transition:none}}
  </style>
</Base>
