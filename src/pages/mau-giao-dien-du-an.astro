  <script is:inline>
    (() => {
      document.querySelectorAll('.product-group').forEach(group=>{
        const cards=[...group.querySelectorAll('[data-listing-card]')];
        const button=group.querySelector('[data-listing-more]');
        if(!button)return;
        let visible=6;
        button.addEventListener('click',()=>{
          visible+=6;
          cards.forEach((card,i)=>{card.hidden=i>=visible;});
          if(visible>=cards.length)button.hidden=true;
        });
      });
      document.querySelectorAll('[data-builder-tabs]').forEach(root=>{
        const buttons=[...root.querySelectorAll('[data-builder-tab]')],panels=[...root.querySelectorAll('[data-builder-panel]')];
        buttons.forEach((btn,i)=>btn.addEventListener('click',()=>{
          buttons.forEach((b,j)=>{b.classList.toggle('is-active',i===j);b.setAttribute('aria-selected',String(i===j))});
          panels.forEach((p,j)=>p.hidden=i!==j);
        }));
      });
      const newsCarousel=document.querySelector('[data-news-carousel]');
      if(newsCarousel){
        const track=newsCarousel.querySelector('[data-news-track]');
        const cards=[...newsCarousel.querySelectorAll('.news-card')];
        const counter=newsCarousel.querySelector('[data-news-counter]');
        const visible=()=>window.matchMedia('(max-width:600px)').matches?1:window.matchMedia('(max-width:900px)').matches?2:3;
        const position=()=>{if(!track||!cards.length)return 0;const step=cards.length>1?cards[1].offsetLeft-cards[0].offsetLeft:1;return Math.max(0,Math.min(cards.length-visible(),Math.round(track.scrollLeft/Math.max(1,step))))};
        const update=()=>{if(counter)counter.textContent=String(position()+1).padStart(2,'0')+' / '+String(cards.length).padStart(2,'0')};
        const move=delta=>{if(!track||!cards.length)return;const target=Math.max(0,Math.min(cards.length-visible(),position()+delta));track.scrollTo({left:cards[target].offsetLeft-cards[0].offsetLeft,behavior:'smooth'});setTimeout(update,350)};
        newsCarousel.querySelector('[data-news-prev]')?.addEventListener('click',()=>move(-1));
        newsCarousel.querySelector('[data-news-next]')?.addEventListener('click',()=>move(1));
        track?.addEventListener('scroll',update,{passive:true});
        window.addEventListener('resize',update);
      }
      const slides=[...document.querySelectorAll('.experience .slide')];let active=0;
      const counter=document.querySelector('[data-slide-count]');
      const show=n=>{if(!slides.length)return;active=(n+slides.length)%slides.length;slides.forEach((el,i)=>el.classList.toggle('active',i===active));if(counter)counter.textContent=String(active+1).padStart(2,'0')+' / '+String(slides.length).padStart(2,'0')};
      document.querySelector('[data-prev]')?.addEventListener('click',()=>show(active-1));
      document.querySelector('[data-next]')?.addEventListener('click',()=>show(active+1));
      const modal=document.querySelector('[data-lightbox]');const big=modal?.querySelector('img');
      document.querySelectorAll('[data-full]').forEach(b=>b.addEventListener('click',()=>{if(!modal||!big)return;big.src=b.dataset.full;modal.classList.remove('is-plan');const detail=modal.querySelector('[data-lightbox-description]');if(detail)detail.hidden=true;modal.hidden=false;document.body.style.overflow='hidden'}));
      const close=()=>{if(modal){modal.hidden=true;document.body.style.overflow=''}};
      modal?.querySelector('[data-close]')?.addEventListener('click',close);
      modal?.addEventListener('click',e=>{if(e.target===modal)close()});
      document.addEventListener('keydown',e=>{if(e.key==='Escape')close()});
      const planViewer=document.querySelector('[data-plan-viewer]');
      if(planViewer){
        const tabs=[...planViewer.querySelectorAll('[data-plan-index]')];
        const planImg=planViewer.querySelector('[data-plan-main]');
        const planTitle=planViewer.querySelector('[data-plan-title]');
        const planPosition=planViewer.querySelector('[data-plan-position]');
        const planText=planViewer.querySelector('[data-plan-text]');
        const defaultText='Đang cập nhật mô tả mặt bằng.';
        let selectedPlan=0;
        const choosePlan=index=>{
          selectedPlan=(index+tabs.length)%tabs.length;
          const tab=tabs[selectedPlan];if(!tab)return;
          if(planImg){planImg.src=tab.dataset.planSrc;planImg.alt=tab.dataset.planAlt || tab.dataset.planTitle;}
          if(planTitle)planTitle.textContent=tab.dataset.planTitle;
          if(planPosition)planPosition.textContent=String(selectedPlan+1).padStart(2,'0')+' / '+String(tabs.length).padStart(2,'0');
          if(planText)planText.textContent=tab.dataset.planDescription || defaultText;
          tabs.forEach((t,i)=>{t.classList.toggle('is-active',i===selectedPlan);t.setAttribute('aria-selected',String(i===selectedPlan));t.tabIndex=i===selectedPlan?0:-1});
        };
        tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>choosePlan(i));tab.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();const next=(i+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;choosePlan(next);tabs[next].focus()}})});
        planViewer.querySelector('[data-plan-zoom]')?.addEventListener('click',()=>{
          const selected=tabs[selectedPlan];if(!modal||!big||!selected)return;
          big.src=selected.dataset.planSrc;big.alt=selected.dataset.planTitle;
          const detail=modal.querySelector('[data-lightbox-description]');
          if(detail){detail.hidden=false;detail.querySelector('[data-lightbox-title]').textContent=selected.dataset.planTitle;detail.querySelector('[data-lightbox-text]').textContent=selected.dataset.planDescription || defaultText;}
          modal.classList.add('is-plan');modal.hidden=false;document.body.style.overflow='hidden';
        });
      }
      document.querySelectorAll('[data-cms-gallery]').forEach(gallery=>{
        const track=gallery.querySelector('.cms-image-track');const items=[...gallery.querySelectorAll('.cms-image-item')];let index=0;
        const move=delta=>{if(!track||!items.length)return;index=(index+delta+items.length)%items.length;track.scrollTo({left:items[index].offsetLeft-items[0].offsetLeft,behavior:'smooth'})};
        gallery.querySelector('[data-cms-prev]')?.addEventListener('click',()=>move(-1));
        gallery.querySelector('[data-cms-next]')?.addEventListener('click',()=>move(1));
      });
      const track=document.querySelector('[data-gallery-track]');const cards=track?[...track.children]:[];let galleryIndex=0;
      const moveGallery=delta=>{if(!track||!cards.length)return;galleryIndex=(galleryIndex+delta+cards.length)%cards.length;track.scrollTo({left:cards[galleryIndex].offsetLeft-track.offsetLeft,behavior:'smooth'});const count=document.querySelector('[data-gallery-count]');if(count)count.textContent=String(galleryIndex+1).padStart(2,'0')+' / '+cards.length};
      document.querySelector('[data-gallery-prev]')?.addEventListener('click',()=>moveGallery(-1));
      document.querySelector('[data-gallery-next]')?.addEventListener('click',()=>moveGallery(1));
      let submitted=false;const form=document.querySelector('[data-lead-form]');form?.addEventListener('submit',()=>{submitted=true});
      document.querySelector('iframe[name="preview-lead-target"]')?.addEventListener('load',()=>{if(submitted){const status=form?.querySelector('.form-status');if(status)status.hidden=false;submitted=false}});
    })();
  </script>
