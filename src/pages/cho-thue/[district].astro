---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { sortFeaturedFirst, paginateListings } from '../../utils/listingSort';

export function getStaticPaths() {
  return [
    { slug: 'son-tra', name: 'Sơn Trà' },
    { slug: 'hai-chau', name: 'Hải Châu' },
    { slug: 'thanh-khe', name: 'Thanh Khê' },
    { slug: 'ngu-hanh-son', name: 'Ngũ Hành Sơn' },
    { slug: 'lien-chieu', name: 'Liên Chiểu' },
    { slug: 'cam-le', name: 'Cẩm Lệ' },
  ].map(area => ({ params: { district: area.slug }, props: { area } }));
}
const { area } = Astro.props;
const normalizeDistrict = (value: unknown) => String(value || '').normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').toLowerCase()
  .replace(/^(quan|huyen)\s+/, '').trim();
const [apartments, land] = await Promise.all([getCollection('can-ho'), getCollection('nha-dat-tho-cu')]);
const properties = sortFeaturedFirst(
  [...apartments.map(entry => ({ entry, type: 'can-ho' })),
   ...land.map(entry => ({ entry, type: 'nha-dat-tho-cu' }))]
  .filter(item => item.entry.data.status !== 'draft'
    && item.entry.data.listingStatus === 'available'
    && ['cho-thue', 'cho-thue-ngay'].includes(item.entry.data.transaction)
    && normalizeDistrict(item.entry.data.district) === normalizeDistrict(area.name))
  .map(item => ({ ...item.entry, rentalType: item.type }))
);
const { totalItems, totalPages } = paginateListings(properties, 1, 12);
const formatPostedDate = (value: unknown) => {
  if (!value) return '';
  const date = value instanceof Date ? value : new Date(String(value));
  return Number.isNaN(date.getTime()) ? '' : new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(date);
};
const formatCardArea = (value: unknown, fallback?: number | null) => {
  const raw = String(value ?? fallback ?? '').trim();
  return raw ? (/m²|m2|mét vuông/i.test(raw) ? raw : `${raw} m²`) : '';
};
const description = `Cho thuê căn hộ, nhà đất tại ${area.name}, Đà Nẵng. Tìm bất động sản cho thuê theo giá, diện tích và vị trí. Liên hệ 0869 437 415.`;
---
<Base title={`Cho Thuê Căn Hộ, Nhà Đất ${area.name}, Đà Nẵng`} description={description}>
  <main class="listing-page">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><a href="/cho-thue/">Cho thuê</a><span aria-hidden="true">/</span><span aria-current="page">{area.name}</span></nav>
      <header class="heading">
        <h1>Cho thuê căn hộ và nhà đất {area.name}, Đà Nẵng</h1>
        <p>Danh sách căn hộ và nhà đất cho thuê tại {area.name}, cập nhật từ hệ thống quản lý bất động sản.</p>
      </header>
      {totalItems > 0 ? (
        <>
          <div class="result-toolbar"><p class="result-count">Có <strong>{totalItems}</strong> bất động sản cho thuê</p><label for="sort-listings">Sắp xếp <select id="sort-listings"><option value="default">Nổi bật / Mới nhất</option><option value="newest">Mới nhất</option><option value="price-asc">Giá thấp đến cao</option><option value="price-desc">Giá cao đến thấp</option><option value="area-desc">Diện tích lớn nhất</option></select></label></div>
          <div class="property-grid" id="property-grid">
            {properties.map((entry, index) => {
              const data = entry.data;
              const location = [data.ward, data.district].filter(Boolean).join(' · ') || data.address;
              return (
                <article class="property-card" data-page={Math.floor(index / 12) + 1} data-price={data.priceValue ?? ''} data-area={data.areaValue ?? ''} data-date={data.date ? new Date(data.date).getTime() || 0 : 0} hidden={index >= 12}>
                  <a href={`/${entry.rentalType}/${entry.id}/`} class="image-link" aria-label={`Xem ${data.title}`}>
                    <img src={data.image} alt={data.imageAlt || data.title} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
                    {data.featured && <span class="featured-tag">Nổi bật</span>}
                  </a>
                  <div class="card-content">
                    <h2><a href={`/${entry.rentalType}/${entry.id}/`}>{data.title}</a></h2>
                    {location && <p class="location">📍 {location}</p>}
                    <div class="facts">
                      {(data.area || data.areaValue != null) && <span>Diện tích: <strong>{formatCardArea(data.area, data.areaValue)}</strong></span>}
                      {data.bedrooms != null && <span><strong>{data.bedrooms} phòng ngủ</strong></span>}
                    </div>
                    <div class="card-footer">
                      <strong class="price">{data.price || 'Liên hệ'}</strong>
                      <div class="card-action-row">
                        <a class="detail-link" href={`/${entry.rentalType}/${entry.id}/`}>Xem chi tiết</a>
                        {formatPostedDate(data.date) && <time class="posted-date">Ngày đăng: {formatPostedDate(data.date)}</time>}
                      </div>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
          {totalPages > 1 && (
            <nav class="pagination" id="pagination" aria-label="Phân trang bất động sản cho thuê" data-total-pages={totalPages}>
              <button type="button" data-action="previous" disabled>‹ Trước</button>
              <span id="page-status" aria-live="polite">Trang 1 / {totalPages}</span>
              <button type="button" data-action="next">Sau ›</button>
            </nav>
          )}
        </>
      ) : (
        <div class="empty-state"><h2>Đang cập nhật bất động sản cho thuê</h2><p>Hiện chưa có bất động sản cho thuê tại {area.name}. Anh/chị vui lòng quay lại sau hoặc liên hệ để được tư vấn.</p><a href="tel:0869437415">Gọi 0869 437 415</a></div>
      )}
    </div>
  </main>
  <script>
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#property-grid .property-card'));
    const grid = document.querySelector<HTMLElement>('#property-grid');
    const sort = document.querySelector<HTMLSelectElement>('#sort-listings');
    const pagination = document.querySelector<HTMLElement>('#pagination');
    const previous = pagination?.querySelector<HTMLButtonElement>('[data-action="previous"]');
    const next = pagination?.querySelector<HTMLButtonElement>('[data-action="next"]');
    const status = pagination?.querySelector<HTMLElement>('#page-status');
    const originalOrder = new Map(cards.map((card, index) => [card, index]));
    const valueOf = (card: HTMLElement, key: string) => {
      const raw = card.dataset[key as keyof DOMStringMap];
      return raw === undefined || raw === '' ? null : Number(raw);
    };
    const total = Math.max(1, Math.ceil(cards.length / 12));
    let current = 1;
    const showPage = (scroll = false) => {
      cards.forEach(card => { card.hidden = Number(card.dataset.page) !== current; });
      if (previous) previous.disabled = current === 1;
      if (next) next.disabled = current === total;
      if (status) status.textContent = `Trang ${current} / ${total}`;
      if (scroll) document.querySelector('.heading')?.scrollIntoView({behavior:'smooth',block:'start'});
    };
    sort?.addEventListener('change', () => {
      const mode = sort.value;
      cards.sort((a,b) => {
        if (mode === 'newest') return (valueOf(b,'date') || 0) - (valueOf(a,'date') || 0) || originalOrder.get(a)! - originalOrder.get(b)!;
        if (mode === 'price-asc' || mode === 'price-desc' || mode === 'area-desc') {
          const key = mode === 'area-desc' ? 'area' : 'price';
          const av = valueOf(a,key), bv = valueOf(b,key);
          if (av === null && bv !== null) return 1;
          if (bv === null && av !== null) return -1;
          if (av !== null && bv !== null && av !== bv) return mode === 'price-asc' ? av - bv : bv - av;
        }
        return originalOrder.get(a)! - originalOrder.get(b)!;
      });
      cards.forEach((card,index) => {card.dataset.page = String(Math.floor(index / 12) + 1);grid?.appendChild(card);});
      current = 1;
      showPage();
    });
    previous?.addEventListener('click', () => {if(current>1){current--;showPage(true);}});
    next?.addEventListener('click', () => {if(current<total){current++;showPage(true);}});
    showPage();
  </script>
  <style>
    .listing-page{background:#f5f8fb;color:#19334d;min-height:65vh;padding:28px 0 70px}
    .container{max-width:1200px;margin:0 auto;padding:0 20px}
    .breadcrumbs{display:flex;gap:9px;flex-wrap:wrap;color:#68798a;font-size:13px;margin-bottom:24px}
    .breadcrumbs a{color:#1a5d8c;text-decoration:none}
    .heading{margin-bottom:24px}
    .heading h1{font-size:clamp(27px,3vw,38px);line-height:1.25;margin:0 0 10px;color:#173c5b}
    .heading p{color:#63788a;margin:0;line-height:1.6}
    .result-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:0 0 18px}
    .result-count{font-size:14px;color:#60758a;margin:0}
    .result-toolbar label{display:flex;align-items:center;gap:12px;white-space:nowrap;font-size:14px;font-weight:600;color:#36536a}
    .result-toolbar select{min-height:40px;max-width:100%;padding:0 9px;border:1px solid #cbd7e3;border-radius:8px;background:#fff;color:#19334d;font-size:16px}
    .property-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
    .property-card{background:#fff;border:1px solid #e6ebf0;border-radius:14px;overflow:hidden;box-shadow:0 5px 18px rgba(26,60,90,.055);display:flex;flex-direction:column;min-width:0}
    .property-card[hidden]{display:none!important}
    .image-link{display:block;position:relative;aspect-ratio:16/10;overflow:hidden;background:#e9eff4}
    .image-link img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .25s}
    .property-card:hover .image-link img{transform:scale(1.035)}
    .featured-tag{position:absolute;top:12px;left:12px;background:#bb7a26;color:#fff;font-size:12px;font-weight:700;border-radius:6px;padding:6px 10px}
    .card-content{padding:17px;display:flex;flex-direction:column;gap:11px;flex:1}
    .card-content h2{font-size:18px;line-height:1.45;margin:0}
    .card-content h2 a{color:#193b59;text-decoration:none}
    .card-content h2 a:hover{color:#14669b}
    .location{margin:0;color:#6b7d8d;font-size:13px;line-height:1.5}
    .facts{display:flex;gap:7px 16px;flex-wrap:wrap;color:#415d74;font-size:16px;font-weight:700}
    .facts strong{color:#344f66}
    .card-footer{border-top:1px solid #edf0f3;margin-top:auto;padding-top:13px;display:flex;align-items:center;justify-content:space-between;gap:10px}
    .price{color:#c43232;font-size:18px}
    .card-action-row{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;flex:1}
    .posted-date{font-size:12px;color:#657b8d;white-space:nowrap}
    .detail-link{font-size:13px;font-weight:700;color:#1a628f;text-decoration:none;white-space:nowrap}
    .pagination{display:flex;justify-content:center;align-items:center;gap:18px;margin-top:34px}
    .pagination button{border:1px solid #ccd8e2;border-radius:8px;background:#fff;padding:10px 16px;color:#184b70;font:inherit;cursor:pointer}
    .pagination button:disabled{opacity:.45;cursor:not-allowed}
    .pagination span{font-size:14px;color:#536b7e}
    .empty-state{padding:45px 25px;text-align:center;border-radius:14px;background:#fff;border:1px solid #e5edf3}
    .empty-state h2{margin:0 0 10px;font-size:23px}
    .empty-state p{color:#60758a;line-height:1.6}
    .empty-state a{color:#1b648f;font-weight:700}
    @media(max-width:900px){.property-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}}
    @media(max-width:600px){.result-count{display:none}.result-toolbar{justify-content:flex-end}.result-toolbar label{gap:14px}.result-toolbar select{max-width:calc(100vw - 145px)}}
    @media(max-width:600px){.container{padding:0 14px}.property-grid{grid-template-columns:1fr;gap:15px}.card-content{padding:15px}.listing-page{padding-top:20px}.pagination{gap:10px}.pagination button{padding:9px 12px}}
  </style>
</Base>
