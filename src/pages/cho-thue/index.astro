---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { sortFeaturedFirst, paginateListings } from '../../utils/listingSort';

const apartments = sortFeaturedFirst(
  (await getCollection('can-ho')).filter((item) =>
    item.data.status === 'published' &&
    item.data.listingStatus === 'available' &&
    item.data.transaction === 'cho-thue'
  )
);
const pageSize = 12;
const pagination = paginateListings(apartments, 1, pageSize);
const totalPages = pagination.totalPages;
const description = 'Danh sách căn hộ cho thuê tại Đà Nẵng, cập nhật giá thuê, diện tích, phòng ngủ và vị trí. Ưu tiên căn hộ nổi bật và tin đăng mới nhất.';
const plain = (value: unknown) => typeof value === 'string' ? value.replace(/<[^>]*>/g, '').trim() : '';
const formatArea = (value: string | null | undefined) => plain(value) || 'Liên hệ';
const imageFor = (data: { image?: string | null; gallery?: string[] | null }) => {
  const candidates = [data.image, ...(data.gallery || [])];
  return candidates.find((value) => typeof value === 'string' && (value.startsWith('/') || value.startsWith('https://'))) || '';
};
---
<Base title="Căn Hộ Cho Thuê Đà Nẵng | Căn Hộ Đà Nẵng" description={description}>
  <main>
    <section class="listing-hero">
      <div class="listing-container">
        <nav class="breadcrumb" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><span>Căn hộ cho thuê</span></nav>
        <p class="eyebrow">CHO THUÊ CĂN HỘ ĐÀ NẴNG</p>
        <h1>Căn Hộ Cho Thuê Đà Nẵng</h1>
        <p>Tìm căn hộ cho thuê theo dự án, giá thuê, diện tích và số phòng ngủ. Căn hộ được ghim ưu tiên hiển thị trước, tiếp theo là tin đăng mới nhất.</p>
      </div>
    </section>

    <section class="listing-section" aria-label="Danh sách căn hộ cho thuê">
      <div class="listing-container">
        <div class="section-heading">
          <div><p class="eyebrow">DANH SÁCH CĂN HỘ</p><h2>Căn hộ đang cho thuê</h2></div>
          <span class="count">{apartments.length} căn hộ</span>
        </div>
        {apartments.length ? (
          <>
            <div class="listing-grid" id="rental-grid">
              {apartments.map((item, index) => {
                const d = item.data;
                const image = imageFor(d);
                const href = `/can-ho/${item.id}/`;
                return (
                  <article class="listing-card" data-listing-index={index} hidden={index >= pageSize}>
                    <a class="listing-image" href={href} aria-label={`Xem căn hộ ${d.title}`}>
                      {image ? <img src={image} alt={d.imageAlt || `Căn hộ ${d.title}`} loading="lazy" /> : <div class="image-placeholder" aria-hidden="true">CĂN HỘ ĐÀ NẴNG</div>}
                      {d.featured && <span class="pin-label">Nổi bật</span>}
                    </a>
                    <div class="listing-body">
                      <h3><a href={href}>{d.title}</a></h3>
                      <strong class="price">{plain(d.price) || 'Liên hệ giá thuê'}</strong>
                      <div class="facts">
                        <span>Diện tích: {formatArea(d.area)}</span>
                        {d.bedrooms != null && <span>{d.bedrooms} phòng ngủ</span>}
                        {d.bathrooms != null && <span>{d.bathrooms} phòng tắm</span>}
                      </div>
                      {d.address && <p class="address">{d.address}</p>}
                      <a class="detail-link" href={href}>Xem chi tiết <span aria-hidden="true">→</span></a>
                    </div>
                  </article>
                );
              })}
            </div>
            {totalPages > 1 && (
              <nav class="pagination" aria-label="Phân trang căn hộ cho thuê" id="rental-pagination">
                <button type="button" data-action="prev" aria-label="Trang trước">‹ Trước</button>
                <span id="pagination-numbers" class="page-numbers"></span>
                <button type="button" data-action="next" aria-label="Trang sau">Sau ›</button>
              </nav>
            )}
            <p class="page-summary" id="rental-page-summary" aria-live="polite">Hiển thị {Math.min(pageSize, apartments.length)} / {apartments.length} căn hộ</p>
          </>
        ) : (
          <div class="empty-state"><h2>Đang cập nhật căn hộ</h2><p>Hiện chưa có căn hộ cho thuê phù hợp. Anh/chị có thể liên hệ để được tư vấn.</p></div>
        )}
      </div>
    </section>
    <section class="listing-contact"><div class="listing-container contact-inner"><div><h2>Cần thuê căn hộ tại Đà Nẵng?</h2><p>Liên hệ để được tư vấn căn hộ cho thuê phù hợp nhu cầu và ngân sách.</p></div><a href="tel:0869437415">Gọi 0869 437 415</a></div></section>
  </main>
</Base>

<script define:vars={{ pageSize, totalPages }} is:inline>
  (() => {
    const grid = document.getElementById('rental-grid');
    const pagination = document.getElementById('rental-pagination');
    if (!grid || !pagination) return;
    const cards = [...grid.querySelectorAll('[data-listing-index]')];
    const numbers = document.getElementById('pagination-numbers');
    const summary = document.getElementById('rental-page-summary');
    const readPage = () => {
      const raw = Number(new URLSearchParams(location.search).get('page'));
      return Number.isInteger(raw) && raw >= 1 && raw <= totalPages ? raw : 1;
    };
    let currentPage = readPage();
    const render = (page, scroll = false) => {
      currentPage = Math.min(totalPages, Math.max(1, page));
      const start = (currentPage - 1) * pageSize;
      cards.forEach((card, i) => { card.hidden = i < start || i >= start + pageSize; });
      numbers.replaceChildren();
      for (let n = 1; n <= totalPages; n++) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = String(n);
        button.className = n === currentPage ? 'active' : '';
        if (n === currentPage) button.setAttribute('aria-current', 'page');
        button.addEventListener('click', () => go(n));
        numbers.append(button);
      }
      pagination.querySelector('[data-action="prev"]').disabled = currentPage === 1;
      pagination.querySelector('[data-action="next"]').disabled = currentPage === totalPages;
      summary.textContent = `Hiển thị ${start + 1}–${Math.min(start + pageSize, cards.length)} / ${cards.length} căn hộ`;
      if (scroll) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    const go = (page) => {
      const url = new URL(location.href);
      if (page === 1) url.searchParams.delete('page');
      else url.searchParams.set('page', String(page));
      history.pushState({ page }, '', url);
      render(page, true);
    };
    pagination.querySelector('[data-action="prev"]').addEventListener('click', () => go(currentPage - 1));
    pagination.querySelector('[data-action="next"]').addEventListener('click', () => go(currentPage + 1));
    addEventListener('popstate', () => render(readPage()));
    render(currentPage);
  })();
</script>

<style>
  .listing-container{width:min(1200px,calc(100% - 40px));margin:0 auto}
  .listing-hero{background:linear-gradient(120deg,#102c49,#245679);color:#fff;padding:48px 0 65px}
  .breadcrumb{display:flex;align-items:center;gap:10px;font-size:13px;margin-bottom:35px;color:#e3edf5}
  .breadcrumb a{color:inherit;text-decoration:none}.breadcrumb a:hover{text-decoration:underline}
  .eyebrow{font-size:12px;font-weight:800;letter-spacing:1.5px;margin:0 0 12px;color:#c9a064}
  .listing-hero h1{font-size:clamp(30px,4vw,48px);line-height:1.2;margin:0 0 18px}
  .listing-hero .listing-container>p:last-child{max-width:780px;color:#e3edf5;line-height:1.8;margin:0}
  .listing-section{padding:58px 0 75px;background:#f6f8fb}
  .section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:26px}
  .section-heading h2{font-size:clamp(24px,3vw,32px);color:#173a58;margin:0}.count{color:#62778b;font-size:14px;white-space:nowrap}
  .listing-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;scroll-margin-top:24px}
  .listing-card{overflow:hidden;border:1px solid #e1e7ed;border-radius:15px;background:#fff;box-shadow:0 8px 25px #102c490d;display:flex;flex-direction:column}
  .listing-card[hidden]{display:none!important}
  .listing-image{height:220px;display:block;position:relative;overflow:hidden;background:#dbe6ee}
  .listing-image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s}.listing-image:hover img{transform:scale(1.04)}
  .image-placeholder{height:100%;display:grid;place-items:center;background:linear-gradient(135deg,#d8e4ed,#a9c1d2);color:#244e70;font-size:14px;font-weight:800;letter-spacing:1px}
  .pin-label{position:absolute;top:12px;left:12px;background:#c99b56;color:#fff;padding:6px 10px;border-radius:6px;font-size:12px;font-weight:700}
  .listing-body{padding:23px;display:flex;flex-direction:column;flex:1}.listing-body h3{font-size:20px;line-height:1.4;margin:0 0 12px}
  .listing-body h3 a{color:#153d61;text-decoration:none}.listing-body h3 a:hover{color:#b58642}
  .price{color:#c52d2d;font-size:20px;margin-bottom:13px}.facts{display:flex;gap:9px 15px;flex-wrap:wrap;font-size:13px;color:#415d74;margin-bottom:12px}
  .address{color:#657b8d;font-size:13px;line-height:1.6;margin:0 0 20px}.detail-link{margin-top:auto;color:#a77630;font-weight:800;text-decoration:none;font-size:14px}.detail-link:hover{text-decoration:underline}
  .pagination{display:flex;justify-content:center;align-items:center;gap:10px;margin-top:35px;flex-wrap:wrap}.page-numbers{display:flex;gap:6px;flex-wrap:wrap}
  .pagination button{border:1px solid #ccd8e3;background:#fff;color:#173a58;border-radius:8px;min-width:40px;padding:10px 12px;font:inherit;font-weight:700;cursor:pointer}
  .pagination button.active{background:#153d61;color:#fff;border-color:#153d61}.pagination button:disabled{opacity:.4;cursor:not-allowed}
  .page-summary{text-align:center;color:#64798a;font-size:13px;margin:18px 0 0}.empty-state{padding:50px 24px;border-radius:15px;text-align:center;background:#fff;border:1px solid #e1e7ed}.empty-state h2{color:#173a58}.empty-state p{color:#62778b}
  .listing-contact{background:#102c49;color:#fff;padding:35px 0}.contact-inner{display:flex;align-items:center;justify-content:space-between;gap:25px}
  .contact-inner h2{font-size:24px;margin:0 0 8px}.contact-inner p{color:#d4e2ee;margin:0}.contact-inner>a{display:inline-block;background:#c99b56;color:#fff;padding:14px 22px;border-radius:9px;font-weight:800;text-decoration:none;white-space:nowrap}
  @media(max-width:900px){.listing-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.listing-container{width:min(100% - 28px,1200px)}.listing-hero{padding:30px 0 45px}.breadcrumb{margin-bottom:25px}.listing-section{padding:38px 0 50px}.listing-grid{grid-template-columns:1fr;gap:18px}.listing-image{height:210px}.section-heading{align-items:start}.contact-inner{flex-direction:column;align-items:start}.contact-inner>a{width:100%;text-align:center}}
</style>
