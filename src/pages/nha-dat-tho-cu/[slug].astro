---
import Base from '../../layouts/Base.astro';
import PropertyDetail from '../../components/PropertyDetail.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const properties = await getCollection('nha-dat-tho-cu');
  return properties
    .filter((entry) => entry.data.status !== 'draft')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
const project = data.project
  ? (await getCollection('du-an')).find(item => item.id === data.project && item.data.status === 'published')
  : undefined;
const activeLand = (await getCollection('nha-dat-tho-cu')).filter(item => item.data.status === 'published' && item.data.listingStatus === 'available' && item.data.transaction === 'ban');
const allowedWards = [
  { name: 'Sơn Trà', slug: 'Son Tra' },
  { name: 'Hải Châu', slug: 'Hai Chau' },
  { name: 'Thanh Khê', slug: 'Thanh Khe' },
  { name: 'Ngũ Hành Sơn', slug: 'Ngu Hanh Son' },
];
const normalizeWard = (value: unknown) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/gi, 'd').toLowerCase().replace(/^(phuong|quan|huyen)\s+/, '').trim();
const wardCounts = allowedWards.map(ward => ({
  ...ward,
  count: activeLand.filter(item => [item.data.ward, item.data.district].some(value => normalizeWard(value) === normalizeWard(ward.name))).length,
}));
const siteUrl = 'https://canhodanang.store';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const absoluteImage = (path: string) => new URL(path, siteUrl).href;
const seoTitle = data.seoTitle || data.title;
const seoDescription = data.description || `Thông tin ${data.title}. Liên hệ 0869 437 415 để được tư vấn.`;
const isRent = data.transaction === 'cho-thue' || data.transaction === 'cho-thue-ngay';
const isAvailable = data.listingStatus === 'available';
const statusLabel = isAvailable ? (isRent ? 'Đang cho thuê' : 'Đang bán') : data.listingStatus === 'paused' ? 'Tạm ngừng giao dịch' : (isRent ? 'Đã cho thuê' : 'Đã bán');

// Dữ liệu có cấu trúc: không suy đoán nhà hay đất nếu loại hình chưa rõ.
const propertyType = (data.propertyType || '').toLowerCase();
const isLand = /đất|dat nen|đất nền|lô đất/.test(propertyType);
const isHouse = /nhà|nha pho|nhà phố/.test(propertyType);
const schemaType = isLand ? 'Landform' : isHouse ? 'House' : 'Place';
const area = data.areaValue != null && Number(data.areaValue) > 0 ? Number(data.areaValue) : null;
const price = data.priceValue != null && Number(data.priceValue) > 0 ? Number(data.priceValue) * 1_000_000 : null;
const propertySchema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  '@id': `${pageUrl}#property`,
  name: data.title,
  description: seoDescription,
  url: pageUrl,
  ...(data.image ? { image: [data.image, ...(data.gallery ?? [])].filter(Boolean).map(absoluteImage) } : {}),
  ...(data.address || data.ward || data.district ? {
    address: {
      '@type': 'PostalAddress',
      ...(data.address ? { streetAddress: data.address } : {}),
      ...(data.ward || data.district ? { addressLocality: [data.ward, data.district].filter(Boolean).join(', ') } : {}),
      addressRegion: 'Đà Nẵng',
      addressCountry: 'VN',
    },
  } : {}),
  ...(area ? { additionalProperty: [{ '@type': 'PropertyValue', name: 'Diện tích đất', value: area, unitCode: 'MTK' }] } : {}),
  ...(isHouse && data.bedrooms != null ? { numberOfBedrooms: data.bedrooms } : {}),
  ...(isHouse && data.bathrooms != null ? { numberOfBathroomsTotal: data.bathrooms } : {}),
  ...(price && !isRent ? {
    offers: {
      '@type': 'Offer',
      price,
      priceCurrency: 'VND',
      availability: isAvailable ? 'https://schema.org/InStock' : 'https://schema.org/SoldOut',
      url: pageUrl,
    },
  } : {}),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Nhà đất thổ cư', item: `${siteUrl}/nha-dat-tho-cu/` },
    { '@type': 'ListItem', position: 3, name: data.title, item: pageUrl },
  ],
};
const jsonLd = JSON.stringify([propertySchema, breadcrumbSchema]).replace(/</g, '\\u003c');
---
<Base title={seoTitle} description={seoDescription} image={data.ogImage || data.image || undefined} imageAlt={data.imageAlt || data.title} type="article">
  <script type="application/ld+json" set:html={jsonLd} />
  <div class="property-page">
    <div class="property-wrap">
      <nav class="breadcrumbs" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a>
        <span aria-hidden="true">/</span>
        <a href="/nha-dat-tho-cu/">Nhà đất thổ cư</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{data.title}</span>
      </nav>
      <div class="property-intro">
        <span class:list={['status', { inactive: !isAvailable }]}>{statusLabel}</span>
      </div>
      <div class="property-layout">
        <main class="property-main">
          <PropertyDetail property={data} kind="nha-dat-tho-cu" phone="0869437415" zalo="0869437415">
            <Content />
          </PropertyDetail>
          {project && <aside class="linked-project"><h2>Dự án liên quan</h2><a href={`/du-an/${project.id}/`}>{project.data.title} →</a><p>{project.data.location}</p></aside>}
        </main>
        <aside class="property-sidebar" aria-label="Tư vấn và nhà đất theo phường">
          <section class="consultant-card">
            <div class="consultant-heading"><span>Tư vấn bất động sản</span><strong>Mua nhà Đà Nẵng</strong></div>
            <div class="consultant-body">
              <div class="consultant-avatar"><img src="/uploads/tu-van-vien-vest.jpg" alt="Chuyên viên tư vấn bất động sản Đà Nẵng" loading="lazy" /></div>
              <h2>Liên hệ tư vấn</h2><p>Hỗ trợ xem nhà và thông tin giao dịch</p>
              <a class="consultant-zalo" href="https://zalo.me/0869437415" target="_blank" rel="noopener noreferrer">Chat qua Zalo</a>
              <a class="consultant-call" href="tel:0869437415">☎ 0869 437 415</a>
            </div>
          </section>
          <section class="sidebar-regions"><h2>Nhà đất theo phường</h2>
            <ul>{wardCounts.map(ward => <li><a href={`/nha-dat-tho-cu/?phuong=${encodeURIComponent(ward.slug)}`}>{ward.name}</a><strong>{ward.count} tin đang bán</strong></li>)}</ul>
          </section>
        </aside>
      </div>
      <p class="back-link"><a href="/nha-dat-tho-cu/">← Xem các nhà đất khác</a></p>
    </div>
  </div>
  <style>
    .property-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px;align-items:start}.property-main{min-width:0}.property-sidebar{min-width:0;position:sticky;top:88px;display:grid;gap:16px}
    .consultant-card,.sidebar-regions{background:#fff;border:1px solid #e0e7ef;border-radius:14px;overflow:hidden;box-shadow:0 6px 22px #102c4915}.consultant-heading{background:linear-gradient(125deg,#10365e,#185d8c);color:#fff;padding:17px 14px;text-align:center;display:grid;gap:5px;font-size:16px}.consultant-heading strong{font-size:20px;color:#f4c16b;line-height:1.35}.consultant-body{padding:20px 16px;text-align:center}.consultant-avatar{width:150px;height:150px;margin:0 auto 14px;border:2px solid #b88b41;border-radius:50%;overflow:hidden;background:#edf3f8}.consultant-avatar img{width:100%;height:100%;object-fit:cover;object-position:center 20%}.consultant-body h2{font-size:17px;margin:0 0 7px;color:#17334d}.consultant-body p{font-size:13px;color:#718092;margin:0 0 16px}.consultant-zalo,.consultant-call{display:block;padding:12px;border-radius:9px;font-weight:700;text-decoration:none;margin-top:9px}.consultant-zalo{border:1px solid #b9c9dc;color:#135c99}.consultant-call{background:#009d9f;color:#fff}.sidebar-regions h2{margin:0;padding:15px;background:#eff5fa;color:#173d62;font-size:18px}.sidebar-regions ul{list-style:none;padding:5px 14px;margin:0}.sidebar-regions li{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:13px 0;border-bottom:1px solid #e6edf2;font-size:14px}.sidebar-regions li:last-child{border:0}.sidebar-regions li a{color:#174b73;text-decoration:none;font-weight:600}.sidebar-regions li a:hover{color:#b17e32;text-decoration:underline}.sidebar-regions li strong{font-size:12px;color:#637b90;white-space:nowrap}.sidebar-regions p{padding:0 15px;color:#718092;font-size:13px}
    @media(max-width:980px){.property-layout{grid-template-columns:minmax(0,1fr)}.property-sidebar{position:static;grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.property-sidebar{grid-template-columns:1fr}}
    .property-page{background:#f5f8fb;color:#19334d;padding:30px 0 65px}
    .property-wrap{max-width:1160px;margin:0 auto;padding:0 20px}
    .breadcrumbs{display:flex;flex-wrap:wrap;gap:9px;font-size:13px;color:#68798a;margin-bottom:20px;overflow-wrap:anywhere}
    .breadcrumbs a,.back-link a{color:#1a5d8c}
    .property-intro{display:flex;justify-content:flex-end;align-items:center;margin-bottom:12px}
    .status{background:#e5f5ec;color:#14663a;border-radius:30px;padding:8px 14px;font-size:13px;font-weight:700;white-space:nowrap}
    .status.inactive{background:#f2e9e6;color:#8c3d32}
    .linked-project{margin-top:24px;padding:22px;background:#fff;border:1px solid #e3eaf0;border-radius:12px}.linked-project h2{font-size:20px;margin:0 0 10px}.linked-project a{color:#1a5d8c;font-weight:700}.linked-project p{color:#62788b;margin:8px 0 0}
    .back-link{margin-top:28px}
    @media(max-width:767px){.property-wrap{padding:0 14px}}
  </style>
</Base>
