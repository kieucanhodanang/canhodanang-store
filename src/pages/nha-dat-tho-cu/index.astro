---
import Base from '../../layouts/Base.astro';
import { formatListingPrice } from '../../utils/formatListingPrice';
import { getCollection } from 'astro:content';
import { sortFeaturedFirst, paginateListings } from '../../utils/listingSort';

const properties = sortFeaturedFirst(
  (await getCollection('nha-dat-tho-cu')).filter((entry) =>
    entry.data.status !== 'draft' &&
    entry.data.listingStatus === 'available' &&
    entry.data.transaction === 'ban'
  )
);
const { totalItems } = paginateListings(properties, 1, 12);
const areas = ['Sơn Trà', 'Hải Châu', 'Thanh Khê', 'Ngũ Hành Sơn'];
const formatArea = (value: unknown, fallback?: number | null) => {
  const raw = String(value ?? fallback ?? '').trim();
  return raw ? (/m²|m2|mét vuông/i.test(raw) ? raw : `${raw} m²`) : '';
};
const formatPostedDate = (value: unknown) => {
  if (!value) return '';
  const date = value instanceof Date ? value : new Date(String(value));
  return Number.isNaN(date.getTime()) ? '' : new Intl.DateTimeFormat('vi-VN', {day:'2-digit',month:'2-digit',year:'numeric'}).format(date);
};
const description = 'Tìm mua bán nhà đất thổ cư Đà Nẵng theo vị trí, diện tích và giá chào bán. Xem thông tin pháp lý từng bất động sản, liên hệ 0869 437 415 để tư vấn.';
---
<Base title="Mua Bán Nhà Đất Thổ Cư Đà Nẵng | Giá & Vị Trí" description={description}>
  <main class="listing-page">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><span aria-current="page">Nhà đất thổ cư</span></nav>
      <header class="heading">
        <h1>Nhà đất thổ cư Đà Nẵng</h1>
        <p>Thông tin nhà đất đang bán, cập nhật từ hệ thống quản lý bất động sản.</p>
      </header>
      <form class="apartment-search" id="property-search" role="search">
        <label class="search-input"><span aria-hidden="true">⌕</span><input id="search-keyword" type="search" placeholder="Tìm nhà đất, đường, khu vực..." aria-label="Từ khóa tìm kiếm nhà đất" autocomplete="off" /></label>
        <button type="submit">Tìm kiếm</button>
      </form>
      <div class="quick-filters" aria-label="Bộ lọc nhanh nhà đất">
        <label>Khu vực<select id="search-area"><option value="">Tất cả khu vực</option>{areas.map(area => <option value={area}>{area}</option>)}</select></label>
        <label>Khoảng giá<select id="search-price"><option value="">Tất cả mức giá</option><option value="0-3000">Dưới 3 tỷ</option><option value="3000-5000">3 – 5 tỷ</option><option value="5000-7000">5 – 7 tỷ</option><option value="7000-10000">7 – 10 tỷ</option><option value="10000+">Trên 10 tỷ</option></select></label>
        <label>Diện tích<select id="search-size"><option value="">Tất cả diện tích</option><option value="0-60">Dưới 60 m²</option><option value="60-100">60 – 100 m²</option><option value="100-150">100 – 150 m²</option><option value="150+">Trên 150 m²</option></select></label>
        <label>Loại nhà đất<select id="search-type"><option value="">Tất cả loại</option><option value="nha">Nhà ở</option><option value="dat">Đất thổ cư</option></select></label>
        <label>Phòng ngủ<select id="search-bedrooms"><option value="">Tất cả phòng ngủ</option><option value="1">1 phòng</option><option value="2">2 phòng</option><option value="3">3 phòng</option><option value="4+">4+ phòng</option></select></label>
      </div>
      <button class="clear-search" type="button" id="clear-search">Xóa bộ lọc</button>
      <div class="listing-layout"><div class="listing-primary">
      {totalItems > 0 ? (
        <>
          <div class="result-toolbar">
            <p class="result-count" id="result-count" aria-live="polite">Có <strong>{totalItems}</strong> bất động sản đang bán</p>
            <label for="sort-listings">Sắp xếp <select id="sort-listings"><option value="default">Nổi bật / Mới nhất</option><option value="newest">Mới nhất</option><option value="price-asc">Giá thấp đến cao</option><option value="price-desc">Giá cao đến thấp</option><option value="area-desc">Diện tích lớn nhất</option></select></label>
          </div>
          <div class="property-grid" id="property-grid">
            {properties.map((entry, index) => {
              const data = entry.data;
              const location = [data.ward, data.district].filter(Boolean).join(' · ') || data.address;
              return (
                <article class="property-card" data-keywords={[data.title,data.description,data.address,data.district,data.ward].filter(Boolean).join(' ')} data-district={data.district || ''} data-ward={data.ward || ''} data-price={data.priceValue ?? ''} data-area={data.areaValue ?? ''} data-type={data.propertyType || ''} data-bedrooms={data.bedrooms ?? ''} data-date={data.date instanceof Date ? data.date.getTime() : 0} data-featured={data.featured ? '1' : '0'} hidden={index >= 12}>
                  <a href={`/nha-dat-tho-cu/${entry.id}/`} class="image-link" aria-label={`Xem ${data.title}`}>
                    <img src={data.image} alt={data.imageAlt || data.title} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
                    {data.featured && <span class="featured-tag">Nổi bật</span>}
                  </a>
                  <div class="card-content">
                    <h2><a href={`/nha-dat-tho-cu/${entry.id}/`}>{data.title}</a></h2>
                    {location && <p class="location">📍 {location}</p>}
                    <div class="facts">
                      {(data.area || data.areaValue != null) && <span>Diện tích: <strong>{formatArea(data.area, data.areaValue)}</strong></span>}
                      {data.bedrooms != null && <span><strong>{data.bedrooms} phòng ngủ</strong></span>}
                    </div>
                    <div class="card-footer">
                      <strong class="price">{formatListingPrice(data.price, 'ban', data.priceValue)}</strong>
                      <div class="card-action-row"><a class="detail-link" href={`/nha-dat-tho-cu/${entry.id}/`}>Xem chi tiết</a>{formatPostedDate(data.date) && <time class="posted-date" datetime={data.date instanceof Date ? data.date.toISOString().slice(0,10) : String(data.date).slice(0,10)}>Ngày đăng: {formatPostedDate(data.date)}</time>}</div>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
          <nav class="pagination" id="pagination" aria-label="Phân trang nhà đất" hidden>
            <button type="button" data-action="previous">‹ Trước</button>
            <span id="page-status" aria-live="polite"></span>
            <button type="button" data-action="next">Sau ›</button>
          </nav>
          <p class="empty-filter" id="empty-filter" hidden>Không tìm thấy nhà đất phù hợp. Hãy thử thay đổi bộ lọc.</p>
        </>
      ) : (
        <div class="empty-state"><h2>Đang cập nhật nhà đất</h2><p>Hiện chưa có bất động sản đang bán phù hợp. Anh/chị vui lòng quay lại sau hoặc liên hệ để được tư vấn.</p><a href="tel:0869437415">Gọi 0869 437 415</a></div>
      )}
      </div>
      <aside class="listing-sidebar" aria-label="Bộ lọc nhà đất">
        <div class="filter-box">
          <div class="filter-top"><h2>Bộ lọc nhà đất</h2><button type="button" id="reset-filters">Xóa lọc</button></div>
          <fieldset><legend>Khu vực</legend>
            <label><input type="radio" name="district" value="" checked /> Tất cả khu vực</label>
            {areas.map(area => <label><input type="radio" name="district" value={area} /> {area}</label>)}
          </fieldset>
          <fieldset><legend>Khoảng giá</legend>
            <label><input type="radio" name="price" value="" checked /> Tất cả mức giá</label>
            <label><input type="radio" name="price" value="0-3000" /> Dưới 3 tỷ</label>
            <label><input type="radio" name="price" value="3000-5000" /> 3 – 5 tỷ</label>
            <label><input type="radio" name="price" value="5000-7000" /> 5 – 7 tỷ</label>
            <label><input type="radio" name="price" value="7000-10000" /> 7 – 10 tỷ</label>
            <label><input type="radio" name="price" value="10000+" /> Trên 10 tỷ</label>
          </fieldset>
          <fieldset><legend>Diện tích</legend>
            <label><input type="radio" name="area" value="" checked /> Tất cả diện tích</label>
            <label><input type="radio" name="area" value="0-60" /> Dưới 60 m²</label>
            <label><input type="radio" name="area" value="60-100" /> 60 – 100 m²</label>
            <label><input type="radio" name="area" value="100-150" /> 100 – 150 m²</label>
            <label><input type="radio" name="area" value="150+" /> Trên 150 m²</label>
          </fieldset>
          <fieldset><legend>Phòng ngủ</legend>
            <label><input type="radio" name="bedrooms" value="" checked /> Tất cả phòng ngủ</label>
            <label><input type="radio" name="bedrooms" value="1" /> 1 phòng ngủ</label>
            <label><input type="radio" name="bedrooms" value="2" /> 2 phòng ngủ</label>
            <label><input type="radio" name="bedrooms" value="3" /> 3 phòng ngủ</label>
            <label><input type="radio" name="bedrooms" value="4+" /> 4+ phòng ngủ</label>
          </fieldset>
          <div class="project-filter"><label for="sidebar-area">Khu vực</label><select id="sidebar-area"><option value="">Tất cả khu vực</option>{areas.map(area => <option value={area}>{area}</option>)}</select></div>
        </div>
      </aside></div>
    </div>
  </main>
  <script>
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#property-grid .property-card'));
    const form = document.querySelector<HTMLFormElement>('#property-search');
    const keyword = document.querySelector<HTMLInputElement>('#search-keyword');
    const area = document.querySelector<HTMLSelectElement>('#search-area');
    const price = document.querySelector<HTMLSelectElement>('#search-price');
    const size = document.querySelector<HTMLSelectElement>('#search-size');
    const type = document.querySelector<HTMLSelectElement>('#search-type');
    const bedrooms = document.querySelector<HTMLSelectElement>('#search-bedrooms');
    const sidebar = document.querySelector<HTMLElement>('.filter-box');
    const sidebarArea = document.querySelector<HTMLSelectElement>('#sidebar-area');
    const selected = (name: string) => sidebar?.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value || '';
    const sort = document.querySelector<HTMLSelectElement>('#sort-listings');
    const grid = document.querySelector<HTMLElement>('#property-grid');
    const originalOrder = new Map(cards.map((card,index) => [card,index]));
    const numeric = (card: HTMLElement,key: string) => { const v=card.dataset[key as keyof DOMStringMap];return v === undefined || v === '' ? null : Number(v); };
    const pagination = document.querySelector<HTMLElement>('#pagination');
    const previous = pagination?.querySelector<HTMLButtonElement>('[data-action="previous"]');
    const next = pagination?.querySelector<HTMLButtonElement>('[data-action="next"]');
    const status = document.querySelector<HTMLElement>('#page-status');
    const count = document.querySelector<HTMLElement>('#result-count');
    const empty = document.querySelector<HTMLElement>('#empty-filter');
    const normalize = (value: string) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/gi,'d').toLowerCase().trim();
    const inRange = (raw: string | undefined, range: string) => {
      if (!range) return true;
      if (raw === undefined || raw === '') return false;
      const value = Number(raw);
      if (!Number.isFinite(value)) return false;
      if (range.endsWith('+')) return value >= Number(range.slice(0,-1));
      const [min,max] = range.split('-').map(Number);
      return value >= min && value <= max;
    };
    let current = 1;
    const render = (reset = true) => {
      if (reset) current = 1;
      const tokens = normalize(keyword?.value || '').split(/\s+/).filter(Boolean);
      const selectedArea = normalize(area?.value || '');
      const selectedSidebarArea = normalize(sidebarArea?.value || selected('district'));
      const selectedPrice = selected('price') || price?.value || '';
      const selectedSize = selected('area') || size?.value || '';
      const selectedBedrooms = selected('bedrooms') || bedrooms?.value || '';
      const matches = cards.filter(card => {
        const searchable = normalize(card.dataset.keywords || '');
        if (tokens.some(token => !searchable.includes(token))) return false;
        if (selectedArea && !normalize([card.dataset.district,card.dataset.ward].join(' ')).includes(selectedArea)) return false;
        if (selectedSidebarArea && !normalize([card.dataset.district,card.dataset.ward].join(' ')).includes(selectedSidebarArea)) return false;
        if (type?.value && !normalize(card.dataset.type || '').includes(normalize(type.value))) return false;
        if (selectedBedrooms && (selectedBedrooms === '4+' ? Number(card.dataset.bedrooms) < 4 : card.dataset.bedrooms !== selectedBedrooms)) return false;
        return inRange(card.dataset.price,selectedPrice) && inRange(card.dataset.area,selectedSize);
      });
      const sortMode = sort?.value || 'default';
      matches.sort((a,b) => {
        const av = numeric(a,sortMode === 'area-desc' ? 'area' : 'price');
        const bv = numeric(b,sortMode === 'area-desc' ? 'area' : 'price');
        if (sortMode === 'price-asc' || sortMode === 'price-desc' || sortMode === 'area-desc') {
          if (av === null && bv !== null) return 1;
          if (bv === null && av !== null) return -1;
          if (av !== null && bv !== null && av !== bv) return sortMode === 'price-asc' ? av-bv : bv-av;
        }
        if (sortMode === 'newest') return (numeric(b,'date') || 0) - (numeric(a,'date') || 0) || (originalOrder.get(a)!-originalOrder.get(b)!);
        return originalOrder.get(a)!-originalOrder.get(b)!;
      });
      if (grid) matches.forEach(card => grid.appendChild(card));
      const pages = Math.max(1,Math.ceil(matches.length / 12));
      current = Math.min(current,pages);
      const visible = new Set(matches.slice((current-1)*12,current*12));
      cards.forEach(card => { card.hidden = !visible.has(card); });
      if (count) count.textContent = `Có ${matches.length} bất động sản đang bán`;
      if (empty) empty.hidden = matches.length > 0;
      if (pagination) pagination.hidden = pages <= 1;
      if (status) status.textContent = `Trang ${current} / ${pages}`;
      if (previous) previous.disabled = current === 1;
      if (next) next.disabled = current === pages;
    };
    sort?.addEventListener('change', () => render());
    form?.addEventListener('submit', event => { event.preventDefault(); keyword?.blur(); render(); });
    [area,price,size,type,bedrooms,sidebarArea].forEach(el => el?.addEventListener('change', () => render()));
    sidebar?.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(el => el.addEventListener('change', () => {
      if (el.name === 'district' && area) area.value = el.value;
      if (el.name === 'price' && price) price.value = el.value;
      if (el.name === 'area' && size) size.value = el.value;
      if (el.name === 'bedrooms' && bedrooms) bedrooms.value = el.value;
      if (el.name === 'district' && sidebarArea) sidebarArea.value = el.value;
      render();
    }));
    document.querySelector('#clear-search')?.addEventListener('click', () => {
      if (keyword) keyword.value = '';
      if (area) area.value = '';
      if (price) price.value = '';
      if (size) size.value = '';
      if (type) type.value = '';
      if (bedrooms) bedrooms.value = '';
      if (sidebarArea) sidebarArea.value = '';
      sidebar?.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(el => { el.checked = el.value === ''; });
      render();
    });
    document.querySelector('#reset-filters')?.addEventListener('click', () => document.querySelector<HTMLButtonElement>('#clear-search')?.click());
    const go = (delta: number) => { current += delta; render(false); document.querySelector('.heading')?.scrollIntoView({behavior:'smooth',block:'start'}); };
    previous?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));
    // Cho phép thẻ khu vực và sidebar chi tiết liên kết trực tiếp tới bộ lọc phường.
    const requestedWard = new URLSearchParams(window.location.search).get('phuong') || new URLSearchParams(window.location.search).get('district') || '';
    const validWards = ['Sơn Trà', 'Hải Châu', 'Thanh Khê', 'Ngũ Hành Sơn'];
    const matchedWard = validWards.find(name => normalize(name) === normalize(requestedWard));
    if (matchedWard) {
      if (area) area.value = matchedWard;
      if (sidebarArea) sidebarArea.value = matchedWard;
      sidebar?.querySelectorAll<HTMLInputElement>('input[name="district"]').forEach(input => { input.checked = input.value === matchedWard; });
    }
    render();
  </script>
  <style>
    .listing-page{background:#f5f8fb;color:#19334d;min-height:65vh;padding:28px 0 70px}
    .container{max-width:1200px;margin:0 auto;padding:0 20px}
    .breadcrumbs{display:flex;gap:9px;flex-wrap:wrap;color:#68798a;font-size:13px;margin-bottom:24px}
    .breadcrumbs a{color:#1a5d8c;text-decoration:none}
    .heading{margin-bottom:24px}
    .heading h1{font-size:clamp(27px,3vw,38px);line-height:1.25;margin:0 0 10px;color:#173c5b}
    .heading p{color:#63788a;margin:0;line-height:1.7;max-width:760px;overflow-wrap:break-word}
  .apartment-search{display:flex;gap:12px;background:#fff;border:1px solid #e1e7ed;border-radius:12px;padding:12px;margin-bottom:25px}
  .search-input{display:flex;align-items:center;gap:10px;flex:1;min-width:0;background:#f7f9fb;border:1px solid #cbd7e3;border-radius:9px;padding:0 14px}.search-input span{font-size:28px;color:#173a58}
  .search-input input{width:100%;height:45px;border:0;background:transparent;outline:0;font:inherit;min-width:0}
  .apartment-search button{border:0;border-radius:8px;background:#bd3c32;color:white;font:inherit;font-weight:700;padding:0 24px;cursor:pointer}
  .quick-filters{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;background:#fff;border:1px solid #e1e7ed;border-radius:12px;padding:17px;margin:-10px 0 24px;box-shadow:0 4px 16px #102c4908}
  .quick-filters label{display:flex;flex-direction:column;gap:7px;min-width:0;font-size:13px;font-weight:700;color:#173a58}
  .quick-filters select{width:100%;min-width:0;height:43px;padding:0 10px;border:1px solid #cbd7e3;border-radius:8px;background:#fff;color:#243f55;font:inherit;font-weight:400;cursor:pointer}
  .quick-filters select:focus-visible{outline:2px solid #2675ad;outline-offset:2px}
  @media(max-width:760px){.quick-filters{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:12px}}
  @media(max-width:380px){.quick-filters{grid-template-columns:1fr}}
  .listing-layout{display:grid;grid-template-columns:minmax(0,7fr) minmax(250px,3fr);gap:24px;align-items:start}.listing-primary{min-width:0}
  .region-shortcuts{display:flex;flex-wrap:wrap;gap:10px;margin:-6px 0 22px}.region-shortcuts a{border:1px solid #d6e1eb;border-radius:8px;padding:9px 12px;background:#fff;color:#174b73;text-decoration:none;font-size:13px;font-weight:700}.region-shortcuts a:hover{background:#eaf2f8}
  .filter-box{background:white;border:1px solid #e1e7ed;border-radius:13px;padding:20px;position:sticky;top:85px}
  .filter-top{display:flex;justify-content:space-between;align-items:center;gap:10px}.filter-top h2{font-size:20px;color:#173a58;margin:0}.filter-top button{border:0;background:transparent;color:#a77630;cursor:pointer;font-weight:700}
  .filter-box fieldset{border:0;border-bottom:1px solid #e9eef3;padding:17px 0;margin:0;display:grid;gap:11px}.filter-box legend,.project-filter label{font-size:16px;font-weight:800;color:#173a58;padding:0}
  .filter-box fieldset label{display:flex;align-items:center;gap:8px;font-size:14px;color:#314f67;cursor:pointer}.filter-box input{accent-color:#a77630}
  .project-filter{padding-top:18px;display:grid;gap:10px}.project-filter select{width:100%;padding:11px;border:1px solid #cbd7e3;border-radius:8px;background:white;color:#173a58;font:inherit;min-width:0}
  .empty-filter{padding:22px;background:#fff;border-radius:12px;color:#536b81;text-align:center}.empty-filter[hidden],.pagination[hidden]{display:none!important}
    .search-input input,.quick-filters select{font-size:16px}
    .clear-search{display:block;margin:-10px 0 20px auto;border:0;background:transparent;color:#a77630;font-weight:700;cursor:pointer}
    .listing-sidebar{min-width:0}
    @media(max-width:760px){.listing-sidebar{display:none}.listing-layout{grid-template-columns:1fr}}
    .result-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:0 0 18px}
    .result-toolbar .result-count{margin:0}
    .result-toolbar label{display:flex;align-items:center;gap:9px;font-size:14px;font-weight:600;color:#36536a}
    .result-toolbar select{min-height:40px;max-width:100%;padding:0 9px;border:1px solid #cbd7e3;border-radius:8px;background:#fff;color:#19334d;font-size:16px}
    .result-count{font-size:14px;color:#60758a;margin:0 0 18px}
    .property-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
    .property-card{background:#fff;border:1px solid #e6ebf0;border-radius:14px;overflow:hidden;box-shadow:0 5px 18px rgba(26,60,90,.055);display:flex;flex-direction:column;min-width:0}
    .property-card[hidden]{display:none!important}
    .image-link{display:block;position:relative;aspect-ratio:16/10;overflow:hidden;background:#e9eff4}
    .image-link img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .25s}
    .property-card:hover .image-link img{transform:scale(1.035)}
    .featured-tag{position:absolute;top:12px;left:12px;background:#bb7a26;color:#fff;font-size:12px;font-weight:700;border-radius:6px;padding:6px 10px}
    .card-content{padding:17px;display:flex;flex-direction:column;gap:11px;flex:1}
    .card-content h2{font-size:18px;line-height:1.45;margin:0}
    .card-content h2 a{color:#193b59;text-decoration:none}
    .card-content h2 a:hover{color:#14669b}
    .location{margin:0;color:#6b7d8d;font-size:13px;line-height:1.5}
    .facts{display:flex;gap:7px 16px;flex-wrap:wrap;color:#415d74;font-size:16px;font-weight:700}
    .facts strong{color:#344f66}
    .card-footer{border-top:1px solid #edf0f3;margin-top:auto;padding-top:13px;display:flex;align-items:center;justify-content:space-between;gap:10px}
    .price{color:#c43232;font-size:18px}
    .card-action-row{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;flex:1}
    .posted-date{font-size:12px;color:#657b8d;white-space:nowrap}
