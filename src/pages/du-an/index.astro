---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('du-an'))
  .filter((item) => item.data.status !== 'draft')
  .sort((a, b) => (a.data.title || '').localeCompare(b.data.title || '', 'vi'));

const description = 'Danh sách dự án bất động sản Đà Nẵng: thông tin dự án căn hộ, biệt thự, shophouse và các sản phẩm đang được giới thiệu.';

const plainText = (value) => typeof value === 'string' ? value.replace(/<[^>]*>/g, '').trim() : '';
const summary = (data) => {
  const text = plainText(data.summary) || plainText(data.description);
  return text.length > 180 ? `${text.slice(0, 177).trimEnd()}…` : text;
};
const imageFor = (data) => {
  for (const key of ['image', 'coverImage', 'thumbnail']) {
    const value = data[key];
    if (typeof value === 'string' && (value.startsWith('/') || value.startsWith('https://'))) return value;
  }
  return '';
};
---

<Base title="Dự Án Bất Động Sản Đà Nẵng | Căn Hộ Đà Nẵng" description={description}>
  <main>
    <section class="project-hero">
      <div class="project-container">
        <nav class="breadcrumb" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><span>Dự án</span></nav>
        <p class="eyebrow">KHÁM PHÁ BẤT ĐỘNG SẢN ĐÀ NẴNG</p>
        <h1>Dự Án Bất Động Sản Đà Nẵng</h1>
        <p>Khám phá thông tin các dự án căn hộ, biệt thự và shophouse tại Đà Nẵng. Chọn dự án để xem thông tin chi tiết và sản phẩm liên quan.</p>
      </div>
    </section>

    <section class="project-section" aria-label="Danh sách dự án">
      <div class="project-container">
        <div class="section-heading">
          <div><p class="eyebrow">DANH SÁCH DỰ ÁN</p><h2>Các dự án đang giới thiệu</h2></div>
          <span class="count">{projects.length} dự án</span>
        </div>
        {projects.length ? (
          <div class="project-grid">
            {projects.map((project) => {
              const d = project.data;
              const image = imageFor(d);
              return (
                <article class="project-card">
                  <a class="project-image" href={`/du-an/${project.id}/`} aria-label={`Xem dự án ${d.title}`}>
                    {image ? <img src={image} alt={`Hình ảnh dự án ${d.title}`} loading="lazy" /> : <div class="image-placeholder" aria-hidden="true">DỰ ÁN ĐÀ NẴNG</div>}
                  </a>
                  <div class="project-body">
                    <h3><a href={`/du-an/${project.id}/`}>{d.title}</a></h3>
                    {summary(d) && <p class="project-summary">{summary(d)}</p>}
                    <a class="detail-link" href={`/du-an/${project.id}/`}>Khám phá dự án <span aria-hidden="true">→</span></a>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="empty-state"><h2>Đang cập nhật dự án</h2><p>Thông tin dự án sẽ được cập nhật từ hệ thống quản trị nội dung.</p></div>
        )}
      </div>
    </section>
    <section class="project-contact"><div class="project-container contact-inner"><div><h2>Cần tư vấn dự án tại Đà Nẵng?</h2><p>Liên hệ để được hỗ trợ tìm hiểu thông tin và sản phẩm phù hợp.</p></div><a href="tel:0869437415">Gọi 0869 437 415</a></div></section>
  </main>
</Base>

<style>
  .project-container{width:min(1200px,calc(100% - 40px));margin:0 auto}
  .project-hero{background:linear-gradient(120deg,#102c49,#245679);color:#fff;padding:48px 0 65px}
  .breadcrumb{display:flex;align-items:center;gap:10px;font-size:13px;margin-bottom:35px;color:#e3edf5}
  .breadcrumb a{color:inherit;text-decoration:none}.breadcrumb a:hover{text-decoration:underline}
  .eyebrow{font-size:12px;font-weight:800;letter-spacing:1.5px;margin:0 0 12px;color:#c9a064}
  .project-hero h1{font-size:clamp(30px,4vw,48px);line-height:1.2;margin:0 0 18px}
  .project-hero>div>p:last-child{max-width:740px;color:#e3edf5;line-height:1.8;margin:0}
  .project-section{padding:58px 0 75px;background:#f6f8fb}
  .section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:26px}
  .section-heading h2{font-size:clamp(24px,3vw,32px);color:#173a58;margin:0}
  .count{color:#62778b;font-size:14px;white-space:nowrap}
  .project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
  .project-card{overflow:hidden;border:1px solid #e1e7ed;border-radius:15px;background:#fff;box-shadow:0 8px 25px #102c490d;display:flex;flex-direction:column}
  .project-image{height:220px;display:block;overflow:hidden;background:#dbe6ee}
  .project-image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s}
  .project-image:hover img{transform:scale(1.04)}
  .image-placeholder{height:100%;display:grid;place-items:center;background:linear-gradient(135deg,#d8e4ed,#a9c1d2);color:#244e70;font-size:14px;font-weight:800;letter-spacing:1px}
  .project-body{padding:23px;display:flex;flex-direction:column;flex:1}
  .project-body h3{font-size:21px;line-height:1.4;margin:0 0 12px}
  .project-body h3 a{color:#153d61;text-decoration:none}.project-body h3 a:hover{color:#b58642}
  .project-summary{color:#596e80;line-height:1.7;font-size:14px;margin:0 0 22px;flex:1}
  .detail-link{margin-top:auto;color:#a77630;font-weight:800;text-decoration:none;font-size:14px}
  .detail-link:hover{text-decoration:underline}
  .empty-state{padding:50px 24px;border-radius:15px;text-align:center;background:#fff;border:1px solid #e1e7ed}
  .empty-state h2{color:#173a58}.empty-state p{color:#62778b}
  .project-contact{background:#102c49;color:#fff;padding:35px 0}
  .contact-inner{display:flex;align-items:center;justify-content:space-between;gap:25px}
  .contact-inner h2{font-size:24px;margin:0 0 8px}.contact-inner p{color:#d4e2ee;margin:0}
  .contact-inner>a{display:inline-block;background:#c99b56;color:#fff;padding:14px 22px;border-radius:9px;font-weight:800;text-decoration:none;white-space:nowrap}
  @media(max-width:900px){.project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.project-container{width:min(100% - 28px,1200px)}.project-hero{padding:30px 0 45px}.breadcrumb{margin-bottom:25px}.project-section{padding:38px 0 50px}.project-grid{grid-template-columns:1fr;gap:18px}.project-image{height:210px}.section-heading{align-items:start}.contact-inner{flex-direction:column;align-items:start}.contact-inner>a{width:100%;text-align:center}}
</style>
