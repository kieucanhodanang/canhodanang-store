---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('du-an');
  return projects
    .filter((entry) => entry.data.status !== 'draft')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const project = entry.data;
const { Content } = await render(entry);
const apartments = (await getCollection('can-ho'))
  .filter((item) => item.data.status !== 'draft' && item.data.project === entry.id)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));

const siteUrl = 'https://canhodanang.store';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const toAbsolute = (path: string) => new URL(path, siteUrl).href;
const images = [...new Set([project.image, ...(project.gallery ?? [])].filter((value): value is string => Boolean(value)))];
const description = project.description || `Thông tin dự án ${project.title} tại ${project.location}.`;
const seoTitle = project.seoTitle || project.title;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Place',
      '@id': `${pageUrl}#project`,
      name: project.title,
      description,
      url: pageUrl,
      ...(images.length ? { image: images.map(toAbsolute) } : {}),
      address: { '@type': 'PostalAddress', streetAddress: project.location, addressCountry: 'VN' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Dự án', item: `${siteUrl}/du-an/` },
        { '@type': 'ListItem', position: 3, name: project.title, item: pageUrl },
      ],
    },
  ],
};
const apartmentLabel = (transaction: string) => transaction === 'cho-thue-ngay'
  ? 'Cho thuê theo ngày'
  : transaction === 'cho-thue' ? 'Cho thuê dài hạn' : 'Bán căn hộ';
---
<Base title={seoTitle} description={description} image={project.image} imageAlt={project.imageAlt || project.title}>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <main class="project-page">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a><span aria-hidden="true">/</span>
        <a href="/du-an/">Dự án</a><span aria-hidden="true">/</span>
        <span aria-current="page">{project.title}</span>
      </nav>

      <header class="project-header">
        <p class="eyebrow">Thông tin dự án bất động sản</p>
        <h1>{project.title}</h1>
        <p class="location">📍 {project.location}</p>
        {project.developer && <p class="meta"><strong>Chủ đầu tư:</strong> {project.developer}</p>}
        {project.propertyTypes?.length > 0 && <p class="meta"><strong>Loại hình:</strong> {project.propertyTypes.join(', ')}</p>}
      </header>

      {images.length > 0 && (
        <section class="gallery" aria-label={`Hình ảnh dự án ${project.title}`}>
          {images.map((image, index) => (
            <img src={image} alt={index === 0 ? (project.imageAlt || project.title) : `${project.title} - hình ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
          ))}
        </section>
      )}

      <section class="content-section">
        <h2>Tổng quan dự án {project.title}</h2>
        <p class="summary">{description}</p>
        <div class="article"><Content /></div>
      </section>

      <section class="apartments" aria-labelledby="apartment-heading">
        <div class="section-head">
          <h2 id="apartment-heading">Căn hộ thuộc dự án {project.title}</h2>
          <p>{apartments.length ? `${apartments.length} tin đăng liên quan` : 'Thông tin căn hộ sẽ được cập nhật khi có tin đăng.'}</p>
        </div>
        {apartments.length > 0 && (
          <div class="cards">
            {apartments.map((item) => (
              <a class="card" href={`/can-ho/${item.id}/`}>
                {item.data.image && <img src={item.data.image} alt={item.data.imageAlt || item.data.title} loading="lazy" decoding="async" />}
                <div class="card-body">
                  <span class="type">{apartmentLabel(item.data.transaction)}</span>
                  <h3>{item.data.title}</h3>
                  <p class="price">{item.data.price}</p>
                  <p class="details">{item.data.area}{item.data.bedrooms != null ? ` · ${item.data.bedrooms} phòng ngủ` : ''}</p>
                  <span class="detail-link">Xem chi tiết →</span>
                </div>
              </a>
            ))}
          </div>
        )}
      </section>

      <section class="contact">
        <div>
          <h2>Tư vấn dự án {project.title}</h2>
          <p>Liên hệ để nhận thông tin và danh sách sản phẩm mới nhất.</p>
        </div>
        <div class="actions">
          <a class="call" href="tel:0869437415">Gọi 0869 437 415</a>
          <a class="zalo" href="https://zalo.me/0869437415" target="_blank" rel="noopener noreferrer">Tư vấn qua Zalo</a>
        </div>
      </section>
    </div>
  </main>
  <style>
    .project-page{background:#f5f8fb;color:#19334d;padding:28px 0 65px}.wrap{max-width:1160px;margin:0 auto;padding:0 20px}
    .breadcrumbs{display:flex;flex-wrap:wrap;gap:9px;font-size:13px;color:#68798a;margin-bottom:24px;overflow-wrap:anywhere}.breadcrumbs a{color:#1a5d8c}
    .project-header{margin-bottom:24px}.eyebrow{color:#996e2d;font-weight:700;text-transform:uppercase;font-size:13px;letter-spacing:.04em;margin:0 0 8px}
    h1{font-size:clamp(27px,4vw,42px);line-height:1.25;margin:0 0 12px}h2{font-size:clamp(21px,3vw,28px);line-height:1.35;margin:0 0 15px}
    .location{color:#526c83;margin:0 0 10px}.meta{margin:5px 0;color:#526c83}
    .gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:25px 0}.gallery img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:12px;background:#e5edf3}.gallery img:first-child{grid-column:span 2;grid-row:span 2;height:100%}
    .content-section,.apartments{background:#fff;border:1px solid #e6edf2;border-radius:16px;padding:26px;margin:25px 0}
    .summary{line-height:1.75;color:#526c83}.article{line-height:1.85;overflow-wrap:anywhere}.article :global(img){max-width:100%;height:auto;border-radius:10px}.article :global(a){color:#1768a0;text-decoration:underline}
    .section-head p{color:#62788b;margin:0 0 20px}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
    .card{display:block;color:inherit;text-decoration:none;border:1px solid #e6edf2;border-radius:12px;overflow:hidden;background:#fff;transition:box-shadow .2s}.card:hover{box-shadow:0 6px 22px #153a5c1c}.card img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block}.card-body{padding:16px}.type{font-size:12px;color:#996e2d;font-weight:700}.card h3{font-size:17px;line-height:1.4;margin:7px 0}.price{font-weight:700;color:#bc5034;margin:8px 0}.details{font-size:13px;color:#62788b}.detail-link{font-size:13px;color:#1768a0;font-weight:700}
    .contact{display:flex;justify-content:space-between;align-items:center;gap:20px;background:#e9f2f9;border-radius:16px;padding:24px;margin-top:25px}.contact h2{margin-bottom:6px}.contact p{margin:0;color:#526c83}.actions{display:flex;flex-wrap:wrap;gap:10px}.actions a{padding:12px 16px;border-radius:9px;text-decoration:none;font-weight:700;white-space:nowrap}.call{background:#1768a0;color:#fff}.zalo{background:#fff;color:#1768a0;border:1px solid #1768a0}
    @media(max-width:767px){.wrap{padding:0 14px}.gallery{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.gallery img:first-child{grid-column:span 2;grid-row:auto;height:auto;aspect-ratio:16/9}.content-section,.apartments{padding:18px}.cards{grid-template-columns:1fr}.contact{flex-direction:column;align-items:flex-start}.actions{width:100%}.actions a{flex:1;text-align:center}}
  </style>
</Base>
