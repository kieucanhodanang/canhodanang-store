---
import Base from '../../layouts/Base.astro';
import { formatListingPrice } from '../../utils/formatListingPrice';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('du-an');
  return projects.filter((entry) => entry.data.status === 'published')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
// Gộp căn hộ và nhà đất thổ cư thuộc dự án, tránh hiển thị trùng.
const groups = await Promise.all([
  getCollection('can-ho'),
  getCollection('nha-dat-tho-cu'),
]);
const linkedProperties = groups.flatMap((entries, groupIndex) =>
  entries.filter(item => item.data.status !== 'draft'
    && item.data.listingStatus === 'available'
    && item.data.project === entry.id)
    .map(item => ({
      id: item.id,
      data: item.data,
      href: groupIndex === 0 ? `/can-ho/${item.id}/` : `/nha-dat-tho-cu/${item.id}/`,
    }))
);
const properties = linkedProperties;
const isHaiVanBay = entry.id === 'vinhomes-hai-van-bay';
const haiVanZoneImages = data.haiVanZoneImages;
const haiVanZoneImage = (zone: string): string | undefined => {
  const key = ({
    'tinh-van': 'tinhVan',
    'bach-van': 'bachVan',
    'dao-ngoc': 'daoNgoc',
    'vinh-may': 'vinhMay',
  } as Record<string, keyof NonNullable<typeof haiVanZoneImages>>)[zone];
  return key ? haiVanZoneImages?.[key] ?? undefined : undefined;
};
const haiVanZones = [
  { value: 'tinh-van', label: 'Tinh Vân' },
  { value: 'bach-van', label: 'Bạch Vân' },
  { value: 'dao-ngoc', label: 'Đảo Ngọc' },
  { value: 'vinh-may', label: 'Vịnh Mây' },
];
const haiVanTypes = [
  { value: 'biet-thu-don-lap', label: 'Biệt thự đơn lập' },
  { value: 'biet-thu-song-lap', label: 'Biệt thự song lập' },
  { value: 'biet-thu-lien-ke', label: 'Biệt thự liền kề' },
  { value: 'shophouse', label: 'Shophouse' },
  { value: 'can-ho-cao-tang', label: 'Căn hộ cao tầng' },
  { value: 'resort', label: 'Resort' },
];
const haiVanLabel = (options: {value:string;label:string}[], value?: string | null) =>
  options.find(option => option.value === value)?.label || '';

const propertyCategory = (item: (typeof properties)[number]) => {
  const type = String('propertyType' in item.data ? item.data.propertyType || '' : '')
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  if (/shophouse|shop house|nha pho thuong mai/.test(type)) return 'shophouse';
  if (/biet thu|villa/.test(type)) return 'villa';
  return 'other';
};
const forSale = properties.filter(item => item.data.transaction === 'ban');
const forRent = properties.filter(item => item.data.transaction !== 'ban');
const saleVillas = forSale.filter(item => propertyCategory(item) === 'villa');
const saleShophouses = forSale.filter(item => propertyCategory(item) === 'shophouse');
const saleOther = forSale.filter(item => propertyCategory(item) === 'other');
const rentVillas = forRent.filter(item => propertyCategory(item) === 'villa');
const rentShophouses = forRent.filter(item => propertyCategory(item) === 'shophouse');
const rentOther = forRent.filter(item => propertyCategory(item) === 'other');
const extra = data as typeof data & {
  district?: string; totalArea?: string; towerCount?: string | number;
  unitCount?: string | number; handoverDate?: string; buildingDensity?: string;
  floorPlanText?: string; floorPlanImages?: string[];
  progressText?: string; progressItems?: { title?: string; image?: string; videoUrl?: string; videoFile?: string; description?: string }[];
};
// Hiển thị liên kết Markdown an toàn trong hai trường mô tả dự án từ CMS.
const escapeHtml = (value: string) => value.replace(/&/g, '&amp;').replace(/</g, '&lt;')
  .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
const renderProjectText = (value?: string) => {
  if (!value) return '';
  const source = String(value).replace(/\r\n?/g, '\n');
  const renderLine = (line: string) => {
    const pattern = /\[([^\]\n]+)\]\(([^\s)]+)\)/g;
    let html = '', cursor = 0;
    for (const match of line.matchAll(pattern)) {
      const index = match.index ?? 0;
      html += escapeHtml(line.slice(cursor, index));
      const label = escapeHtml(match[1]);
      const url = match[2].trim();
      if (/^(https?:\/\/|\/(?!\/))/.test(url)) {
        html += `<a href="${escapeHtml(url)}">${label}</a>`;
      } else {
        html += escapeHtml(match[0]);
      }
      cursor = index + match[0].length;
    }
    return html + escapeHtml(line.slice(cursor));
  };
  return source.split(/\n\s*\n/).map(paragraph =>
    `<p>${paragraph.split('\n').map(renderLine).join('<br />')}</p>`
  ).join('');
};
const detailRows = [
  ['Tên gọi', data.title], ['Chủ đầu tư', data.developer],
  ['Diện tích', extra.totalArea], ['Vị trí', data.location],
  ['Số tòa', extra.towerCount], ['Số căn hộ / biệt thự', extra.unitCount],
  ['Bàn giao dự kiến', extra.handoverDate], ['Mật độ xây dựng', extra.buildingDensity],
].filter((row) => row[1] !== undefined && row[1] !== null && String(row[1]).trim() !== '');
const normalizeDistrict = (value: unknown) => String(value || '').normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D')
  .toLowerCase().replace(/^(quan|huyen|thi xa)\s+/, '').trim();
const districtNames = ['Hải Châu', 'Sơn Trà', 'Ngũ Hành Sơn', 'Thanh Khê', 'Liên Chiểu', 'Cẩm Lệ', 'Hòa Vang'];
const district = extra.district || districtNames.find(name =>
  normalizeDistrict(data.location).includes(normalizeDistrict(name))) || '';
const relatedProjects = (await getCollection('du-an'))
  .filter(item => item.id !== entry.id && item.data.status === 'published' && district
    && normalizeDistrict((item.data as typeof item.data & {district?:string}).district ||
      districtNames.find(name => normalizeDistrict(item.data.location).includes(normalizeDistrict(name))))
       === normalizeDistrict(district)).slice(0, 6);
const relatedNews = (await getCollection('bai-viet'))
  .filter(item => item.data.status !== 'draft'
    && (item.data as typeof item.data & { project?: string }).project === entry.id)
  .sort((a,b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 6);
const youtubeEmbed = (url: string) => {
  try {
    const parsed = new URL(url);
    const host = parsed.hostname.replace(/^www\./, '');
    let id = '';
    if (host === 'youtu.be') id = parsed.pathname.slice(1).split('/')[0];
    if (host === 'youtube.com' || host === 'm.youtube.com') {
      id = parsed.pathname.startsWith('/shorts/') || parsed.pathname.startsWith('/embed/')
        ? parsed.pathname.split('/')[2] : parsed.searchParams.get('v') || '';
    }
    return /^[a-zA-Z0-9_-]{11}$/.test(id) ? `https://www.youtube-nocookie.com/embed/${id}` : '';
  } catch { return ''; }
};
const siteUrl = 'https://canhodanang.store';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const toAbsolute = (value: string) => new URL(value, siteUrl).href;
const images = [...new Set([data.image, ...(data.gallery ?? [])]
  .filter((value): value is string => typeof value === 'string' && value.trim().length > 0))].map(toAbsolute);
const description = data.description || `Thông tin dự án ${data.title}${data.location ? ` tại ${data.location}` : ''}. Liên hệ 0869 437 415 để được tư vấn.`;
// SEO động dùng chung: ưu tiên thông tin CMS, nếu trống thì tạo từ dữ liệu dự án.
const projectSeo = data as typeof data & { seoDescription?: string };
const seoTitle = data.seoTitle?.trim() || `${data.title}${data.location ? ` | ${data.location}` : ' | Đà Nẵng'}`;
const seoDescription = projectSeo.seoDescription?.trim()
  || `Khám phá dự án ${data.title}${data.location ? ` tại ${data.location}` : ' tại Đà Nẵng'}. Xem vị trí, thông tin dự án và sản phẩm liên quan. Liên hệ 0869 437 415.`;
const formatArea = (area: string | number | undefined) => {
  if (area === undefined || area === null || String(area).trim() === '') return '';
  const value = String(area).trim();
  return /(?:m²|m2|m\s*\^\s*2|mét vuông)/i.test(value) ? value : `${value} m²`;
};
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Place',
      '@id': `${pageUrl}#project`,
      name: data.title,
      description,
      url: pageUrl,
      ...(images.length ? { image: images } : {}),
      ...(data.location ? { address: { '@type': 'PostalAddress', streetAddress: data.location, addressCountry: 'VN' } } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Dự án', item: `${siteUrl}/du-an/` },
        { '@type': 'ListItem', position: 3, name: data.title, item: pageUrl },
      ],
    },
  ],
};
---
<Base title={seoTitle} description={seoDescription} image={data.image || undefined} imageAlt={data.imageAlt || data.title}>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <main class="project-page">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a><span aria-hidden="true">/</span>
        <a href="/du-an/">Dự án</a><span aria-hidden="true">/</span>
        <span aria-current="page">{data.title}</span>
      </nav>

      <header class="heading">
        <span class="eyebrow">THÔNG TIN DỰ ÁN</span>
        <h1>{data.title}</h1>
        {data.location && <p class="location">📍 {data.location}</p>}
        <p class="intro">{description}</p>
        {data.developer && <p class="developer">Chủ đầu tư: <strong>{data.developer}</strong></p>}
      </header>

      {data.image && <img class="cover" src={data.image} alt={data.imageAlt || data.title} loading="eager" />}
      {data.gallery && data.gallery.length > 0 && (
        <section class="gallery" aria-label="Hình ảnh dự án">
          {data.gallery.filter(Boolean).map((image, index) => (
            <img src={image} alt={`${data.title} - hình ${index + 1}`} loading="lazy" />
          ))}
        </section>
      )}

      <section class="description" aria-label="Giới thiệu và thông tin chi tiết dự án">
        <div class="article-content" id="project-detail-content">
          <Content />
        </div>
        <button type="button" class="project-read-more" id="project-read-more" aria-controls="project-detail-content" aria-expanded="false" hidden>
          <span class="project-read-more-label">Xem thêm</span>
          <svg class="project-read-more-icon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
      </section>

      <section class="description" aria-label="Thông số chi tiết dự án">
        <h2>Thông số chi tiết dự án {data.title}</h2>
        <dl class="spec-grid">
          {detailRows.map(([label, value]) => (
            <div class="spec-item"><dt>◈ {label}</dt><dd>{String(value)}</dd></div>
          ))}
        </dl>
      </section>

      {isHaiVanBay && (
        <section class="listings hai-van-products" id="san-pham-hai-van">
          <h2>Khám phá 4 phân khu Vinhomes Hải Vân Bay</h2>
          <div class="hai-van-zones">
            {haiVanZones.map(zone => (
              <button type="button" class:list={['hai-van-zone', { 'has-image': Boolean(haiVanZoneImage(zone.value)) }]} data-zone-choice={zone.value} aria-pressed="false">
                {haiVanZoneImage(zone.value) && <img class="hai-van-zone-image" src={haiVanZoneImage(zone.value)} alt={`Phân khu ${zone.label} - Vinhomes Hải Vân Bay`} loading="lazy" />}
                <span class="hai-van-zone-info">
                  <span class="hai-van-zone-name">{zone.label}</span>
                  <span class="hai-van-zone-count">{properties.filter(item => item.data.subdivision === zone.value).length} sản phẩm</span>
                </span>
              </button>
            ))}
          </div>
          <h2 class="hai-van-list-title">Bất động sản tại Vinhomes Hải Vân Bay</h2>
          <div class="hai-van-filters">
            <label>Phân khu
              <select id="hai-van-zone-filter" aria-label="Lọc theo phân khu">
                <option value="">Tất cả phân khu</option>
                {haiVanZones.map(zone => <option value={zone.value}>{zone.label}</option>)}
              </select>
            </label>
            <label>Loại hình
              <select id="hai-van-type-filter" aria-label="Lọc theo loại hình">
                <option value="">Tất cả loại hình</option>
                {haiVanTypes.map(type => <option value={type.value}>{type.label}</option>)}
              </select>
            </label>
            <button type="button" id="hai-van-clear-filter" class="hai-van-reset">Xóa bộ lọc</button>
          </div>
          <p id="hai-van-result-count" class="hai-van-result" aria-live="polite"></p>
          <div class="cards" id="hai-van-cards">
            {properties.map(item => (
              <a class="card property-card hai-van-card" href={item.href}
                data-zone={item.data.subdivision || ''} data-type={item.data.projectPropertyType || ''}>
                <div class="hai-van-image">
                  {item.data.image && <img src={item.data.image} alt={item.data.imageAlt || item.data.title} loading="lazy" />}
                  <div class="hai-van-badges">
                    {haiVanLabel(haiVanTypes, item.data.projectPropertyType) && <span class="hai-van-badge type">{haiVanLabel(haiVanTypes, item.data.projectPropertyType)}</span>}
                    {haiVanLabel(haiVanZones, item.data.subdivision) && <span class="hai-van-badge zone">{haiVanLabel(haiVanZones, item.data.subdivision)}</span>}
                  </div>
                </div>
                <div class="card-body">
                  <h3>{item.data.title}</h3>
                  {item.data.productCode && <p class="hai-van-code">Mã: {item.data.productCode}</p>}
                  <div class="card-info-row">
                    {item.data.price && <strong class="apartment-price">{formatListingPrice(item.data.price, item.data.transaction, item.data.priceValue)}</strong>}
                    {formatArea(item.data.area) && <span class="apartment-detail">{formatArea(item.data.area)}</span>}
                    {item.data.bedrooms != null && <span class="apartment-detail">{item.data.bedrooms} PN</span>}
                  </div>
                </div>
              </a>
            ))}
          </div>
          <p id="hai-van-no-results" class="empty" hidden>Chưa có bất động sản phù hợp với bộ lọc.</p>
          <button type="button" class="project-read-more" id="hai-van-more" hidden>Xem thêm sản phẩm</button>
        </section>
      )}

      {!isHaiVanBay && [
        { id: 'villa-sale', heading: `Biệt thự đang bán tại ${data.title}`, items: saleVillas },
        { id: 'shophouse-sale', heading: `Shophouse đang bán tại ${data.title}`, items: saleShophouses },
        { id: 'other-sale', heading: `Căn hộ và bất động sản khác đang bán tại ${data.title}`, items: saleOther },
        { id: 'villa-rent', heading: `Biệt thự cho thuê tại ${data.title}`, items: rentVillas },
        { id: 'shophouse-rent', heading: `Shophouse cho thuê tại ${data.title}`, items: rentShophouses },
        { id: 'other-rent', heading: `Căn hộ và bất động sản khác cho thuê tại ${data.title}`, items: rentOther },
      ].filter(group => group.items.length > 0).map(group => (
        <section class="listings property-list" data-property-list>
          <h2>{group.heading}</h2>
          {group.items.length ? (
            <>
              <div class="cards">
                {group.items.map((item, index) => (
                  <a class="card property-card" href={item.href} data-card-index={index}>
                    {item.data.image && <img src={item.data.image} alt={item.data.imageAlt || item.data.title} loading="lazy" />}
                    <div class="card-body">
                      <h3>{item.data.title}</h3>
                      <p class="property-action">{item.href === '#lien-he-du-an' ? 'Liên hệ tư vấn sản phẩm →' : 'Xem chi tiết bất động sản →'}</p>
                      <div class="card-info-row">
                        {item.data.price && <strong class="apartment-price">{formatListingPrice(item.data.price, item.data.transaction, item.data.priceValue)}</strong>}
                        {formatArea(item.data.area) && <span class="apartment-detail">{formatArea(item.data.area)}</span>}
                        {item.data.bedrooms != null && <span class="apartment-detail">{item.data.bedrooms} PN</span>}
                      </div>
                    </div>
                  </a>
                ))}
              </div>
              <button class="project-read-more property-more" type="button" hidden aria-label={`Xem thêm bất động sản ${group.id}`}>
                <span>Xem thêm</span><svg class="project-read-more-icon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
            </>
          ) : <p class="empty">Hiện chưa có bất động sản phù hợp được đăng trong dự án này.</p>}
        </section>
      ))}

      <section class="description">
        <h2>Mặt bằng dự án {data.title}</h2>
        {extra.floorPlanText && <div class="section-copy project-markdown" set:html={renderProjectText(extra.floorPlanText)} />}
        {extra.floorPlanImages?.length ? <>
          <div class="floor-plan-gallery">{extra.floorPlanImages.filter(Boolean).map((image, index) => (
            <button class="floor-plan-open" type="button" data-floor-plan-src={image} data-floor-plan-alt={`Mặt bằng ${data.title} - ảnh ${index + 1}`} aria-label={`Phóng to mặt bằng ${data.title} - ảnh ${index + 1}`}>
              <img src={image} alt={`Mặt bằng ${data.title} - ảnh ${index + 1}`} loading="lazy" />
              <span class="floor-plan-zoom">⛶ Phóng to ảnh</span>
            </button>
          ))}</div>
          <dialog class="floor-plan-dialog" aria-label="Xem mặt bằng dự án phóng to">
            <button type="button" class="floor-plan-close" aria-label="Đóng ảnh phóng to">×</button>
            <img class="floor-plan-full-image" alt="" />
          </dialog>
        </> : (!extra.floorPlanText?.trim() && <p class="empty">Thông tin mặt bằng đang được cập nhật.</p>)}
      </section>

      <section class="description">
        <h2>Tiến độ dự án {data.title}</h2>
        {extra.progressText && <div class="section-copy project-markdown" set:html={renderProjectText(extra.progressText)} />}
        {extra.progressItems?.length ? extra.progressItems.map((item, index) => (
          <article class="progress-item">
            <h3>{item.title || `Cập nhật tiến độ ${data.title} - ${index + 1}`}</h3>
            {item.description && <p>{item.description}</p>}
            {item.image && <img src={item.image} alt={item.title || `Tiến độ ${data.title}`} loading="lazy" />}
            {item.videoUrl && youtubeEmbed(item.videoUrl) && <iframe src={youtubeEmbed(item.videoUrl)} title={item.title || `Video tiến độ ${data.title}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>}
            {item.videoFile && <video controls preload="metadata" playsinline src={item.videoFile}></video>}
          </article>
        )) : (!extra.progressText?.trim() && <p class="empty">Tiến độ dự án đang được cập nhật.</p>)}
      </section>

      {relatedNews.length > 0 && <section class="listings">
        <h2>Tin tức về dự án {data.title}</h2>
        <div class="cards">
          {relatedNews.map(item => <a class="card" href={`/tin-tuc/${item.id}/`}>
            {item.data.image && <img src={item.data.image} alt={item.data.imageAlt || item.data.title} loading="lazy" />}
            <div class="card-body"><h3>{item.data.title}</h3><p class="empty">Đọc bài viết chi tiết</p></div>
          </a>)}
        </div>
      </section>}

      {relatedProjects.length > 0 && <section class="listings">
        <h2>Dự án liên quan</h2>
        <div class="cards">
          {relatedProjects.map(item => <a class="card" href={`/du-an/${item.id}/`}>
            {item.data.image && <img src={item.data.image} alt={item.data.imageAlt || item.data.title} loading="lazy" />}
            <div class="card-body"><h3>{item.data.title}</h3><p class="empty">{item.data.location}</p></div>
          </a>)}
        </div>
      </section>}

      <div class="contact" id="lien-he-du-an">
        <a href="tel:0869437415">Gọi tư vấn: 0869 437 415</a>
        <a href="https://zalo.me/0869437415" target="_blank" rel="noopener noreferrer">Liên hệ Zalo</a>
      </div>
    </div>
  </main>
  <script is:inline>
    (() => {
      const content = document.getElementById('project-detail-content');
      const button = document.getElementById('project-read-more');
      if (content && button && content.scrollHeight > 344) {
      const collapsedHeight = 320;
      content.classList.add('is-collapsed');
      button.hidden = false;
      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        content.classList.toggle('is-collapsed', expanded);
        button.querySelector('.project-read-more-label').textContent = expanded ? 'Xem thêm' : 'Thu gọn';
        if (expanded) content.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      });
      }
      const floorPlanDialog = document.querySelector('.floor-plan-dialog');
      if (floorPlanDialog) {
        const fullImage = floorPlanDialog.querySelector('.floor-plan-full-image');
        document.querySelectorAll('.floor-plan-open').forEach(button => button.addEventListener('click', () => {
          fullImage.src = button.dataset.floorPlanSrc;
          fullImage.alt = button.dataset.floorPlanAlt || 'Mặt bằng dự án';
          floorPlanDialog.showModal();
        }));
        floorPlanDialog.querySelector('.floor-plan-close').addEventListener('click', () => floorPlanDialog.close());
        floorPlanDialog.addEventListener('click', event => { if (event.target === floorPlanDialog) floorPlanDialog.close(); });
        floorPlanDialog.addEventListener('close', () => { fullImage.removeAttribute('src'); });
      }
      const haiVanCards = document.querySelectorAll('#hai-van-cards .hai-van-card');
      const zoneFilter = document.getElementById('hai-van-zone-filter');
      const typeFilter = document.getElementById('hai-van-type-filter');
      if (zoneFilter && typeFilter) {
        const more = document.getElementById('hai-van-more');
        const count = document.getElementById('hai-van-result-count');
        const empty = document.getElementById('hai-van-no-results');
        let limit = window.matchMedia('(max-width: 767px)').matches ? 3 : 6;
        const update = () => {
          const matched = Array.from(haiVanCards).filter(card =>
            (!zoneFilter.value || card.dataset.zone === zoneFilter.value) &&
            (!typeFilter.value || card.dataset.type === typeFilter.value));
          haiVanCards.forEach(card => { card.hidden = true; });
          matched.slice(0, limit).forEach(card => { card.hidden = false; });
          count.textContent = matched.length + ' sản phẩm phù hợp';
          empty.hidden = matched.length !== 0;
          more.hidden = matched.length <= limit;
          document.querySelectorAll('[data-zone-choice]').forEach(button => {
            button.setAttribute('aria-pressed', String(button.dataset.zoneChoice === zoneFilter.value));
          });
        };
        zoneFilter.addEventListener('change', () => { limit = 6; update(); });
        typeFilter.addEventListener('change', () => { limit = 6; update(); });
        document.querySelectorAll('[data-zone-choice]').forEach(button => button.addEventListener('click', () => {
          zoneFilter.value = zoneFilter.value === button.dataset.zoneChoice ? '' : button.dataset.zoneChoice;
          limit = 6; update();
          document.getElementById('hai-van-result-count').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }));
        document.getElementById('hai-van-clear-filter').addEventListener('click', () => {
          zoneFilter.value = ''; typeFilter.value = ''; limit = 6; update();
        });
        more.addEventListener('click', () => { limit += 6; update(); });
        update();
      }
      document.querySelectorAll('[data-property-list]').forEach(section => {
        const cards = Array.from(section.querySelectorAll('.property-card'));
        const more = section.querySelector('.property-more');
        if (!more) return;
        let visible = window.matchMedia('(max-width: 767px)').matches ? 3 : 6;
        const render = () => {
          cards.forEach((card, index) => { card.hidden = index >= visible; });
          more.hidden = visible >= cards.length;
        };
        more.addEventListener('click', () => { visible += 6; render(); });
        render();
      });
    })();
  </script>
