---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('du-an');
  return projects
    .filter((entry) => entry.data.status !== 'draft')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
const apartments = (await getCollection('can-ho'))
  .filter((item) => item.data.status !== 'draft' && item.data.project === entry.id);
const forSale = apartments.filter((item) => item.data.transaction === 'ban');
const forRent = apartments.filter((item) => item.data.transaction !== 'ban');
const siteUrl = 'https://canhodanang.store';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const toAbsolute = (value: string) => new URL(value, siteUrl).href;
const images = [...new Set([data.image, ...(data.gallery ?? [])].filter((value): value is string => typeof value === 'string' && value.trim().length > 0))].map(toAbsolute);
const description = data.description || `Thông tin dự án ${data.title} tại ${data.location}. Liên hệ 0869 437 415 để được tư vấn.`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Place',
      '@id': `${pageUrl}#project`,
      name: data.title,
      description,
      url: pageUrl,
      ...(images.length ? { image: images } : {}),
      ...(data.location ? { address: { '@type': 'PostalAddress', streetAddress: data.location, addressCountry: 'VN' } } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Dự án', item: `${siteUrl}/du-an/` },
        { '@type': 'ListItem', position: 3, name: data.title, item: pageUrl },
      ],
    },
  ],
};
---
<Base title={data.seoTitle || data.title} description={description} image={data.image || undefined} imageAlt={data.imageAlt || data.title}>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <main class="project-page">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a><span aria-hidden="true">/</span>
        <a href="/du-an/">Dự án</a><span aria-hidden="true">/</span>
        <span aria-current="page">{data.title}</span>
      </nav>
      <header class="heading">
        <span class="eyebrow">THÔNG TIN DỰ ÁN</span>
        <h1>{data.title}</h1>
        <p class="location">{data.location}</p>
        {data.developer && <p>Chủ đầu tư: <strong>{data.developer}</strong></p>}
      </header>
      {data.image && <img class="cover" src={data.image} alt={data.imageAlt || data.title} loading="eager" />}
      {data.gallery && data.gallery.length > 0 && (
        <section class="gallery" aria-label="Hình ảnh dự án">
          {data.gallery.filter(Boolean).map((image, index) => <img src={image} alt={`${data.title} - hình ${index + 1}`} loading="lazy" />)}
        </section>
      )}
      <section class="description">
        <h2>Tổng quan dự án {data.title}</h2>
        <Content />
      </section>
      <section class="listings">
        <h2>Căn hộ đang bán tại {data.title}</h2>
        {forSale.length > 0 ? <div class="cards">{forSale.map((item) => <a class="card" href={`/can-ho/${item.id}/`}>
          {item.data.image && <img src={item.data.image} alt={item.data.imageAlt || item.data.title} loading="lazy" />}
          <div class="card-body"><h3>{item.data.title}</h3><p>{item.data.area} m² · {item.data.price}</p></div>
        </a>)}</div> : <p>Hiện chưa có căn hộ bán được đăng trong dự án này.</p>}
      </section>
      <section class="listings">
        <h2>Căn hộ cho thuê tại {data.title}</h2>
        {forRent.length > 0 ? <div class="cards">{forRent.map((item) => <a class="card" href={`/can-ho/${item.id}/`}>
          {item.data.image && <img src={item.data.image} alt={item.data.imageAlt || item.data.title} loading="lazy" />}
          <div class="card-body"><h3>{item.data.title}</h3><p>{item.data.area} m² · {item.data.price}</p></div>
        </a>)}</div> : <p>Hiện chưa có căn hộ cho thuê được đăng trong dự án này.</p>}
      </section>
      <div class="contact"><a href="tel:0869437415">Gọi tư vấn: 0869 437 415</a><a href="https://zalo.me/0869437415" target="_blank" rel="noopener noreferrer">Liên hệ Zalo</a></div>
    </div>
  </main>
  <style>
    .project-page{background:#f5f8fb;color:#19334d;padding:30px 0 65px}.wrap{max-width:1160px;margin:0 auto;padding:0 20px}.breadcrumbs{display:flex;flex-wrap:wrap;gap:9px;font-size:13px;color:#68798a;margin-bottom:20px}.breadcrumbs a{color:#1a5d8c}.heading{margin-bottom:22px}.eyebrow{font-size:13px;font-weight:700;color:#996e2d}.heading h1{font-size:clamp(27px,4vw,40px);margin:8px 0 12px;line-height:1.25}.location{color:#62788b}.cover{width:100%;max-height:540px;object-fit:cover;border-radius:14px}.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:16px}.gallery img{width:100%;height:210px;object-fit:cover;border-radius:10px}.description,.listings{background:white;border-radius:14px;padding:24px;margin-top:24px;overflow-wrap:anywhere}.description h2,.listings h2{font-size:23px;margin:0 0 18px}.description :global(img){max-width:100%;height:auto}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.card{display:block;text-decoration:none;color:inherit;border:1px solid #e0e7ed;border-radius:12px;overflow:hidden}.card img{width:100%;height:180px;object-fit:cover}.card-body{padding:14px}.card h3{font-size:17px;margin:0 0 8px}.card p{color:#62788b;margin:0}.contact{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.contact a{background:#1a5d8c;color:white;padding:12px 18px;border-radius:9px;text-decoration:none;font-weight:700}.contact a+a{background:#167b55}@media(max-width:767px){.wrap{padding:0 14px}.gallery,.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.gallery img{height:130px}.card img{height:135px}.description,.listings{padding:17px}.description h2,.listings h2{font-size:20px}}@media(max-width:440px){.cards{grid-template-columns:1fr}}
  </style>
</Base>
