
---
const projects = [
  {
    name: 'Vinhomes Hải Vân Bay',
    location: 'Khu vực Tây Bắc Đà Nẵng',
    description: 'Thông tin quy hoạch, phân khu, sản phẩm và tiến độ dự án.',
    url: '/du-an/vinhomes-hai-van-bay/'
  },
  {
    name: 'Căn hộ Ngũ Hành Sơn',
    location: 'Ngũ Hành Sơn, Đà Nẵng',
    description: 'Khám phá thị trường căn hộ và các dự án nổi bật.',
    url: '/can-ho/ngu-hanh-son/'
  },
  {
    name: 'Căn hộ Sơn Trà',
    location: 'Sơn Trà, Đà Nẵng',
    description: 'Thông tin căn hộ gần biển và khu vực trung tâm.',
    url: '/can-ho/son-tra/'
  }
];

const title = 'Căn Hộ Đà Nẵng | Thông Tin Dự Án & Bất Động Sản';
const description = 'Cập nhật thông tin căn hộ Đà Nẵng, dự án bất động sản, Vinhomes Hải Vân Bay, quy hoạch và thị trường nhà đất.';
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://canhodanang.store/" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://canhodanang.store/" />
    <style>
      :root {font-family: Arial, sans-serif; color:#172b45}
      * {box-sizing:border-box}
      body {margin:0;background:#f6f8fb;line-height:1.6}
      a {color:inherit;text-decoration:none}
      .container {max-width:1160px;margin:auto;padding:0 20px}
      header {background:white;border-bottom:1px solid #e5e9ef}
      .nav {display:flex;justify-content:space-between;align-items:center;gap:20px;min-height:76px}
      .logo {font-size:24px;font-weight:800;color:#123c68}
      nav {display:flex;gap:24px;flex-wrap:wrap}
      nav a:hover {color:#087db5}
      .hero {background:linear-gradient(120deg,#082a4c,#13658a);color:white;padding:100px 0}
      .hero h1 {font-size:clamp(32px,5vw,54px);line-height:1.2;max-width:850px;margin:0 0 20px}
      .hero p {font-size:19px;max-width:680px;opacity:.94}
      .button {display:inline-block;background:#e9b75c;color:#172b45;padding:13px 25px;border-radius:7px;font-weight:bold;margin-top:15px}
      section {padding:65px 0}
      h2 {font-size:30px;margin:0 0 12px}
      .intro {color:#607086;margin-bottom:30px}
      .grid {display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
      .card {background:white;padding:28px;border:1px solid #e4e9ef;border-radius:12px}
      .card h3 {font-size:22px;margin:10px 0}
      .location {font-size:14px;color:#607086}
      .more {color:#086ca5;font-weight:bold}
      .about {background:white}
      footer {background:#092744;color:white;padding:35px 0}
      @media(max-width:760px){
        .nav {align-items:flex-start;flex-direction:column;padding-top:15px;padding-bottom:15px}
        nav {gap:12px}
        .grid {grid-template-columns:1fr}
        .hero {padding:65px 0}
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container nav">
        <a class="logo" href="/">CĂN HỘ ĐÀ NẴNG</a>
        <nav aria-label="Điều hướng chính">
          <a href="/">Trang chủ</a>
          <a href="#du-an">Dự án</a>
          <a href="#gioi-thieu">Giới thiệu</a>
          <a href="mailto:contact@canhodanang.store">Liên hệ</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="hero">
        <div class="container">
          <h1>Khám phá căn hộ và dự án bất động sản Đà Nẵng</h1>
          <p>
            Thông tin dự án, vị trí, quy hoạch, thị trường
            và những phân tích hữu ích dành cho người mua nhà,
            nhà đầu tư tại Đà Nẵng.
          </p>
          <a class="button" href="#du-an">Khám phá dự án</a>
        </div>
      </div>

      <section id="du-an">
        <div class="container">
          <h2>Dự án & khu vực nổi bật</h2>
          <p class="intro">Khám phá thông tin bất động sản theo dự án và khu vực.</p>
          <div class="grid">
            {projects.map((project) => (
              <article class="card">
                <p class="location">{project.location}</p>
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                <a class="more" href={project.url}>Xem chi tiết →</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="about" id="gioi-thieu">
        <div class="container">
          <h2>Thông tin bất động sản Đà Nẵng</h2>
          <p>
            Canhodanang.store tổng hợp thông tin về căn hộ,
            dự án đô thị, quy hoạch và xu hướng thị trường.
            Nội dung được cập nhật nhằm hỗ trợ người đọc
            tìm hiểu và so sánh các lựa chọn bất động sản.
          </p>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">
        <strong>CANHODANANG.STORE</strong>
        <p>Thông tin căn hộ và dự án bất động sản Đà Nẵng.</p>
        <small>© {new Date().getFullYear()} Căn Hộ Đà Nẵng.</small>
      </div>
    </footer>
  </body>
</html>
