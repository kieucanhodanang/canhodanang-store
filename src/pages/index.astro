
---
import Base from '../layouts/Base.astro';
import homepage from '../data/homepage.json';

const clamp = (value, min, max, fallback) => {
  const n = Number(value);
  return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;
};
const bannerHeight = clamp(homepage.bannerHeight, 350, 850, 610);
const titleSize = clamp(homepage.bannerTitleSize, 32, 80, 56);
const contentWidth = clamp(homepage.bannerContentWidth, 800, 1400, 1200);
const overlay = clamp(homepage.bannerOverlay, 0, 80, 45) / 100;
const imagePosition = ['top', 'center', 'bottom'].includes(homepage.bannerPosition) ? homepage.bannerPosition : 'center';
const textAlign = ['left', 'center', 'right'].includes(homepage.bannerTextAlign) ? homepage.bannerTextAlign : 'left';
const buttonColor = /^#[0-9a-fA-F]{6}$/.test(homepage.primaryButtonColor || '') ? homepage.primaryButtonColor : '#D4A85E';
const bannerImage = typeof homepage.bannerImage === 'string' && homepage.bannerImage.startsWith('/uploads/') ? homepage.bannerImage : '';
const heroBackground = bannerImage
  ? `linear-gradient(rgba(8, 27, 47, ${overlay}), rgba(8, 27, 47, ${overlay})), url(${JSON.stringify(bannerImage)})`
  : 'linear-gradient(125deg, #102c49, #19496a)';

const khuVuc = [
  {
    title: 'Căn hộ Sơn Trà',
    place: 'Sơn Trà, Đà Nẵng',
    summary: 'Tìm hiểu căn hộ tại khu vực Sơn Trà, gần biển và các tiện ích đô thị.',
    href: '/can-ho/son-tra/',
    style: ''
  },
  {
    title: 'Căn hộ Ngũ Hành Sơn',
    place: 'Ngũ Hành Sơn, Đà Nẵng',
    summary: 'Khám phá căn hộ tại Ngũ Hành Sơn, vị trí và những tiêu chí cần lưu ý.',
    href: '/can-ho/ngu-hanh-son/',
    style: 'two'
  },
  {
    title: 'Căn hộ Hải Châu',
    place: 'Hải Châu, Đà Nẵng',
    summary: 'Tìm hiểu căn hộ tại khu vực trung tâm thành phố Đà Nẵng.',
    href: '/can-ho/hai-chau/',
    style: 'three'
  }
];

const duAn = [
  {
    title: 'Capital Square Đà Nẵng',
    place: 'Đà Nẵng',
    summary: 'Tìm hiểu thông tin tổng quan, vị trí và sản phẩm căn hộ thuộc dự án.',
    href: '/du-an/capital-square/',
    tag: 'Dự án căn hộ',
    style: 'two'
  },
  {
    title: 'Vinhomes Hải Vân Bay',
    place: 'Khu vực Tây Bắc Đà Nẵng',
    summary: 'Khám phá thông tin quy hoạch, biệt thự, shophouse và các loại hình thuộc dự án.',
    href: '/du-an/vinhomes-hai-van-bay/',
    tag: 'Biệt thự & Shophouse',
    style: ''
  }
];

const seoTitle =
  'Căn Hộ Đà Nẵng | Mua Bán, Cho Thuê & Dự Án Nổi Bật';

const seoDescription =
  'Khám phá căn hộ Đà Nẵng mua bán, cho thuê, dự án căn hộ nổi bật, vị trí, giá bán và thông tin thị trường. Liên hệ tư vấn 0869 437 415.';
---

<Base title={seoTitle} description={seoDescription}>

  <!-- HERO: H1 DUY NHAT - DU LIEU TU DECAP CMS -->
  <section
    class="hero cms-hero"
    style={`--cms-hero-height:${bannerHeight}px;--cms-title-size:${titleSize}px;--cms-content-width:${contentWidth}px;--cms-text-align:${textAlign};--cms-image-position:${imagePosition};--cms-button-color:${buttonColor};background-image:${heroBackground};`}
  >
    <div class="wrap cms-hero-content">
      {homepage.bannerEyebrow && <span class="eyebrow">{homepage.bannerEyebrow}</span>}
      <h1>{homepage.bannerTitle || 'Căn Hộ Đà Nẵng – Mua Bán, Cho Thuê & Dự Án Nổi Bật'}</h1>
      {homepage.bannerDescription && <p>{homepage.bannerDescription}</p>}
      <div class="heroactions cms-hero-actions">
        {homepage.primaryButtonText && (
          <a class="btn cms-primary-button" href={homepage.primaryButtonLink || '#can-ho-ban'}>
            {homepage.primaryButtonText}
          </a>
        )}
        {homepage.secondaryButtonText && (
          <a class="outlinebtn" href={homepage.secondaryButtonLink || 'tel:0869437415'}>
            {homepage.secondaryButtonText}
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- BO LOC TIM KIEM -->
  <div class="wrap">
    <div class="searchpanel" id="tim-kiem">
      <div class="searchtitle">
        <span class="search-kicker">
          TÌM KIẾM CĂN HỘ ĐÀ NẴNG
        </span>

        <strong>
          Tìm căn hộ theo nhu cầu của bạn
        </strong>
      </div>

      <form action="/tim-kiem/" method="GET" id="property-search">

        <div class="deal-tabs" role="group"
          aria-label="Hình thức giao dịch">

          <label>
            <input type="radio"
              name="giao-dich"
              value="mua" checked />
            <span>⌂ Mua căn hộ</span>
          </label>

          <label>
            <input type="radio"
              name="giao-dich"
              value="thue-dai-han" />
            <span>Thuê dài hạn</span>
          </label>

          <label>
            <input type="radio"
              name="giao-dich"
              value="thue-theo-ngay" />
            <span>Thuê theo ngày</span>
          </label>
        </div>

        <div class="property-fields">

          <label class="keyword-field">
            Dự án / Khu vực
            <input
              name="q"
              placeholder="Tên dự án, khu vực Đà Nẵng..."
            />
          </label>

          <label>
            Phòng ngủ
            <select name="phong-ngu">
              <option value="">Tất cả</option>
              <option value="studio">Studio</option>
              <option value="1">1 phòng ngủ</option>
              <option value="2">2 phòng ngủ</option>
              <option value="3">3 phòng ngủ</option>
              <option value="4">4+ phòng ngủ</option>
            </select>
          </label>

          <label>
            Diện tích
            <select name="dien-tich">
              <option value="">Tất cả</option>
              <option value="0-40">Dưới 40 m²</option>
              <option value="40-60">40–60 m²</option>
              <option value="60-80">60–80 m²</option>
              <option value="80-100">80–100 m²</option>
              <option value="100+">Trên 100 m²</option>
            </select>
          </label>

          <label>
            <span id="price-label">Giá mua</span>
            <select name="gia" id="price-select">
              <option value="">Tất cả mức giá</option>
              <option value="under2">Dưới 2 tỷ</option>
              <option value="2-3">2–3 tỷ</option>
              <option value="3-5">3–5 tỷ</option>
              <option value="5-10">5–10 tỷ</option>
              <option value="10+">Trên 10 tỷ</option>
            </select>
          </label>

          <label>
            Hướng căn hộ
            <select name="huong">
              <option value="">Tất cả</option>
              {[
                'Đông','Tây','Nam','Bắc',
                'Đông Nam','Đông Bắc',
                'Tây Nam','Tây Bắc'
              ].map(x =>
                <option value={x}>{x}</option>
              )}
            </select>
          </label>

          <button
            class="btn property-submit"
            type="button"
            disabled
            title="Chức năng tìm kiếm đang được xây dựng"
          >
            ⌕ Sắp mở tìm kiếm
          </button>

        </div>
      </form>

      <p class="searchnote">
        Bộ lọc sẽ hoạt động sau khi kết nối
        dữ liệu căn hộ và trang kết quả tìm kiếm.
      </p>
    </div>
  </div>

  <script is:inline>
    const priceSets = {
      mua: {
        label: 'Giá mua',
        items: [
          ['', 'Tất cả mức giá'],
          ['under2', 'Dưới 2 tỷ'],
          ['2-3', '2–3 tỷ'],
          ['3-5', '3–5 tỷ'],
          ['5-10', '5–10 tỷ'],
          ['10+', 'Trên 10 tỷ']
        ]
      },
      'thue-dai-han': {
        label: 'Giá thuê / tháng',
        items: [
          ['', 'Tất cả mức giá'],
          ['under5', 'Dưới 5 triệu/tháng'],
          ['5-10', '5–10 triệu/tháng'],
          ['10-20', '10–20 triệu/tháng'],
          ['20+', 'Trên 20 triệu/tháng']
        ]
      },
      'thue-theo-ngay': {
        label: 'Giá thuê / đêm',
        items: [
          ['', 'Tất cả mức giá'],
          ['under500', 'Dưới 500 nghìn/đêm'],
          ['500-1000', '500 nghìn–1 triệu/đêm'],
          ['1-2', '1–2 triệu/đêm'],
          ['2+', 'Trên 2 triệu/đêm']
        ]
      }
    };

    document
      .querySelectorAll('input[name="giao-dich"]')
      .forEach(radio => {
        radio.addEventListener('change', () => {
          if (!radio.checked) return;

          const selected = priceSets[radio.value];
          const label = document.getElementById('price-label');
          const select = document.getElementById('price-select');

          if (!selected || !label || !select) return;

          label.textContent = selected.label;

          select.replaceChildren(
            ...selected.items.map(
              ([value, text]) => new Option(text, value)
            )
          );
        });
      });
  </script>

  <!-- H2: CAN HO BAN -->
  <section class="section" id="can-ho-ban">
    <div class="wrap">
      <div class="sectionhead">
        <div>
          <span class="eyebrow">MUA BÁN CĂN HỘ</span>
          <h2>Căn Hộ Đà Nẵng Đang Bán</h2>
          <p>
            Tìm hiểu căn hộ theo vị trí,
            diện tích, số phòng ngủ và ngân sách.
            Danh sách sản phẩm sẽ được cập nhật
            từ hệ thống quản trị.
          </p>
        </div>
        <a class="textlink" href="/can-ho/">
          Xem danh mục căn hộ →
        </a>
      </div>
    </div>
  </section>

  <!-- H2: CAN HO CHO THUE -->
  <section class="section light" id="can-ho-thue">
    <div class="wrap">
      <div class="sectionhead">
        <div>
          <span class="eyebrow">THỊ TRƯỜNG CHO THUÊ</span>
          <h2>Căn Hộ Cho Thuê Tại Đà Nẵng</h2>
          <p>
            Tham khảo căn hộ cho thuê dài hạn
            hoặc theo ngày tại Đà Nẵng.
            Thông tin giá thuê và tình trạng căn hộ
            sẽ được bổ sung khi có dữ liệu thực tế.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- H2: DU AN NOI BAT -->
  <section class="section" id="du-an">
    <div class="wrap">

      <div class="sectionhead">
        <div>
          <span class="eyebrow">
            THÔNG TIN DỰ ÁN
          </span>

          <h2>Dự Án Bất Động Sản Đà Nẵng Nổi Bật</h2>

          <p>
            Tìm hiểu các dự án căn hộ và
            những dự án bất động sản đáng quan tâm
            tại Đà Nẵng.
          </p>
        </div>

        <a class="textlink" href="/du-an/">
          Xem tất cả dự án →
        </a>
      </div>

      <div class="cards">
        {duAn.map(item => (
          <article class="card">
            <div class={`visual ${item.style}`}>
              <span class="tag">{item.tag}</span>
            </div>

            <div class="cardbody">
              <span class="location">
                ⌖ {item.place}
              </span>

              <h3>{item.title}</h3>

              <p>{item.summary}</p>

              <a class="textlink" href={item.href}>
                Khám phá dự án →
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- H2: CAN HO THEO KHU VUC -->
  <section class="section light" id="khu-vuc">
    <div class="wrap">

      <div class="sectionhead">
        <div>
          <span class="eyebrow">
            KHÁM PHÁ THEO KHU VỰC
          </span>

          <h2>Căn Hộ Đà Nẵng Theo Khu Vực</h2>

          <p>
            Tìm hiểu đặc điểm vị trí,
            giao thông và tiện ích của các
            khu vực căn hộ tại Đà Nẵng.
          </p>
        </div>
      </div>

      <div class="cards">
        {khuVuc.map(item => (
          <article class="card">
            <div class={`visual ${item.style}`}>
              <span class="tag">Theo khu vực</span>
            </div>

            <div class="cardbody">
              <span class="location">
                ⌖ {item.place}
              </span>

              <h3>{item.title}</h3>

              <p>{item.summary}</p>

              <a class="textlink" href={item.href}>
                Tìm hiểu khu vực →
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- H2: BIET THU HAI VAN -->
  <section class="section" id="biet-thu">
    <div class="wrap">

      <div class="sectionhead">
        <div>
          <span class="eyebrow">
            BẤT ĐỘNG SẢN CAO CẤP
          </span>

          <h2>
            Biệt Thự & Shophouse Vinhomes Hải Vân Bay
          </h2>

          <p>
            Khám phá thông tin về Vinhomes Hải Vân Bay,
            các loại hình biệt thự, shophouse,
            vị trí và quy hoạch dự án.
          </p>
        </div>

        <a class="textlink"
          href="/du-an/vinhomes-hai-van-bay/">
          Tìm hiểu Hải Vân Bay →
        </a>
      </div>

    </div>
  </section>

  <!-- H2: NHA DAT THO CU -->
  <section class="section light" id="tho-cu">
    <div class="wrap">

      <div class="sectionhead">
        <div>
          <span class="eyebrow">
            DANH MỤC MỞ RỘNG
          </span>

          <h2>Nhà Đất Thổ Cư Đà Nẵng</h2>

          <p>
            Danh mục nhà riêng và đất thổ cư
            tại Hải Châu, Sơn Trà, Ngũ Hành Sơn,
            Thanh Khê, Liên Chiểu và các khu vực khác.
            Nội dung sẽ được bổ sung trong thời gian tới.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- H2: TIN TUC SEO -->
  <section class="section" id="tin-tuc">
    <div class="wrap">

      <div class="sectionhead">
        <div>
          <span class="eyebrow">
            KIẾN THỨC BẤT ĐỘNG SẢN
          </span>

          <h2>
            Tin Tức Thị Trường Bất Động Sản Đà Nẵng
          </h2>

          <p>
            Thông tin thị trường căn hộ,
            cập nhật dự án, pháp lý
            và kinh nghiệm mua bán bất động sản.
          </p>
        </div>

        <a class="textlink" href="/tin-tuc/">
          Xem tin tức →
        </a>
      </div>

    </div>
  </section>

  <!-- H2: LIEN HE -->
  <section class="banner">
    <div class="wrap">
      <div>
        <h2>Liên Hệ Tư Vấn Căn Hộ Đà Nẵng</h2>

        <p>
          Trao đổi trực tiếp về nhu cầu
          mua bán, cho thuê căn hộ
          hoặc tìm hiểu dự án tại Đà Nẵng.
        </p>
      </div>

      <a class="btn" href="tel:0869437415">
        ☎ 0869 437 415
      </a>
    </div>
  </section>

  <style>
    .cms-hero {
      min-height: var(--cms-hero-height);
      background-size: cover;
      background-position: center var(--cms-image-position);
      background-repeat: no-repeat;
      display: flex;
      align-items: center;
      box-sizing: border-box;
    }
    .cms-hero-content {
      width: 100%;
      max-width: var(--cms-content-width);
      text-align: var(--cms-text-align);
    }
    .cms-hero h1 {
      font-size: var(--cms-title-size);
      line-height: 1.16;
      overflow-wrap: break-word;
    }
    .cms-hero p { margin-inline: 0; }
    .cms-hero[style*="--cms-text-align:center"] p,
    .cms-hero[style*="--cms-text-align:center"] h1 { margin-inline: auto; }
    .cms-hero[style*="--cms-text-align:right"] p,
    .cms-hero[style*="--cms-text-align:right"] h1 { margin-left: auto; }
    .cms-hero-actions { justify-content: flex-start; }
    .cms-hero[style*="--cms-text-align:center"] .cms-hero-actions { justify-content: center; }
    .cms-hero[style*="--cms-text-align:right"] .cms-hero-actions { justify-content: flex-end; }
    .cms-primary-button { background-color: var(--cms-button-color); border-color: var(--cms-button-color); }
    @media (max-width: 767px) {
      .cms-hero { min-height: min(var(--cms-hero-height), 650px); padding-block: 64px; }
      .cms-hero h1 { font-size: clamp(30px, 8vw, 44px); }
      .cms-hero-content { text-align: left; }
      .cms-hero-actions { justify-content: flex-start; }
    }
  </style>

</Base>
