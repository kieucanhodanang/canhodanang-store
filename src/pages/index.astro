
---
import Base from '../layouts/Base.astro';
import { formatListingPrice } from '../utils/formatListingPrice';
import homepage from '../data/homepage.json';
import { getCollection } from 'astro:content';

const clamp = (value, min, max, fallback) => {
  const n = Number(value);
  return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;
};
const bannerHeight = clamp(homepage.bannerHeight, 350, 850, 610);
const titleSize = clamp(homepage.bannerTitleSize, 32, 80, 56);
const contentWidth = clamp(homepage.bannerContentWidth, 800, 1400, 1200);
const overlay = clamp(homepage.bannerOverlay, 0, 80, 45) / 100;
const imagePosition = ['top', 'center', 'bottom'].includes(homepage.bannerPosition) ? homepage.bannerPosition : 'center';
const textAlign = ['left', 'center', 'right'].includes(homepage.bannerTextAlign) ? homepage.bannerTextAlign : 'left';
const buttonColor = /^#[0-9a-fA-F]{6}$/.test(homepage.primaryButtonColor || '') ? homepage.primaryButtonColor : '#D4A85E';
const bannerImage = typeof homepage.bannerImage === 'string' && homepage.bannerImage.startsWith('/uploads/') ? homepage.bannerImage : '';

const rawSlides = Array.isArray(homepage.bannerSlides) ? homepage.bannerSlides : [];
const slides = rawSlides.filter((s) => s && s.enabled !== false && typeof s.image === 'string' && s.image.startsWith('/uploads/')).map((s) => ({
  image: s.image, mobileImage: s.mobileImage?.startsWith('/uploads/') ? s.mobileImage : '',
  imageAlt: s.imageAlt || s.title || 'Bất động sản Đà Nẵng',
  eyebrow: s.eyebrow || '', title: s.title || homepage.bannerTitle,
  description: s.description || '', buttonText: s.buttonText || '',
  buttonLink: s.buttonLink?.startsWith('/') || s.buttonLink?.startsWith('#') ? s.buttonLink : '#tim-kiem'
}));
if (!slides.length) slides.push({
  image: bannerImage, mobileImage: '', imageAlt: 'Căn hộ và bất động sản tại Đà Nẵng',
  eyebrow: homepage.bannerEyebrow || '', title: homepage.bannerTitle || 'Căn Hộ Đà Nẵng',
  description: homepage.bannerDescription || '', buttonText: homepage.primaryButtonText || '',
  buttonLink: homepage.primaryButtonLink || '/mua-ban/'
});
const slideSeconds = clamp(homepage.slideInterval, 3, 12, 5);
const projects = (await getCollection('du-an')).filter((item) => item.data.status !== 'draft')
  .sort((a,b) => a.data.title.localeCompare(b.data.title, 'vi'));
const heroVideo = typeof homepage.bannerVideo === 'string' && /^\/uploads\/[\w./%-]+\.(mp4|webm)$/i.test(homepage.bannerVideo) ? homepage.bannerVideo : '';
const heroPoster = homepage.bannerVideoPoster?.startsWith('/uploads/') ? homepage.bannerVideoPoster : (slides[0]?.image || bannerImage);
const heroMobilePoster = slides[0]?.mobileImage || heroPoster;
const latestNews = (await getCollection('bai-viet'))
  .filter(item => item.data.status === 'published')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
// Dữ liệu tin đăng thật từ Decap CMS, được Astro dựng sẵn khi build.
// Chỉ công khai các sản phẩm còn giao dịch; không đưa bài dự án vào danh sách hàng bán.
const projectNames = new Map(projects.map((item) => [item.id, item.data.title]));
const listingCollections = await Promise.all([
  getCollection('can-ho'), getCollection('nha-dat-tho-cu'),
]);
const listingTypes = ['can-ho', 'nha-dat-tho-cu'];
const searchableListings = listingCollections.flatMap((entries, index) =>
  entries.filter((item) => item.data.status === 'published' && item.data.listingStatus === 'available')
    .map((item) => {
      const d = item.data;
      const numeric = (value) => value === undefined || value === null || value === ''
        ? null : (Number.isFinite(Number(value)) ? Number(value) : null);
      const project = d.project || '';
      const type = listingTypes[index];
      const transaction = d.transaction || 'ban';
      const priceMillion = numeric(d.priceValue);
      return {
        title: d.title || item.id,
        publishedAt: d.date instanceof Date && !Number.isNaN(d.date.getTime()) ? d.date.getTime() : 0,
        featured: Boolean(d.featured),
        featuredOrder: numeric(d.featuredOrder),
        description: d.description || '',
        project,
        projectName: projectNames.get(project) || '',
        district: d.district || '',
        ward: d.ward || '',
        address: d.address || '',
        url: `/${type}/${item.id}/`,
        type,
        propertyType: d.propertyType || type,
        transaction,
        // Giá chuẩn hóa trong CMS là triệu đồng; bộ lọc bán dùng tỷ, thuê dùng triệu.
        price: transaction === 'ban' && priceMillion !== null ? priceMillion / 1000 : null,
        rent: transaction !== 'ban' ? priceMillion : null,
        priceText: formatListingPrice(d.price, transaction, priceMillion),
        area: numeric(d.areaValue),
        areaText: d.area || '',
        bedrooms: numeric(d.bedrooms),
        direction: d.direction || '',
        image: typeof d.image === 'string' && d.image.startsWith('/') ? d.image : '',
      };
    })
);
const searchData = JSON.stringify(searchableListings).replace(/</g, '\\u003c');
const khuVuc = [
  {
    title: 'Căn hộ Sơn Trà',
    place: 'Sơn Trà, Đà Nẵng',
    summary: 'Tìm hiểu căn hộ tại khu vực Sơn Trà, gần biển và các tiện ích đô thị.',
    href: '/can-ho/son-tra/',
    style: '',
    image: homepage.areaImages?.sonTra || ''
  },
  {
    title: 'Căn hộ Ngũ Hành Sơn',
    place: 'Ngũ Hành Sơn, Đà Nẵng',
    summary: 'Khám phá căn hộ tại Ngũ Hành Sơn, vị trí và những tiêu chí cần lưu ý.',
    href: '/can-ho/ngu-hanh-son/',
    style: 'two',
    image: homepage.areaImages?.nguHanhSon || ''
  },
  {
    title: 'Căn hộ Hải Châu',
    place: 'Hải Châu, Đà Nẵng',
    summary: 'Tìm hiểu căn hộ tại khu vực trung tâm thành phố Đà Nẵng.',
    href: '/can-ho/hai-chau/',
    style: 'three',
    image: homepage.areaImages?.haiChau || ''
  }
];

const normalizeLandDistrict = (value: unknown) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').toLowerCase().replace(/^(quan|huyen)\s+/, '').trim();
const normalizeApartmentArea = (value: unknown) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').toLowerCase().replace(/^(quan|phuong|huyen)\s+/, '').trim();
const apartmentAreaCounts = (name: string) => searchableListings.filter(item => item.type === 'can-ho' && item.transaction === 'ban' && [item.ward, item.district].some(value => normalizeApartmentArea(value) === normalizeApartmentArea(name))).length;
const apartmentAreas = khuVuc.map(item => ({ ...item, count: apartmentAreaCounts(item.title.replace(/^Căn hộ\s+/, '')) }));
const landDistrictAreas = [
  { name: 'Sơn Trà', description: 'Nhà phố và đất thổ cư khu vực ven biển, gần trung tâm.', image: homepage.landAreaImages?.sonTra || '' },
  { name: 'Hải Châu', description: 'Nhà đất tại khu vực trung tâm, thuận tiện kinh doanh và sinh sống.', image: homepage.landAreaImages?.haiChau || '' },
  { name: 'Thanh Khê', description: 'Khám phá nhà riêng và đất thổ cư khu vực Thanh Khê.', image: homepage.landAreaImages?.thanhKhe || '' },
].map(area => ({
  ...area,
  count: searchableListings.filter(item => item.type === 'nha-dat-tho-cu' && item.transaction === 'ban' && normalizeLandDistrict(item.district) === normalizeLandDistrict(area.name)).length,
  href: '/nha-dat-tho-cu/' + ({ 'Sơn Trà': 'son-tra', 'Hải Châu': 'hai-chau', 'Thanh Khê': 'thanh-khe' }[area.name] || '') + '/',
}));
const rentalDistrictAreas = [
  { name: 'Sơn Trà', slug: 'son-tra', image: homepage.rentalAreaImages?.sonTra || '' },
  { name: 'Hải Châu', slug: 'hai-chau', image: homepage.rentalAreaImages?.haiChau || '' },
  { name: 'Thanh Khê', slug: 'thanh-khe', image: homepage.rentalAreaImages?.thanhKhe || '' },
].map(area => ({
  ...area,
  href: `/cho-thue/${area.slug}/`,
  count: searchableListings.filter(item => ['cho-thue','cho-thue-ngay'].includes(item.transaction)
    && normalizeLandDistrict(item.district) === normalizeLandDistrict(area.name)).length,
}));
// Chọn tối đa 6 dự án công khai, được bật hiển thị trang chủ.
// Dự án được ghim nổi bật ưu tiên trước; featuredOrder nhỏ lên trước.
const duAn = projects
  .filter((item) => item.data.showOnHome !== false)
  .sort((a, b) => {
    const pinned = Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured));
    if (pinned) return pinned;
    const orderA = Number(a.data.featuredOrder) || 999999;
    const orderB = Number(b.data.featuredOrder) || 999999;
    return orderA - orderB || a.data.title.localeCompare(b.data.title, 'vi');
  })
  .slice(0, 6)
  .map((item) => {
    const d = item.data;
    const rawImage = [d.image, d.coverImage, d.thumbnail]
      .find((value) => typeof value === 'string' && (value.startsWith('/') || value.startsWith('https://')));
    const summary = typeof d.summary === 'string' ? d.summary : typeof d.description === 'string' ? d.description : '';
    return {
      title: d.title,
      place: d.location || 'Đà Nẵng',
      summary: summary.replace(/<[^>]*>/g, '').slice(0, 180),
      href: `/du-an/${item.id}/`,
      tag: 'Dự án bất động sản',
      image: rawImage || '',
      imageAlt: d.imageAlt || `Hình ảnh dự án ${d.title}`,
    };
  });

// Danh sách trang chủ: ghim trước, sau đó bài mới nhất; chỉ lấy bài còn giao dịch.
const homePriority = (a, b) => {
  const pinned = Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured));
  if (pinned) return pinned;
  if (a.data.featured && b.data.featured) {
    const order = (Number(a.data.featuredOrder) || 999999) - (Number(b.data.featuredOrder) || 999999);
    if (order) return order;
  }
  return (b.data.date?.getTime?.() || 0) - (a.data.date?.getTime?.() || 0)
    || a.data.title.localeCompare(b.data.title, 'vi');
};
const isHomeListing = (item) => item.data.status !== 'draft'
  && item.data.listingStatus === 'available' && item.data.showOnHome !== false;
const homeApartments = (await getCollection('can-ho')).filter(isHomeListing);
const homeLand = (await getCollection('nha-dat-tho-cu')).filter(isHomeListing);
const homeSaleApartments = homeApartments.filter(item => item.data.transaction === 'ban')
  .sort(homePriority).slice(0, 6);
const homeRentListings = [
  ...homeApartments.filter(item => ['cho-thue', 'cho-thue-ngay'].includes(item.data.transaction))
    .map(item => ({ ...item, rentalType: 'can-ho' })),
  ...homeLand.filter(item => ['cho-thue', 'cho-thue-ngay'].includes(item.data.transaction))
    .map(item => ({ ...item, rentalType: 'nha-dat-tho-cu' })),
].sort(homePriority).slice(0, 6);
const homeSaleLand = homeLand.filter(item => item.data.transaction === 'ban')
  .sort(homePriority).slice(0, 6);
const cleanProjectName = (name) => String(name || '').trim().replace(/\s*[-–|,]\s*(?:TP\.?\s*)?Đà\s*Nẵng\s*$/i, '').replace(/\s+Đà\s*Nẵng\s*$/i, '').trim();
const shortAddress = (address, district) => {
  const parts = String(address || '').split(',').map(v => v.trim()).filter(Boolean);
  // Chỉ lấy đường thực sự; không lấy tên tháp hoặc tên tòa nhà làm đường.
  const street = parts.find(v => /(?:^|\s)(?:đường|phố|đại lộ|đ\.|street)\s+[\p{L}\d]/iu)
    || parts.find(v => /^\d+[\w/-]*\s+[\p{L}\s]+$/u.test(v) && !/tower|block|tòa|tháp|chung cư/i.test(v)) || '';
  const districtName = String(district || '').trim() || parts.find(v => /^(quận|huyện|q\.)\s/i.test(v)) || '';
  return [street, districtName].filter(Boolean).join(', ');
};
const formatHomeArea = (area) => {
  const value = String(area ?? '').trim();
  return value && !/m²|m2|mét vuông/i.test(value) ? `${value} m²` : value;
};
const homeCards = (items, type) => items.map(item => ({
  title: item.data.title,
  image: item.data.image || '',
  imageAlt: item.data.imageAlt || item.data.title,
  price: formatListingPrice(item.data.price, item.data.transaction || 'ban', item.data.priceValue),
  area: formatHomeArea(item.data.area || item.data.areaValue || ''),
  bedrooms: item.data.bedrooms,
  place: type === 'can-ho' ? shortAddress(item.data.address, item.data.district) : (item.data.district || item.data.address || 'Đà Nẵng'),
  projectName: cleanProjectName(projectNames.get(item.data.project || '') || ''),
  href: `/${type}/${item.id}/`,
  pinned: Boolean(item.data.featured),
}));
const saleCards = homeCards(homeSaleApartments, 'can-ho');
const rentCards = homeRentListings.flatMap(item => homeCards([item], item.rentalType));
const landCards = homeCards(homeSaleLand, 'nha-dat-tho-cu');

const seoTitle = 'Căn Hộ Đà Nẵng | Mua Bán, Cho Thuê & Dự Án Nổi Bật';
const seoDescription = 'Khám phá căn hộ Đà Nẵng mua bán, cho thuê, dự án nổi bật và thông tin thị trường. Liên hệ tư vấn 0869 437 415.';
---
<Base title={seoTitle} description={seoDescription}>
  <section class="hero cms-hero" data-interval={slideSeconds} aria-label="Giới thiệu bất động sản Đà Nẵng"
    style={`--cms-hero-height:${bannerHeight}px;--cms-title-size:${titleSize}px;--cms-content-width:${contentWidth}px;--cms-text-align:${textAlign};--cms-image-position:${imagePosition};--cms-button-color:${buttonColor};--cms-overlay:${overlay};`}>
    <div class="hero-media" aria-hidden="true">
      <picture class="hero-poster">{heroMobilePoster && <source media="(max-width:767px)" srcset={heroMobilePoster} />}{heroPoster ? <img src={heroPoster} alt="" loading="eager" fetchpriority="high" /> : <span class="hero-fallback"></span>}</picture>
      {heroVideo && <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster={heroPoster || undefined}><source src={heroVideo} type={heroVideo.endsWith('.webm') ? 'video/webm' : 'video/mp4'} /></video>}
    </div>
    <div class="hero-overlay"></div>
    <div class="wrap cms-hero-content">
      <span class="eyebrow" id="slide-eyebrow">{slides[0].eyebrow}</span>
      <h1 id="slide-title">{slides[0].title}</h1>
      <p id="slide-description">{slides[0].description}</p>
      <form class="hero-search" id="hero-property-search" role="search">
        <div class="hero-search-tabs" role="group" aria-label="Loại tìm kiếm">
          <label><input type="radio" name="search-type" value="can-ho" checked /><span>Căn hộ</span></label>
          <label><input type="radio" name="search-type" value="cho-thue" /><span>Cho thuê</span></label>
          <label><input type="radio" name="search-type" value="nha-dat-tho-cu" /><span>Nhà đất</span></label>
        </div>
        <div class="hero-search-input"><input id="hero-keyword" type="search" aria-label="Từ khóa tìm kiếm" placeholder="Tìm tên dự án, khu vực, căn hộ..." autocomplete="off" /><button type="submit">Tìm kiếm</button></div>
      </form>
    </div>
  </section>

  <section class="results-section" id="tim-kiem" hidden aria-label="Kết quả tìm kiếm bất động sản">
    <div class="wrap">
      <div class="results-heading"><div><span class="eyebrow">TÌM KIẾM BẤT ĐỘNG SẢN</span><h2>Kết quả tìm kiếm</h2></div><span id="result-count" aria-live="polite"></span></div>
      <div class="home-quick-filters" aria-label="Bộ lọc nhanh">
        <label>Từ khóa<input id="quick-keyword" type="search" placeholder="Tên dự án, khu vực..." /></label>
        <label>Dự án<select id="quick-project"><option value="">Tất cả dự án</option>{projects.map(item => <option value={item.id}>{item.data.title}</option>)}</select></label>
        <label>Phòng ngủ<select id="quick-bedrooms"><option value="">Tất cả</option><option value="0">Studio</option><option value="1">1 phòng</option><option value="2">2 phòng</option><option value="3">3 phòng</option><option value="4">4+ phòng</option></select></label>
        <label>Hướng<select id="quick-direction"><option value="">Tất cả hướng</option>{['Đông','Tây','Nam','Bắc','Đông Nam','Đông Bắc','Tây Nam','Tây Bắc'].map(v => <option value={v}>{v}</option>)}</select></label>
      </div>
      <div class="results-layout">
        <div class="results-primary">
          <div class="results-sortbar">
            <label for="results-sort">Sắp xếp theo</label>
            <select id="results-sort" aria-label="Sắp xếp kết quả tìm kiếm">
              <option value="newest">Tin mới nhất</option>
              <option value="price-asc">Giá thấp đến cao</option>
              <option value="price-desc">Giá cao đến thấp</option>
              <option value="area-desc">Diện tích lớn nhất</option>
            </select>
          </div>
          <div class="search-results-list" id="search-results-list" aria-live="polite"></div>
          <nav class="results-pagination" id="results-pagination" aria-label="Phân trang kết quả tìm kiếm"></nav>
        </div>
        <aside class="results-sidebar" aria-label="Khám phá thêm bất động sản">
      <div class="filter-panel">
        <div class="filter-grid">
          <label class="filter-field filter-keyword">Từ khóa<input id="filter-keyword" type="search" placeholder="Tên dự án, khu vực..." /></label>
          <label class="filter-field">Dự án<select id="filter-project"><option value="">Tất cả dự án</option>{projects.map(item => <option value={item.id}>{item.data.title}</option>)}</select></label>
          <label class="filter-field">Phòng ngủ<select id="filter-bedrooms"><option value="">Tất cả</option><option value="0">Studio</option><option value="1">1 phòng</option><option value="2">2 phòng</option><option value="3">3 phòng</option><option value="4">4+ phòng</option></select></label>
          <label class="filter-field">Hướng<select id="filter-direction"><option value="">Tất cả hướng</option>{['Đông','Tây','Nam','Bắc','Đông Nam','Đông Bắc','Tây Nam','Tây Bắc'].map(v => <option value={v}>{v}</option>)}</select></label>
        </div>
        <div class="range-grid">
          <div class="range-field"><div class="range-header"><strong>Khoảng giá</strong><output id="price-output">0 – 20 tỷ</output></div><div class="dual-range" id="price-range"><div class="range-track"><div class="range-fill"></div></div><input id="price-min" aria-label="Giá từ" type="range" min="0" max="20" step="0.1" value="0" /><input id="price-max" aria-label="Giá đến" type="range" min="0" max="20" step="0.1" value="20" /></div><div class="range-limits"><span id="price-low-label">0 tỷ</span><span id="price-high-label">20 tỷ+</span></div></div>
          <div class="range-field"><div class="range-header"><strong>Diện tích</strong><output id="area-output">25 – 125 m²</output></div><div class="dual-range" id="area-range"><div class="range-track"><div class="range-fill"></div></div><input id="area-min" aria-label="Diện tích từ" type="range" min="25" max="125" step="1" value="25" /><input id="area-max" aria-label="Diện tích đến" type="range" min="25" max="125" step="1" value="125" /></div><div class="range-limits"><span>25 m²</span><span>125 m²+</span></div></div>
        </div>
        <div class="filter-actions"><button id="clear-filters" type="button">Xóa bộ lọc</button><span id="search-type-label">Đang tìm: Căn hộ</span></div>
      </div>

          <section class="sidebar-panel">
            <h3>Dự án được quan tâm</h3>
            <div class="sidebar-projects">
              {duAn.length ? duAn.map(item => (
                <a class="sidebar-project" href={item.href}>
                  <span class="sidebar-project-photo">
                    {item.image ? <img src={item.image} alt={item.imageAlt} loading="lazy" decoding="async" /> : <span aria-hidden="true">⌂</span>}
                  </span>
                  <span class="sidebar-project-info"><strong>{item.title}</strong><small>{item.place}</small></span>
                </a>
              )) : <p class="sidebar-empty">Dự án sẽ được cập nhật từ CMS.</p>}
            </div>
            <a class="sidebar-more" href="/du-an/">Xem tất cả dự án →</a>
          </section>
          <section class="sidebar-panel">
            <h3>Căn hộ theo khu vực</h3>
            <div class="sidebar-regions">
              {khuVuc.map(item => <a href={item.href}><span>{item.title}</span><span aria-hidden="true">→</span></a>)}
            </div>
            <a class="sidebar-more" href="/can-ho/">Xem tất cả căn hộ →</a>
          </section>
        </aside>
      </div>
      <p class="results-note">Kết quả được cập nhật từ các tin đăng công khai và còn giao dịch trong CMS sau mỗi lần xuất bản website. Giá và diện tích cần được nhập ở trường số để lọc bằng thanh trượt.</p>
    </div>
  </section>
  <script type="application/json" id="cms-search-data" set:html={searchData} />
  <script is:inline>
    (() => {
      const video = document.querySelector('.hero-video');
      if (video) {
        if (matchMedia('(max-width:767px), (prefers-reduced-motion:reduce)').matches) { video.pause(); video.style.display = 'none'; }
        else { video.addEventListener('playing', () => video.classList.add('is-playing')); video.addEventListener('error', () => { video.style.display = 'none'; }); video.play().catch(() => { video.style.display = 'none'; }); }
      }
      const searchDataNode = document.getElementById('cms-search-data');
      const items = searchDataNode ? JSON.parse(searchDataNode.textContent || '[]') : [];
      const section = document.getElementById('tim-kiem');
      const form = document.getElementById('hero-property-search');
      const keyword = document.getElementById('hero-keyword');
      const filterKeyword = document.getElementById('filter-keyword');
      const project = document.getElementById('filter-project');
      const bedrooms = document.getElementById('filter-bedrooms');
      const direction = document.getElementById('filter-direction');
      const quickFields = {
        keyword: document.getElementById('quick-keyword'),
        project: document.getElementById('quick-project'),
        bedrooms: document.getElementById('quick-bedrooms'),
        direction: document.getElementById('quick-direction')
      };
      const syncQuick = () => {
        quickFields.keyword.value = filterKeyword.value;
        quickFields.project.value = project.value;
        quickFields.bedrooms.value = bedrooms.value;
        quickFields.direction.value = direction.value;
      };
      Object.entries(quickFields).forEach(([name, el]) => {
        el.addEventListener('input', () => {
          ({keyword:filterKeyword,project,bedrooms,direction})[name].value = el.value;
          render();
        });
      });
      const priceMin = document.getElementById('price-min');
      const priceMax = document.getElementById('price-max');
      const areaMin = document.getElementById('area-min');
      const areaMax = document.getElementById('area-max');
      const list = document.getElementById('search-results-list');
      const count = document.getElementById('result-count');
      const pagination = document.getElementById('results-pagination');
      const sortSelect = document.getElementById('results-sort');
      const pageSize = 12;
      let currentPage = 1;
      let mode = 'can-ho';
      let priceTouched = false;
      let areaTouched = false;
      const normalize = (value) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').toLowerCase().trim();
      // Tìm theo từng từ thay vì yêu cầu nguyên cụm liên tiếp.
      // CMS lưu priceValue bằng TRIỆU; dữ liệu item.price đã đổi sang TỶ cho tin bán.
      const parseSearch = (raw) => {
        let remaining = normalize(raw).replace(/[,](?=\d)/g, '.');
        let requestedBedrooms = null;
        remaining = remaining.replace(/\b(\d+)\s*(?:phong\s*ngu|pn|bedrooms?)\b/g, (_, count) => {
          requestedBedrooms = Number(count);
          return ' ';
        });
        let priceRange = null;
        // Cụm có đơn vị rõ ràng: 4 tỷ, 4.5 tỷ, 12 triệu.
        remaining = remaining.replace(/\b(\d+(?:\.\d+)?)\s*(ty|ti|trieu)(?:\s*dong)?\b/g, (whole, amount, unit) => {
          const value = Number(amount);
          if (Number.isFinite(value)) {
            const priceInMode = mode === 'cho-thue' ? (unit === 'trieu' ? value : value * 1000) : (unit === 'trieu' ? value / 1000 : value);
            priceRange = [Math.max(0, priceInMode - (mode === 'cho-thue' ? 1 : 1)), priceInMode + 1];
          }
          return ' ';
        });
        // Chỉ một con số đơn lẻ: khách tìm căn bán theo TỶ, thuê theo TRIỆU/tháng.
        if (!priceRange && /^\s*\d+(?:\.\d+)?\s*$/.test(remaining)) {
          const value = Number(remaining.trim());
          if (value > 0) {
            priceRange = [Math.max(0, value - 1), value + 1];
            remaining = '';
          }
        }
        const tokens = remaining.split(/\s+/).filter(Boolean);
        return { tokens, priceRange, requestedBedrooms };
      };
      const escapeHTML = (value) => String(value ?? '').replace(/[&<>"']/g, (ch) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
      const format = (n) => Number(n.toFixed(1)).toLocaleString('vi-VN');
      const priceLimit = () => mode === 'cho-thue' ? 50 : 20;
      const priceUnit = () => mode === 'cho-thue' ? 'triệu/tháng' : 'tỷ';
      const updateRange = (minInput,maxInput,container,output,formatter) => {
        let lo = Number(minInput.value), hi = Number(maxInput.value);
        if (lo > hi) { if (document.activeElement === minInput) lo = hi; else hi = lo; }
        minInput.value = String(lo); maxInput.value = String(hi);
        const base = Number(minInput.min), span = Number(minInput.max)-base;
        const fill = container.querySelector('.range-fill');
        fill.style.left = ((lo-base)/span*100)+'%';
        fill.style.width = ((hi-lo)/span*100)+'%';
        output.textContent = formatter(lo,hi);
        // Đầu kéo được focus luôn nằm trên để hai đầu không chặn nhau.
        minInput.style.zIndex = document.activeElement === minInput ? '4' : '3';
        maxInput.style.zIndex = document.activeElement === maxInput ? '4' : '3';
      };
      const syncRanges = () => {
        updateRange(priceMin,priceMax,document.getElementById('price-range'),document.getElementById('price-output'),(a,b)=>`${format(a)} – ${format(b)} ${priceUnit()}`);
        updateRange(areaMin,areaMax,document.getElementById('area-range'),document.getElementById('area-output'),(a,b)=>`${a} – ${b} m²`);
      };
      const setMode = (next) => {
        mode = next;
        const max = priceLimit();
        priceMin.max = priceMax.max = String(max);
        priceMin.step = priceMax.step = mode === 'cho-thue' ? '1' : '0.1';
        priceMin.value = '0'; priceMax.value = String(max);
        priceTouched = false;
        document.getElementById('price-high-label').textContent = `${max} ${priceUnit()}+`;
        document.getElementById('price-low-label').textContent = `0 ${priceUnit()}`;
        document.getElementById('search-type-label').textContent = 'Đang tìm: ' + ({'can-ho':'Căn hộ','cho-thue':'Cho thuê','nha-dat-tho-cu':'Nhà đất'}[mode]);
        syncRanges();
      };
      const render = (resetPage = true) => {
        if (resetPage) currentPage = 1;
        const search = parseSearch(filterKeyword.value);
        const minP = Number(priceMin.value), maxP = Number(priceMax.value);
        const minA = Number(areaMin.value), maxA = Number(areaMax.value);
        const matched = items.filter(item => {
          if (mode === 'cho-thue' && !['cho-thue','cho-thue-ngay'].includes(item.transaction)) return false;
          if (mode === 'nha-dat-tho-cu' && (item.type === 'can-ho' || item.transaction !== 'ban')) return false;
          if (mode === 'can-ho' && (item.type !== 'can-ho' || item.transaction !== 'ban')) return false;
          const searchableText = normalize([item.title,item.description,item.projectName,item.district,item.ward,item.address,
            item.type === 'can-ho' ? 'can ho chung cu' : 'nha dat tho cu',
            item.bedrooms === null ? '' : `${item.bedrooms} phong ngu ${item.bedrooms} pn`].join(' '));
          if (search.tokens.some(token => !searchableText.includes(token))) return false;
          if (search.requestedBedrooms !== null && item.bedrooms !== search.requestedBedrooms) return false;
          if (project.value && item.project !== project.value) return false;
          if (bedrooms.value && (item.bedrooms === null || (bedrooms.value === '4' ? item.bedrooms < 4 : item.bedrooms !== Number(bedrooms.value)))) return false;
          if (direction.value && normalize(item.direction) !== normalize(direction.value)) return false;
          const p = mode === 'cho-thue' ? item.rent : item.price;
          if (search.priceRange && (p === null || p < search.priceRange[0] || p > search.priceRange[1])) return false;
          if (priceTouched && (p === null || p < minP || (maxP < priceLimit() && p > maxP))) return false;
          if (areaTouched && (item.area === null || item.area < minA || (maxA < 125 && item.area > maxA))) return false;
          return true;
        });
        const priceForSort = (item) => mode === 'cho-thue' ? item.rent : item.price;
        const newestFirst = (a, b) => (b.publishedAt || 0) - (a.publishedAt || 0)
          || Number(Boolean(b.featured)) - Number(Boolean(a.featured))
          || (a.featuredOrder ?? Number.MAX_SAFE_INTEGER) - (b.featuredOrder ?? Number.MAX_SAFE_INTEGER)
          || a.title.localeCompare(b.title, 'vi');
        const sortMode = sortSelect.value;
        matched.sort((a, b) => {
          if (sortMode === 'price-asc' || sortMode === 'price-desc') {
            const pa = priceForSort(a), pb = priceForSort(b);
            if (pa === null && pb !== null) return 1;
            if (pb === null && pa !== null) return -1;
            if (pa !== null && pb !== null && pa !== pb) return sortMode === 'price-asc' ? pa - pb : pb - pa;
          }
          if (sortMode === 'area-desc') {
            if (a.area === null && b.area !== null) return 1;
            if (b.area === null && a.area !== null) return -1;
            if (a.area !== null && b.area !== null && a.area !== b.area) return b.area - a.area;
          }
          return newestFirst(a, b);
        });
        count.textContent = `${matched.length} kết quả`;
         list.replaceChildren();
         pagination.replaceChildren();
         if (!matched.length) {
           const empty = document.createElement('div'); empty.className = 'results-empty';
           empty.textContent = 'Chưa có dữ liệu phù hợp với bộ lọc này trong CMS. Anh/chị có thể thử bộ lọc khác hoặc liên hệ 0869 437 415 để được tư vấn.';
           list.append(empty); return;
         }
         const totalPages = Math.ceil(matched.length / pageSize);
         currentPage = Math.min(Math.max(1, currentPage), totalPages);
         const pageItems = matched.slice((currentPage - 1) * pageSize, currentPage * pageSize);
         pageItems.forEach(item => {
           const card = document.createElement('article'); card.className = 'result-card';
           const details = [item.area !== null ? `${format(item.area)} m²` : formatHomeArea(item.areaText), item.bedrooms !== null ? `${item.bedrooms} phòng ngủ` : '', item.direction ? `Hướng ${item.direction}` : ''].filter(Boolean).join(' · ');
           // Giá nhập dạng văn bản trong CMS được ưu tiên để không ghi nhầm đơn vị thuê ngày/tháng.
           const priceValue = mode === 'cho-thue' ? item.rent : item.price;
           const shownPrice = item.priceText || (priceValue === null ? 'Liên hệ báo giá' : `${format(priceValue)} ${priceUnit()}`);
           const typeLabel = item.type === 'can-ho' ? 'Căn hộ' : 'Nhà đất';
           const image = item.image ? `<img class="result-image" src="${escapeHTML(item.image)}" alt="${escapeHTML(item.title)}" loading="lazy" />` : `<span class="result-image result-image-empty" aria-hidden="true">⌂</span>`;
           const parts = String(item.address || '').split(',').map(v=>v.trim()).filter(Boolean);
           const street = parts.find(v=>/(?:^|\s)(?:đường|phố|đại lộ|đ\.|street)\s+[\p{L}\d]/iu)
             || parts.find(v=>/^(?:\d+[\w/-]*\s+)[\p{L}\s]+$/u.test(v) && !/tower|block|tòa|tháp|chung cư/i.test(v)) || '';
           const district = item.district || parts.find(v=>/^(quận|huyện|q\.)\s/i.test(v)) || '';
           const place = item.type === 'can-ho' ? [street,district].filter(Boolean).join(', ') : ([item.district,item.ward].filter(Boolean).join(' · ') || item.address || 'Đà Nẵng');
           const projectLine = item.type === 'can-ho' && item.projectName ? `<strong class="result-project">${escapeHTML(String(item.projectName).replace(/\s*[-–|,]\s*(?:TP\.?\s*)?Đà\s*Nẵng\s*$/i, '').replace(/\s+Đà\s*Nẵng\s*$/i, '').trim())}</strong>` : '';
           const locationLine = place ? `<span class="result-place">${projectLine ? ", " : ""}${escapeHTML(place)}</span>` : '';
           // Ngày đăng thực tế từ CMS, không dùng ngày hiện tại khi thiếu dữ liệu.
           const publishedDate = Number(item.publishedAt) > 0 && Number.isFinite(Number(item.publishedAt))
             ? new Date(Number(item.publishedAt)) : null;
           const publishedLabel = publishedDate && !Number.isNaN(publishedDate.getTime())
             ? new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Asia/Ho_Chi_Minh' }).format(publishedDate)
             : '';
           const dateBadge = publishedLabel
             ? `<time class="result-posted-date" datetime="${publishedDate.toISOString().slice(0, 10)}">Đăng: ${escapeHTML(publishedLabel)}</time>`
             : '';
           card.innerHTML = `<a class="result-photo" href="${escapeHTML(item.url)}" aria-label="Xem ${escapeHTML(item.title)}">${image}</a><div class="result-card-main"><div class="result-card-top"><span class="result-tag">${typeLabel} · ${item.transaction === 'ban' ? 'Đang bán' : 'Cho thuê'}</span>${dateBadge}</div><h3><a href="${escapeHTML(item.url)}">${escapeHTML(item.title)}</a></h3><div class="result-project-location">${projectLine}${locationLine}</div><div class="result-meta">${escapeHTML(details || 'Xem thông tin chi tiết')}</div><div class="result-card-bottom"><strong class="result-price">${escapeHTML(shownPrice)}</strong><a class="result-detail-link" href="${escapeHTML(item.url)}">Xem chi tiết →</a></div></div>`;
           list.append(card);
         });
         if (totalPages > 1) {
           const addPageButton = (label, page, disabled = false, active = false) => {
             const button = document.createElement('button');
             button.type = 'button'; button.textContent = label;
             button.disabled = disabled;
             if (active) { button.className = 'active'; button.setAttribute('aria-current', 'page'); }
             button.setAttribute('aria-label', label === '‹' ? 'Trang trước' : label === '›' ? 'Trang sau' : `Trang ${page}`);
             button.addEventListener('click', () => {
               currentPage = page;
               render(false);
               section.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
             });
             pagination.append(button);
           };
           addPageButton('‹', currentPage - 1, currentPage === 1);
           const first = Math.max(1, Math.min(currentPage - 2, totalPages - 4));
           const last = Math.min(totalPages, first + 4);
           for (let page = first; page <= last; page++) addPageButton(String(page), page, false, page === currentPage);
           addPageButton('›', currentPage + 1, currentPage === totalPages);
         }
      };
      form?.addEventListener('submit',(event)=>{
        event.preventDefault();
        setMode(form.querySelector('input[name="search-type"]:checked')?.value || 'can-ho');
        filterKeyword.value = keyword.value;
        syncQuick();
        section.hidden = false;
        keyword.blur();
        render();
        section.scrollIntoView({behavior:reduceMotion?'auto':'smooth',block:'start'});
      });
      form?.querySelectorAll('input[name="search-type"]').forEach(r=>r.addEventListener('change',()=>{
        if (!section.hidden) { setMode(r.value); render(); }
      }));
      sortSelect?.addEventListener('change', () => render());
      [filterKeyword,project,bedrooms,direction].forEach(el=>el?.addEventListener('input',()=>{syncQuick();render();}));
      [priceMin,priceMax].forEach(el=>el?.addEventListener('input',()=>{priceTouched=true;syncRanges();render();}));
      [areaMin,areaMax].forEach(el=>el?.addEventListener('input',()=>{areaTouched=true;syncRanges();render();}));
      document.getElementById('clear-filters')?.addEventListener('click',()=>{
        filterKeyword.value='';keyword.value='';project.value='';bedrooms.value='';direction.value='';
        areaMin.value='25';areaMax.value='125';areaTouched=false;
        setMode(mode);syncQuick();render();
      });
      setMode(mode);syncQuick();
    })();
  </script>

