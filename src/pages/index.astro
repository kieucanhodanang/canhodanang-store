
---
import Base from '../layouts/Base.astro';
import homepage from '../data/homepage.json';
import { getCollection } from 'astro:content';

const clamp = (value, min, max, fallback) => {
  const n = Number(value);
  return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;
};
const bannerHeight = clamp(homepage.bannerHeight, 350, 850, 610);
const titleSize = clamp(homepage.bannerTitleSize, 32, 80, 56);
const contentWidth = clamp(homepage.bannerContentWidth, 800, 1400, 1200);
const overlay = clamp(homepage.bannerOverlay, 0, 80, 45) / 100;
const imagePosition = ['top', 'center', 'bottom'].includes(homepage.bannerPosition) ? homepage.bannerPosition : 'center';
const textAlign = ['left', 'center', 'right'].includes(homepage.bannerTextAlign) ? homepage.bannerTextAlign : 'left';
const buttonColor = /^#[0-9a-fA-F]{6}$/.test(homepage.primaryButtonColor || '') ? homepage.primaryButtonColor : '#D4A85E';
const bannerImage = typeof homepage.bannerImage === 'string' && homepage.bannerImage.startsWith('/uploads/') ? homepage.bannerImage : '';

const rawSlides = Array.isArray(homepage.bannerSlides) ? homepage.bannerSlides : [];
const slides = rawSlides.filter((s) => s && s.enabled !== false && typeof s.image === 'string' && s.image.startsWith('/uploads/')).map((s) => ({
  image: s.image, mobileImage: s.mobileImage?.startsWith('/uploads/') ? s.mobileImage : '',
  imageAlt: s.imageAlt || s.title || 'Bất động sản Đà Nẵng',
  eyebrow: s.eyebrow || '', title: s.title || homepage.bannerTitle,
  description: s.description || '', buttonText: s.buttonText || '',
  buttonLink: s.buttonLink?.startsWith('/') || s.buttonLink?.startsWith('#') ? s.buttonLink : '#tim-kiem'
}));
if (!slides.length) slides.push({
  image: bannerImage, mobileImage: '', imageAlt: 'Căn hộ và bất động sản tại Đà Nẵng',
  eyebrow: homepage.bannerEyebrow || '', title: homepage.bannerTitle || 'Căn Hộ Đà Nẵng',
  description: homepage.bannerDescription || '', buttonText: homepage.primaryButtonText || '',
  buttonLink: homepage.primaryButtonLink || '/mua-ban/'
});
const slideSeconds = clamp(homepage.slideInterval, 3, 12, 5);
const projects = (await getCollection('du-an')).filter((item) => item.data.status !== 'draft')
  .sort((a,b) => a.data.title.localeCompare(b.data.title, 'vi'));
const slideData = JSON.stringify(slides).replace(/</g, '\\u003c');
const khuVuc = [
  {
    title: 'Căn hộ Sơn Trà',
    place: 'Sơn Trà, Đà Nẵng',
    summary: 'Tìm hiểu căn hộ tại khu vực Sơn Trà, gần biển và các tiện ích đô thị.',
    href: '/can-ho/son-tra/',
    style: ''
  },
  {
    title: 'Căn hộ Ngũ Hành Sơn',
    place: 'Ngũ Hành Sơn, Đà Nẵng',
    summary: 'Khám phá căn hộ tại Ngũ Hành Sơn, vị trí và những tiêu chí cần lưu ý.',
    href: '/can-ho/ngu-hanh-son/',
    style: 'two'
  },
  {
    title: 'Căn hộ Hải Châu',
    place: 'Hải Châu, Đà Nẵng',
    summary: 'Tìm hiểu căn hộ tại khu vực trung tâm thành phố Đà Nẵng.',
    href: '/can-ho/hai-chau/',
    style: 'three'
  }
];

const duAn = [
  {
    title: 'Capital Square Đà Nẵng',
    place: 'Đà Nẵng',
    summary: 'Tìm hiểu thông tin tổng quan, vị trí và sản phẩm căn hộ thuộc dự án.',
    href: '/du-an/capital-square/',
    tag: 'Dự án căn hộ',
    style: 'two'
  },
  {
    title: 'Vinhomes Hải Vân Bay',
    place: 'Khu vực Tây Bắc Đà Nẵng',
    summary: 'Khám phá thông tin quy hoạch, biệt thự, shophouse và các loại hình thuộc dự án.',
    href: '/du-an/vinhomes-hai-van-bay/',
    tag: 'Biệt thự & Shophouse',
    style: ''
  }
];

const seoTitle = 'Căn Hộ Đà Nẵng | Mua Bán, Cho Thuê & Dự Án Nổi Bật';
const seoDescription = 'Khám phá căn hộ Đà Nẵng mua bán, cho thuê, dự án nổi bật và thông tin thị trường. Liên hệ tư vấn 0869 437 415.';
---
<Base title={seoTitle} description={seoDescription}>
  <section class="hero cms-hero" data-interval={slideSeconds} aria-label="Giới thiệu bất động sản Đà Nẵng"
    style={`--cms-hero-height:${bannerHeight}px;--cms-title-size:${titleSize}px;--cms-content-width:${contentWidth}px;--cms-text-align:${textAlign};--cms-image-position:${imagePosition};--cms-button-color:${buttonColor};--cms-overlay:${overlay};`}>
    <div class="hero-slides" aria-hidden="true">
      {slides.map((slide, i) => (
        <picture class:list={['hero-slide', { active: i === 0 }]} data-slide={i}>
          {slide.mobileImage && <source media="(max-width:767px)" srcset={slide.mobileImage} />}
          {slide.image ? <img src={slide.image} alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} /> : <span class="hero-fallback"></span>}
        </picture>
      ))}
    </div>
    <div class="hero-overlay"></div>
    <div class="wrap cms-hero-content">
      <span class="eyebrow" id="slide-eyebrow">{slides[0].eyebrow}</span>
      <h1 id="slide-title">{slides[0].title}</h1>
      <p id="slide-description">{slides[0].description}</p>
      <div class="heroactions cms-hero-actions">
        <button class="btn cms-primary-button" type="button" id="open-property-search">⌕ Tìm bất động sản</button>
        <a class="outlinebtn" id="slide-link" href={slides[0].buttonLink}>{slides[0].buttonText || 'Khám phá dự án'}</a>
      </div>
      {slides.length > 1 && <div class="hero-pagination" aria-label="Chọn ảnh banner">
        {slides.map((_,i) => <button type="button" class:list={['hero-dot', { active:i===0 }]} data-slide-to={i} aria-label={`Xem slide ${i+1}`} aria-current={i===0 ? 'true' : undefined}></button>)}
      </div>}
    </div>
    {slides.length > 1 && <div class="hero-arrows">
      <button type="button" id="slide-prev" aria-label="Ảnh trước">‹</button>
      <button type="button" id="slide-next" aria-label="Ảnh tiếp theo">›</button>
    </div>}
  </section>

  <dialog class="property-dialog" id="property-dialog" aria-labelledby="search-dialog-title">
    <div class="dialog-top"><div><span class="search-kicker">BỘ LỌC BẤT ĐỘNG SẢN</span><h2 id="search-dialog-title">Tìm bất động sản phù hợp</h2></div>
      <button type="button" class="dialog-close" id="close-property-search" aria-label="Đóng tìm kiếm">×</button></div>
    <form id="property-search" method="dialog">
      <div class="search-grid">
        <fieldset class="deal-tabs" aria-label="Chọn hình thức giao dịch">
        <legend>Hình thức giao dịch</legend>
        <div class="deal-tab-list">
          <label class="deal-tab"><input type="radio" name="giao-dich" value="ban" checked /><span>Mua bán</span></label>
          <label class="deal-tab"><input type="radio" name="giao-dich" value="cho-thue" /><span>Cho thuê</span></label>
          <label class="deal-tab"><input type="radio" name="giao-dich" value="cho-thue-ngay" /><span>Thuê theo ngày</span></label>
        </div>
      </fieldset>
        <label>Loại bất động sản<select name="loai"><option value="">Tất cả loại hình</option><option value="can-ho">Căn hộ</option><option value="biet-thu">Biệt thự</option><option value="shophouse">Shophouse</option><option value="nha-rieng">Nhà riêng</option><option value="dat-tho-cu">Đất thổ cư</option></select></label>
        <label>Dự án<select name="du-an"><option value="">Tất cả dự án</option>{projects.map((item) => <option value={item.id}>{item.data.title}</option>)}</select></label>
        <label>Khu vực<select name="khu-vuc"><option value="">Tất cả khu vực</option>{['Hải Châu','Sơn Trà','Ngũ Hành Sơn','Thanh Khê','Liên Chiểu','Cẩm Lệ','Hòa Vang'].map((name) => <option value={name}>{name}</option>)}</select></label>
        <label>Phòng ngủ<select name="phong-ngu"><option value="">Tất cả</option><option value="studio">Studio</option>{[1,2,3,4].map(n => <option value={n}>{n === 4 ? '4+' : n} phòng ngủ</option>)}</select></label>
        <label>Diện tích<select name="dien-tich"><option value="">Tất cả</option><option value="0-50">Dưới 50 m²</option><option value="50-80">50–80 m²</option><option value="80-120">80–120 m²</option><option value="120+">Trên 120 m²</option></select></label>
        <label>Giá<select name="gia" id="price-select"><option value="">Tất cả mức giá</option></select></label>
        <label>Hướng nhà<select name="huong"><option value="">Tất cả hướng</option>{['Đông','Tây','Nam','Bắc','Đông Nam','Đông Bắc','Tây Nam','Tây Bắc'].map(x => <option value={x}>{x}</option>)}</select></label>
      </div>
      <p class="searchnote">Bộ lọc đang được hoàn thiện. Anh/chị có thể xem danh sách bất động sản hoặc liên hệ tư vấn.</p>
      <div class="dialog-actions"><a class="btn" href="/mua-ban/" id="browse-properties">Xem bất động sản</a><a class="outlinebtn" href="tel:0869437415">☎ 0869 437 415</a></div>
    </form>
  </dialog>
  <script type="application/json" id="hero-slides-data" set:html={slideData} />
  <script is:inline>
    (() => {
      const dataNode = document.getElementById('hero-slides-data');
      const slides = dataNode ? JSON.parse(dataNode.textContent || '[]') : [];
      const pictures = Array.from(document.querySelectorAll('.hero-slide'));
      const dots = Array.from(document.querySelectorAll('.hero-dot'));
      let current = 0;
      const show = (index) => {
        if (!slides.length) return;
        current = (index + slides.length) % slides.length;
        pictures.forEach((node,i) => node.classList.toggle('active',i===current));
        dots.forEach((node,i) => { node.classList.toggle('active',i===current); if(i===current) node.setAttribute('aria-current','true'); else node.removeAttribute('aria-current'); });
        const s = slides[current];
        document.getElementById('slide-eyebrow').textContent = s.eyebrow || '';
        document.getElementById('slide-title').textContent = s.title || '';
        document.getElementById('slide-description').textContent = s.description || '';
        const link = document.getElementById('slide-link');
        link.textContent = s.buttonText || 'Khám phá dự án';
        link.href = s.buttonLink || '/mua-ban/';
      };
      document.getElementById('slide-prev')?.addEventListener('click',()=>show(current-1));
      document.getElementById('slide-next')?.addEventListener('click',()=>show(current+1));
      dots.forEach((dot,i)=>dot.addEventListener('click',()=>show(i)));
      const hero = document.querySelector('.cms-hero');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const seconds = Number(hero?.dataset.interval) || 5;
      if (slides.length>1 && !reduceMotion) {
        let timer = setInterval(()=>{ if(!document.hidden) show(current+1); }, seconds*1000);
        hero?.addEventListener('mouseenter',()=>clearInterval(timer));
        hero?.addEventListener('mouseleave',()=>{ clearInterval(timer); timer=setInterval(()=>{if(!document.hidden)show(current+1)},seconds*1000); });
      }
      const dialog = document.getElementById('property-dialog');
      let searchOpened = false;
      document.getElementById('open-property-search')?.addEventListener('click',()=>{
        searchOpened = true;
        if (dialog && !dialog.open) dialog.showModal();
      });
      // Tự mở một lần sau 3 giây nếu khách chưa chủ động mở tìm kiếm.
      window.setTimeout(()=>{
        if (!searchOpened && dialog && !dialog.open) {
          searchOpened = true;
          dialog.showModal();
        }
      }, 3000);
      document.getElementById('close-property-search')?.addEventListener('click',()=>dialog?.close());
      dialog?.addEventListener('click',(event)=>{if(event.target===dialog)dialog.close();});
      const prices = {
        ban:[['','Tất cả mức giá'],['under2','Dưới 2 tỷ'],['2-5','2–5 tỷ'],['5-10','5–10 tỷ'],['10+','Trên 10 tỷ']],
        'cho-thue':[['','Tất cả mức giá'],['under5','Dưới 5 triệu/tháng'],['5-15','5–15 triệu/tháng'],['15+','Trên 15 triệu/tháng']],
        'cho-thue-ngay':[['','Tất cả mức giá'],['under500','Dưới 500 nghìn/đêm'],['500-1000','500 nghìn–1 triệu/đêm'],['1000+','Trên 1 triệu/đêm']]
      };
      const dealInputs = Array.from(document.querySelectorAll('input[name="giao-dich"]'));
      const price=document.getElementById('price-select');
      const browse=document.getElementById('browse-properties');
      const update=()=>{
        const selected = dealInputs.find((input)=>input.checked)?.value || 'ban';
        price.replaceChildren(...prices[selected].map(([value,label])=>new Option(label,value)));
        browse.href = selected === 'ban' ? '/mua-ban/' : selected === 'cho-thue' ? '/cho-thue/' : '/cho-thue-ngay/';
      };
      dealInputs.forEach((input)=>input.addEventListener('change',update));
      update();
    })();
  </script>

  <!-- H2: CAN HO BAN -->
  <section class="section" id="can-ho-ban">
    <div class="wrap">
      <div class="sectionhead">
        <div>
          <span class="eyebrow">MUA BÁN CĂN HỘ</span>
          <h2>Căn Hộ Đà Nẵng Đang Bán</h2>
          <p>
            Tìm hiểu căn hộ theo vị trí,
            diện tích, số phòng ngủ và ngân sách.
            Danh sách sản phẩm sẽ được cập nhật
            từ hệ thống quản trị.
          </p>
        </div>
        <a class="textlink" href="/can-ho/">
          Xem danh mục căn hộ →
        </a>
      </div>
    </div>
  </section>

  <!-- H2: CAN HO CHO THUE -->
  <section class="section light" id="can-ho-thue">
    <div class="wrap">
      <div class="sectionhead">
        <div>
          <span class="eyebrow">THỊ TRƯỜNG CHO THUÊ</span>
          <h2>Căn Hộ Cho Thuê Tại Đà Nẵng</h2>
          <p>
            Tham khảo căn hộ cho thuê dài hạn
            hoặc theo ngày tại Đà Nẵng.
            Thông tin giá thuê và tình trạng căn hộ
            sẽ được bổ sung khi có dữ liệu thực tế.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- H2: DU AN NOI BAT -->
  <section class="section" id="du-an">
    <div class="wrap">

      <div class="sectionhead">
        <div>
          <span class="eyebrow">
            THÔNG TIN DỰ ÁN
          </span>

          <h2>Dự Án Bất Động Sản Đà Nẵng Nổi Bật</h2>

          <p>
            Tìm hiểu các dự án căn hộ và
            những dự án bất động sản đáng quan tâm
            tại Đà Nẵng.
          </p>
        </div>

        <a class="textlink" href="/du-an/">
          Xem tất cả dự án →
        </a>
      </div>

      <div class="cards">
        {duAn.map(item => (
          <article class="card">
            <div class={`visual ${item.style}`}>
              <span class="tag">{item.tag}</span>
            </div>

            <div class="cardbody">
              <span class="location">
                ⌖ {item.place}
              </span>

              <h3>{item.title}</h3>

              <p>{item.summary}</p>

              <a class="textlink" href={item.href}>
                Khám phá dự án →
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- H2: CAN HO THEO KHU VUC -->
  <section class="section light" id="khu-vuc">
    <div class="wrap">

      <div class="sectionhead">
        <div>
          <span class="eyebrow">
            KHÁM PHÁ THEO KHU VỰC
          </span>

          <h2>Căn Hộ Đà Nẵng Theo Khu Vực</h2>

          <p>
            Tìm hiểu đặc điểm vị trí,
            giao thông và tiện ích của các
            khu vực căn hộ tại Đà Nẵng.
          </p>
        </div>
      </div>

      <div class="cards">
        {khuVuc.map(item => (
          <article class="card">
            <div class={`visual ${item.style}`}>
              <span class="tag">Theo khu vực</span>
            </div>

            <div class="cardbody">
              <span class="location">
                ⌖ {item.place}
              </span>

              <h3>{item.title}</h3>

              <p>{item.summary}</p>

              <a class="textlink" href={item.href}>
                Tìm hiểu khu vực →
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- H2: BIET THU HAI VAN -->
  <section class="section" id="biet-thu">
    <div class="wrap">

      <div class="sectionhead">
        <div>
          <span class="eyebrow">
            BẤT ĐỘNG SẢN CAO CẤP
          </span>

          <h2>
            Biệt Thự & Shophouse Vinhomes Hải Vân Bay
          </h2>

          <p>
            Khám phá thông tin về Vinhomes Hải Vân Bay,
            các loại hình biệt thự, shophouse,
            vị trí và quy hoạch dự án.
          </p>
        </div>

        <a class="textlink"
          href="/du-an/vinhomes-hai-van-bay/">
          Tìm hiểu Hải Vân Bay →
        </a>
      </div>

    </div>
  </section>

  <!-- H2: NHA DAT THO CU -->
  <section class="section light" id="tho-cu">
    <div class="wrap">

      <div class="sectionhead">
        <div>
          <span class="eyebrow">
            DANH MỤC MỞ RỘNG
          </span>

          <h2>Nhà Đất Thổ Cư Đà Nẵng</h2>

          <p>
            Danh mục nhà riêng và đất thổ cư
            tại Hải Châu, Sơn Trà, Ngũ Hành Sơn,
            Thanh Khê, Liên Chiểu và các khu vực khác.
            Nội dung sẽ được bổ sung trong thời gian tới.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- H2: TIN TUC SEO -->
  <section class="section" id="tin-tuc">
    <div class="wrap">

      <div class="sectionhead">
        <div>
          <span class="eyebrow">
            KIẾN THỨC BẤT ĐỘNG SẢN
          </span>

          <h2>
            Tin Tức Thị Trường Bất Động Sản Đà Nẵng
          </h2>

          <p>
            Thông tin thị trường căn hộ,
            cập nhật dự án, pháp lý
            và kinh nghiệm mua bán bất động sản.
          </p>
        </div>

        <a class="textlink" href="/tin-tuc/">
          Xem tin tức →
        </a>
      </div>

    </div>
  </section>

  <!-- H2: LIEN HE -->
  <section class="banner">
    <div class="wrap">
      <div>
        <h2>Liên Hệ Tư Vấn Căn Hộ Đà Nẵng</h2>

        <p>
          Trao đổi trực tiếp về nhu cầu
          mua bán, cho thuê căn hộ
          hoặc tìm hiểu dự án tại Đà Nẵng.
        </p>
      </div>

      <a class="btn" href="tel:0869437415">
        ☎ 0869 437 415
      </a>
    </div>
  </section>

  <style>

    .cms-hero { min-height:var(--cms-hero-height);position:relative;display:flex;align-items:center;isolation:isolate;overflow:hidden;box-sizing:border-box;background:#102c49; }
    .hero-slides,.hero-overlay {position:absolute;inset:0;z-index:-1;}
    .hero-slide {position:absolute;inset:0;opacity:0;transition:opacity .7s ease;}
    .hero-slide.active {opacity:1;}
    .hero-slide img,.hero-fallback {display:block;width:100%;height:100%;object-fit:cover;object-position:center var(--cms-image-position);}
    .hero-fallback {background:linear-gradient(125deg,#102c49,#19496a);}
    .hero-overlay {background:rgba(8,27,47,var(--cms-overlay));}
    .cms-hero-content {width:100%;max-width:var(--cms-content-width);text-align:var(--cms-text-align);position:relative;z-index:1;padding-block:70px;}
    .cms-hero h1 {font-size:var(--cms-title-size);line-height:1.16;overflow-wrap:break-word;}
    .cms-hero[style*="--cms-text-align:center"] .cms-hero-actions {justify-content:center;}
    .cms-hero[style*="--cms-text-align:right"] .cms-hero-actions {justify-content:flex-end;}
    .cms-primary-button {background:var(--cms-button-color);border-color:var(--cms-button-color);cursor:pointer;}
    .hero-pagination {display:flex;gap:9px;margin-top:30px;justify-content:flex-start;}
    .hero-dot {width:12px;height:12px;border-radius:50%;border:1px solid white;background:transparent;cursor:pointer;padding:0;}
    .hero-dot.active {background:white;}
    .hero-arrows {position:absolute;inset-inline:16px;top:50%;display:flex;justify-content:space-between;pointer-events:none;transform:translateY(-50%);}
    .hero-arrows button {pointer-events:auto;width:40px;height:40px;border-radius:50%;border:1px solid #ffffff88;background:#10243a99;color:white;font-size:28px;cursor:pointer;}
    .property-dialog {width:min(760px,calc(100vw - 24px));max-height:min(88dvh,850px);border:0;border-radius:16px;padding:24px;color:#142b43;box-shadow:0 20px 70px #0006;overflow:auto;}
    .property-dialog::backdrop {background:#06182caa;}
    .dialog-top {display:flex;justify-content:space-between;gap:15px;align-items:start;margin-bottom:20px;}
    .dialog-top h2 {font-size:clamp(22px,4vw,30px);margin:6px 0 0;}
    .dialog-close {font-size:28px;border:0;background:transparent;cursor:pointer;width:44px;height:44px;flex-shrink:0;}
    .deal-tabs {border:0;margin:0 0 20px;padding:0;min-width:0;}
    .deal-tabs legend {font-size:14px;font-weight:700;margin-bottom:10px;color:#142b43;}
