---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { sortFeaturedFirst, paginateListings } from '../../utils/listingSort';

const apartments = sortFeaturedFirst(
  (await getCollection('can-ho')).filter((item) =>
    item.data.status === 'published' &&
    item.data.listingStatus === 'available' &&
    item.data.transaction === 'ban'
  )
);
const pageSize = 12;
const pagination = paginateListings(apartments, 1, pageSize);
const totalPages = pagination.totalPages;
const projects = (await getCollection('du-an')).filter((item) => item.data.status !== 'draft').sort((a,b) => a.data.title.localeCompare(b.data.title, 'vi'));
const projectNames = new Map(projects.map(item => [item.id, item.data.title]));
const description = 'Tìm mua căn hộ Đà Nẵng đang bán theo khu vực Sơn Trà, Ngũ Hành Sơn, Hải Châu. Xem giá chào bán, diện tích, phòng ngủ và thông tin dự án.';
const plain = (value: unknown) => typeof value === 'string' ? value.replace(/<[^>]*>/g, '').trim() : '';
const formatArea = (value: string | null | undefined, fallback?: number | null) => {
  const raw = plain(value) || (fallback != null ? String(fallback) : '');
  return raw ? (/m²|m2|mét vuông/i.test(raw) ? raw : `${raw} m²`) : 'Liên hệ';
};
const formatPostedDate = (value: unknown) => {
  if (!value) return '';
  const date = value instanceof Date ? value : new Date(String(value));
  return Number.isNaN(date.getTime()) ? '' : new Intl.DateTimeFormat('vi-VN', {day:'2-digit',month:'2-digit',year:'numeric'}).format(date);
};
const imageFor = (data: { image?: string | null; gallery?: string[] | null }) => {
  const candidates = [data.image, ...(data.gallery || [])];
  return candidates.find((value) => typeof value === 'string' && (value.startsWith('/') || value.startsWith('https://'))) || '';
};
---
<Base title="Mua Bán Căn Hộ Đà Nẵng | Giá Bán & Dự Án" description={description}>
  <main>
    <section class="listing-hero">
      <div class="listing-container">
        <nav class="breadcrumb" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><span>Căn hộ đang bán</span></nav>
        <p class="eyebrow">MUA BÁN CĂN HỘ ĐÀ NẴNG</p>
        <h1>Căn Hộ Đà Nẵng Đang Bán</h1>
        <p>Khám phá căn hộ Đà Nẵng theo khu vực, dự án và mức giá. Dễ dàng tìm kiếm căn hộ phù hợp với nhu cầu an cư hoặc đầu tư.</p>
      </div>
    </section>

    <section class="listing-section" aria-label="Danh sách căn hộ đang bán">
      <div class="listing-container">
        <form id="apartment-search" class="apartment-search" role="search">
          <label class="search-input"><span aria-hidden="true">⌕</span><input id="search-keyword" type="search" placeholder="Tìm tên dự án, khu vực, căn hộ..." aria-label="Từ khóa tìm kiếm căn hộ" autocomplete="off" /></label>
          <button type="submit">Tìm kiếm</button>
        </form>
        <div class="quick-filters" aria-label="Bộ lọc nhanh căn hộ">
          <label>Khu vực
            <select id="quick-district"><option value="">Tất cả khu vực</option><option value="son tra">Sơn Trà</option><option value="ngu hanh son">Ngũ Hành Sơn</option><option value="hai chau">Hải Châu</option></select>
          </label>
          <label>Khoảng giá
            <select id="quick-price"><option value="">Tất cả mức giá</option><option value="0-1000">Dưới 1 tỷ</option><option value="1000-2000">1 tỷ – 2 tỷ</option><option value="2000-3000">2 tỷ – 3 tỷ</option><option value="3000-5000">3 tỷ – 5 tỷ</option><option value="5000-7000">5 tỷ – 7 tỷ</option><option value="7000+">Trên 7 tỷ</option></select>
          </label>
          <label>Diện tích
            <select id="quick-area"><option value="">Tất cả diện tích</option><option value="30-45">30m² – 45m²</option><option value="45-60">45m² – 60m²</option><option value="60-80">60m² – 80m²</option><option value="80+">Trên 80m²</option></select>
          </label>
          <label>Dự án
            <select id="quick-project"><option value="">Tất cả dự án</option>{projects.map(item => <option value={item.id}>{item.data.title}</option>)}</select>
          </label>
          <label>Phòng ngủ
            <select id="quick-bedrooms"><option value="">Tất cả phòng ngủ</option><option value="0">Studio</option><option value="1">1 phòng ngủ</option><option value="2">2 phòng ngủ</option><option value="3">3 phòng ngủ</option><option value="4+">4+ phòng ngủ</option></select>
          </label>
        </div>
        <div class="listing-layout">
          <div class="listing-primary">
            <div class="section-heading">
              <div><p class="eyebrow">DANH SÁCH CĂN HỘ</p><h2>Căn hộ đang giao dịch</h2></div>
              <div class="listing-sort-row"><span class="count" id="result-count">{apartments.length} căn hộ</span><label for="sort-listings">Sắp xếp <select id="sort-listings"><option value="default">Nổi bật / Mới nhất</option><option value="newest">Mới nhất</option><option value="price-asc">Giá thấp đến cao</option><option value="price-desc">Giá cao đến thấp</option><option value="area-desc">Diện tích lớn nhất</option></select></label></div>
            </div>
            <nav class="region-shortcuts" aria-label="Trang căn hộ theo khu vực">
              <a href="/can-ho/son-tra/">Sơn Trà →</a>
              <a href="/can-ho/ngu-hanh-son/">Ngũ Hành Sơn →</a>
              <a href="/can-ho/hai-chau/">Hải Châu →</a>
            </nav>
        {apartments.length ? (
          <>
            <div class="listing-grid" id="apartment-grid">
              {apartments.map((item, index) => {
                const d = item.data;
                const image = imageFor(d);
                const href = `/can-ho/${item.id}/`;
                return (
                  <article class="listing-card" data-listing-index={index} data-keywords={[d.title,d.description,d.project,d.project ? projectNames.get(d.project) : '',d.district,d.ward,d.address,d.price,d.priceValue != null ? `${d.priceValue} triệu` : ''].filter(Boolean).join(' ').toLocaleLowerCase('vi')} data-district={(d.district || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/gi, 'd').toLowerCase().trim()} data-price={d.priceValue ?? ''} data-area={d.areaValue ?? ''} data-project={d.project || ''} data-bedrooms={d.bedrooms ?? ''} data-date={d.date ? new Date(d.date).getTime() || 0 : 0} hidden={index >= pageSize}>
                    <a class="listing-image" href={href} aria-label={`Xem căn hộ ${d.title}`}>
                      {image ? <img src={image} alt={d.imageAlt || `Căn hộ ${d.title}`} loading="lazy" /> : <div class="image-placeholder" aria-hidden="true">CĂN HỘ ĐÀ NẴNG</div>}
                      {d.featured && <span class="pin-label">Nổi bật</span>}
                    </a>
                    <div class="listing-body">
                      <h3><a href={href}>{d.title}</a></h3>
                      <strong class="price">{plain(d.price) || 'Liên hệ báo giá'}</strong>
                      <div class="facts">
                        <span>Diện tích: {formatArea(d.area, d.areaValue)}</span>
                        {d.bedrooms != null && <span>{d.bedrooms} phòng ngủ</span>}
                      </div>
                      {d.address && <p class="address">{d.address}</p>}
                      <div class="listing-card-bottom"><a class="detail-link" href={href}>Xem chi tiết <span aria-hidden="true">→</span></a>{formatPostedDate(d.date) && <time class="posted-date" datetime={d.date instanceof Date ? d.date.toISOString().slice(0,10) : String(d.date).slice(0,10)}>Ngày đăng: {formatPostedDate(d.date)}</time>}</div>
                    </div>
                  </article>
                );
              })}
            </div>
            <nav class="pagination" aria-label="Phân trang căn hộ" id="apartment-pagination" hidden>
              <button type="button" data-action="prev" aria-label="Trang trước">‹ Trước</button>
              <span id="pagination-numbers" class="page-numbers"></span>
              <button type="button" data-action="next" aria-label="Trang sau">Sau ›</button>
            </nav>
            <p class="page-summary" id="apartment-page-summary" aria-live="polite"></p>
            <p class="empty-filter" id="empty-filter" hidden>Không tìm thấy căn hộ phù hợp. Hãy thử thay đổi bộ lọc.</p>
          </>
        ) : (
          <div class="empty-state"><h2>Đang cập nhật căn hộ</h2><p>Hiện chưa có căn hộ đang bán phù hợp. Anh/chị có thể liên hệ để được tư vấn.</p></div>
        )}
          </div>
          <aside class="listing-sidebar" aria-label="Bộ lọc căn hộ">
            <div class="filter-box">
              <div class="filter-top"><h2>Bộ lọc căn hộ</h2><button type="button" id="reset-filters">Xóa lọc</button></div>
              <fieldset><legend>Khu vực</legend>
                <label><input type="radio" name="district" value="" checked /> Tất cả khu vực</label>
                <label><input type="radio" name="district" value="son tra" /> Sơn Trà</label>
                <label><input type="radio" name="district" value="ngu hanh son" /> Ngũ Hành Sơn</label>
                <label><input type="radio" name="district" value="hai chau" /> Hải Châu</label>
              </fieldset>
              <fieldset><legend>Khoảng giá</legend>
                <label><input type="radio" name="price" value="" checked /> Tất cả mức giá</label>
                <label><input type="radio" name="price" value="0-1000" /> Dưới 1 tỷ</label>
                <label><input type="radio" name="price" value="1000-2000" /> 1 tỷ – 2 tỷ</label>
                <label><input type="radio" name="price" value="2000-3000" /> 2 tỷ – 3 tỷ</label>
                <label><input type="radio" name="price" value="3000-5000" /> 3 tỷ – 5 tỷ</label>
                <label><input type="radio" name="price" value="5000-7000" /> 5 tỷ – 7 tỷ</label>
                <label><input type="radio" name="price" value="7000+" /> Trên 7 tỷ</label>
              </fieldset>
              <fieldset><legend>Diện tích</legend>
                <label><input type="radio" name="area" value="" checked /> Tất cả diện tích</label>
                <label><input type="radio" name="area" value="30-45" /> 30m² – 45m²</label>
                <label><input type="radio" name="area" value="45-60" /> 45m² – 60m²</label>
                <label><input type="radio" name="area" value="60-80" /> 60m² – 80m²</label>
                <label><input type="radio" name="area" value="80+" /> Trên 80m²</label>
              </fieldset>
              <fieldset><legend>Phòng ngủ</legend>
                <label><input type="radio" name="bedrooms" value="" checked /> Tất cả phòng ngủ</label>
                <label><input type="radio" name="bedrooms" value="0" /> Studio</label>
                <label><input type="radio" name="bedrooms" value="1" /> 1 phòng ngủ</label>
                <label><input type="radio" name="bedrooms" value="2" /> 2 phòng ngủ</label>
                <label><input type="radio" name="bedrooms" value="3" /> 3 phòng ngủ</label>
                <label><input type="radio" name="bedrooms" value="4+" /> 4+ phòng ngủ</label>
              </fieldset>
              <div class="project-filter"><label for="project-select">Dự án</label><select id="project-select"><option value="">Tất cả dự án</option>{projects.map(item => <option value={item.id}>{item.data.title}</option>)}</select></div>
            </div>
          </aside>
        </div>
      </div>
    </section>
    <section class="listing-contact"><div class="listing-container contact-inner"><div><h2>Cần tư vấn căn hộ Đà Nẵng?</h2><p>Liên hệ để được hỗ trợ tìm căn hộ phù hợp với nhu cầu và ngân sách.</p></div><a href="tel:0869437415">Gọi 0869 437 415</a></div></section>
  </main>
</Base>

<script is:inline>
  (() => {
    const grid = document.getElementById('apartment-grid');
    if (!grid) return;
    const cards = [...grid.querySelectorAll('[data-listing-index]')];
    const pagination = document.getElementById('apartment-pagination');
    const numbers = document.getElementById('pagination-numbers');
    const summary = document.getElementById('apartment-page-summary');
    const count = document.getElementById('result-count');
    const sort = document.getElementById('sort-listings');
    const originalOrder = new Map(cards.map((card,index) => [card,index]));
    const cardNumber = (card,key) => { const v=card.dataset[key];return v === undefined || v === '' ? null : Number(v); };

    const empty = document.getElementById('empty-filter');
    const form = document.getElementById('apartment-search');
    const keyword = document.getElementById('search-keyword');
    const project = document.getElementById('project-select');
    const filterBox = document.querySelector('.filter-box');
    const norm = value => (value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/gi,'d').toLowerCase().trim();
    // Tìm không phân biệt dấu, dấu gạch nối, khoảng trắng và cách ghi giá.
    const clean = value => norm(value).replace(/[^a-z0-9]+/g, ' ').replace(/\s+/g, ' ').trim();
    const parsePrice = query => {
      const q = norm(query).replace(/\s+/g, ' ').trim();
      const match = q.match(/^(?:gia\s*)?(\d+(?:[.,]\d+)?)\s*(ty|ti|trieu|tr|trieu dong)$/);
      if (!match) return null;
      const amount = Number(match[1].replace(',', '.'));
      return Number.isFinite(amount) ? amount * (['ty','ti'].includes(match[2]) ? 1000 : 1) : null;
    };
    const matchesKeyword = (card, rawQuery) => {
      if (!rawQuery) return true;
      const query = clean(rawQuery);
      const haystack = clean(card.dataset.keywords || '');
      if (query && haystack.includes(query)) return true;
      // Cho phép nhập nhiều từ rời: ví dụ 'can ho capital square'.
      if (query && query.split(' ').every(word => haystack.split(' ').includes(word))) return true;
      const wanted = parsePrice(rawQuery);
      const actual = card.dataset.price === '' ? NaN : Number(card.dataset.price);
      return wanted !== null && Number.isFinite(actual) && Math.abs(wanted - actual) < 0.01;
    };
    // Danh sách dự án phụ thuộc khu vực của các căn hộ đang đăng bán.
    const updateProjectOptions = () => {
      const district = chosen('district');
      const allowed = new Set(cards.filter(card => !district || clean(card.dataset.district).includes(district)).map(card => card.dataset.project).filter(Boolean));
      [project, document.getElementById('quick-project')].forEach(select => {
        [...select.options].forEach(option => { if (option.value) option.hidden = !allowed.has(option.value); });
        if (select.value && !allowed.has(select.value)) select.value = '';
      });
      if (project.value !== document.getElementById('quick-project').value) document.getElementById('quick-project').value = project.value;
    };
    const chosen = name => filterBox.querySelector(`input[name="${name}"]:checked`)?.value || '';
    const within = (value, range) => {
      if (!range) return true;
      if (value === '' || !Number.isFinite(Number(value))) return false;
      const n = Number(value);
      if (range.endsWith('+')) return n > Number(range.slice(0,-1));
      const [low,high] = range.split('-').map(Number);
      return n >= low && n < high;
    };
    const size = 12;
    let page = 1;
    let filtered = cards;
    const readPage = () => {
      const n = Number(new URLSearchParams(location.search).get('page'));
      return Number.isInteger(n) && n >= 1 ? n : 1;
    };
    const render = (scroll = false) => {
      const pages = Math.max(1,Math.ceil(filtered.length/size));
      page = Math.min(pages,Math.max(1,page));
      const start = (page-1)*size;
      const visible = new Set(filtered.slice(start,start+size));
      cards.forEach(card => {card.hidden = !visible.has(card);});
      numbers.replaceChildren();
      pagination.hidden = pages <= 1;
      for(let n=1;n<=pages && pages>1;n++){
        const btn = document.createElement('button');
        btn.type='button'; btn.textContent=String(n); btn.className=n===page?'active':'';
        if(n===page)btn.setAttribute('aria-current','page');
        btn.addEventListener('click',()=>go(n));numbers.append(btn);
      }
      pagination.querySelector('[data-action="prev"]').disabled=page===1;
      pagination.querySelector('[data-action="next"]').disabled=page===pages;
      count.textContent=`${filtered.length} căn hộ`;
      summary.textContent=filtered.length?`Hiển thị ${start+1}–${Math.min(start+size,filtered.length)} / ${filtered.length} căn hộ`:'Không có căn hộ phù hợp';
      empty.hidden=filtered.length!==0;
      if (!filtered.length) empty.textContent = 'Không tìm thấy căn hộ phù hợp. Hãy bấm Xóa lọc để thử lại, hoặc kiểm tra thông tin dự án/phường đã được nhập trong CMS.';
      if(scroll)grid.scrollIntoView({behavior:'smooth',block:'start'});
    };
    const apply = (resetPage=true) => {
      const q=norm(keyword.value),district=chosen('district'),price=chosen('price'),area=chosen('area'),bedrooms=chosen('bedrooms'),proj=project.value;
      filtered=cards.filter(card => matchesKeyword(card,q) && (!district||clean(card.dataset.district).includes(district)) && within(card.dataset.price,price) && within(card.dataset.area,area) && (!bedrooms || (bedrooms === '4+' ? Number(card.dataset.bedrooms) >= 4 : card.dataset.bedrooms === bedrooms)) && (!proj||card.dataset.project===proj));
      const sortMode = sort?.value || 'default';
      filtered.sort((left,right) => {
        if (sortMode === 'newest') return (cardNumber(right,'date') || 0)-(cardNumber(left,'date') || 0) || originalOrder.get(left)-originalOrder.get(right);
        if (sortMode === 'price-asc' || sortMode === 'price-desc' || sortMode === 'area-desc') {
          const field = sortMode === 'area-desc' ? 'area' : 'price';
          const l=cardNumber(left,field),r=cardNumber(right,field);
          if(l===null && r!==null)return 1;
          if(r===null && l!==null)return -1;
          if(l!==null && r!==null && l!==r)return sortMode==='price-asc' ? l-r : r-l;
        }
        return originalOrder.get(left)-originalOrder.get(right);
      });
      filtered.forEach(card => grid.appendChild(card));
      if(resetPage){page=1;const url=new URL(location.href);url.searchParams.delete('page');history.replaceState(null,'',url);}
      render();
    };
    const go=n=>{page=n;const url=new URL(location.href);if(n===1)url.searchParams.delete('page');else url.searchParams.set('page',String(n));history.pushState(null,'',url);render(true);};
    sort?.addEventListener('change',()=>apply());
    form.addEventListener('submit',e=>{e.preventDefault();apply();});
    const quick = {
      district: document.getElementById('quick-district'),
      price: document.getElementById('quick-price'),
      area: document.getElementById('quick-area'),
      bedrooms: document.getElementById('quick-bedrooms'),
      project: document.getElementById('quick-project')
    };
    const syncQuickFromSidebar = () => {
      ['district','price','area','bedrooms'].forEach(name => { quick[name].value = chosen(name); });
      quick.project.value = project.value;
    };
    const syncSidebarFromQuick = name => {
      if (name === 'project') { project.value = quick.project.value; return; }
      const selected = [...filterBox.querySelectorAll(`input[name="${name}"]`)].find(input => input.value === quick[name].value);
      if (selected) selected.checked = true;
    };
    Object.entries(quick).forEach(([name,select]) => {
      select.addEventListener('change', () => { syncSidebarFromQuick(name); if(name === 'district') updateProjectOptions(); apply(); });
    });
    filterBox.addEventListener('change',()=>{ updateProjectOptions(); syncQuickFromSidebar(); apply(); });
    document.getElementById('reset-filters').addEventListener('click',()=>{form.reset();filterBox.querySelectorAll('input[type=radio][value=""]').forEach(x=>x.checked=true);project.value='';updateProjectOptions();syncQuickFromSidebar();apply();});
    pagination.querySelector('[data-action="prev"]').addEventListener('click',()=>go(page-1));
    pagination.querySelector('[data-action="next"]').addEventListener('click',()=>go(page+1));
    addEventListener('popstate',()=>{page=readPage();render();});
    syncQuickFromSidebar();updateProjectOptions();page=readPage();apply(false);
  })();
</script>

<style>
  .listing-container{width:min(1200px,calc(100% - 40px));margin:0 auto}
  .listing-hero{background:linear-gradient(120deg,#102c49,#245679);color:#fff;padding:48px 0 65px}
  .breadcrumb{display:flex;align-items:center;gap:10px;font-size:13px;margin-bottom:35px;color:#e3edf5}
  .breadcrumb a{color:inherit;text-decoration:none}.breadcrumb a:hover{text-decoration:underline}
  .eyebrow{font-size:12px;font-weight:800;letter-spacing:1.5px;margin:0 0 12px;color:#c9a064}
  .listing-hero h1{font-size:clamp(30px,4vw,48px);line-height:1.2;margin:0 0 18px}
  .listing-hero .listing-container>p:last-child{max-width:1040px;color:#e3edf5;line-height:1.65;margin:0;font-size:16px;text-wrap:pretty}
  .region-navigation{background:#fff;border-bottom:1px solid #e1e7ed;padding:26px 0 30px}
  .region-navigation h2{font-size:21px;color:#173a58;margin:0 0 16px}
  .region-links{display:flex;gap:12px;flex-wrap:wrap}
  .region-links a{display:inline-flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 18px;border:1px solid #d6e1eb;border-radius:10px;background:#f6f8fb;color:#173a58;font-weight:700;text-decoration:none;transition:background .2s,border-color .2s}
  .region-links a:hover,.region-links a:focus-visible{background:#eaf2f8;border-color:#8daec8}
  .region-links a span{color:#a77630}
  .listing-section{padding:34px 0 75px;background:#f6f8fb}
  .apartment-search{display:flex;gap:12px;background:#fff;border:1px solid #e1e7ed;border-radius:12px;padding:12px;margin-bottom:25px}
  .search-input{display:flex;align-items:center;gap:10px;flex:1;min-width:0;background:#f7f9fb;border:1px solid #cbd7e3;border-radius:9px;padding:0 14px}.search-input span{font-size:28px;color:#173a58}
  .search-input input{width:100%;height:45px;border:0;background:transparent;outline:0;font:inherit;min-width:0}
  .apartment-search button{border:0;border-radius:8px;background:#bd3c32;color:white;font:inherit;font-weight:700;padding:0 24px;cursor:pointer}
  .quick-filters{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;background:#fff;border:1px solid #e1e7ed;border-radius:12px;padding:17px;margin:-10px 0 24px;box-shadow:0 4px 16px #102c4908}
  .quick-filters label{display:flex;flex-direction:column;gap:7px;min-width:0;font-size:13px;font-weight:700;color:#173a58}
  .quick-filters select{width:100%;min-width:0;height:43px;padding:0 10px;border:1px solid #cbd7e3;border-radius:8px;background:#fff;color:#243f55;font:inherit;font-weight:400;cursor:pointer}
