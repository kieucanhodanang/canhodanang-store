---
import Base from '../../layouts/Base.astro';
import PropertyDetail from '../../components/PropertyDetail.astro';
import { getCollection, render } from 'astro:content';
import { sortFeaturedFirst } from '../../utils/listingSort';

export async function getStaticPaths() {
  // Astro chạy getStaticPaths trong scope riêng: khai báo danh sách khu vực ngay trong hàm.
  const regions = [
    { slug: 'son-tra', name: 'Sơn Trà' },
    { slug: 'ngu-hanh-son', name: 'Ngũ Hành Sơn' },
    { slug: 'hai-chau', name: 'Hải Châu' },
  ];
  const apartments = await getCollection('can-ho');
  const reserved = new Set(regions.map((region) => region.slug));
  const collision = apartments.find((entry) => reserved.has(entry.id));
  if (collision) throw new Error(`Slug căn hộ ${collision.id} trùng URL khu vực. Hãy đổi slug bài đăng trước khi build.`);
  const detailPaths = apartments
    .filter((entry) => entry.data.status !== 'draft' && !reserved.has(entry.id))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
  const regionPaths = regions.map((region) => ({
    params: { slug: region.slug }, props: { region },
  }));
  return [...detailPaths, ...regionPaths];
}

const { entry, region } = Astro.props;
const data = entry?.data ?? ({} as NonNullable<typeof entry>['data']);
const { Content } = entry ? await render(entry) : { Content: null };
const regionApartments = region
  ? sortFeaturedFirst((await getCollection('can-ho')).filter((item) =>
      item.data.status !== 'draft' &&
      item.data.listingStatus === 'available' &&
      (item.data.district || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/gi, 'd').toLowerCase().trim()
        === region.name.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/gi, 'd').toLowerCase().trim()
    ))
  : [];
const regionSeoTitle = region ? `Căn Hộ ${region.name} Đà Nẵng | Mua Bán & Cho Thuê` : '';
const regionSeoDescription = region ? `Danh sách căn hộ tại ${region.name}, Đà Nẵng đang bán và cho thuê. Cập nhật từ hệ thống bất động sản. Liên hệ 0869 437 415.` : '';

const isAvailable = data.listingStatus === 'available';
const isRent = data.transaction === 'cho-thue' || data.transaction === 'cho-thue-ngay';
const statusLabel = isAvailable
  ? (isRent ? 'Đang cho thuê' : 'Đang bán')
  : data.listingStatus === 'paused'
    ? 'Tạm ngừng giao dịch'
    : (isRent ? 'Đã cho thuê' : 'Đã bán');
const typeLabel = data.transaction === 'cho-thue-ngay'
  ? 'Cho thuê theo ngày'
  : isRent ? 'Cho thuê dài hạn' : 'Bán căn hộ';

const projectNames = (await getCollection('du-an')).reduce((map, item) => {
  map.set(item.id, item.data.title);
  return map;
}, new Map<string, string>());
const projectName = data.project ? projectNames.get(data.project) || data.project : '';

const seoTitle = region ? regionSeoTitle : (data.seoTitle || data.title);
const seoDescription = region ? regionSeoDescription : (data.description || `Thông tin ${data.title}. Liên hệ 0869 437 415 để được tư vấn.`);
const locationLine = [data.address, data.ward, data.district].filter(Boolean).join(' · ');

// Schema.org: chỉ sử dụng dữ liệu thực tế từ CMS.
const siteUrl = 'https://canhodanang.store';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const absoluteImage = (path: string) => new URL(path, siteUrl).href;
const images = [...new Set([data.image, ...(data.gallery ?? [])].filter((value): value is string => typeof value === 'string' && value.trim().length > 0))].map(absoluteImage);
const areaFromText = (value: string | null | undefined) => {
  if (!value) return undefined;
  const match = value.trim().match(/^([\d.,]+)\s*(?:m²|m2|mét vuông)?$/i);
  if (!match) return undefined;
  const raw = match[1];
  const normalized = raw.includes(',') && raw.includes('.')
    ? raw.replace(/\./g, '').replace(',', '.')
    : raw.replace(',', '.');
  const number = Number(normalized);
  return Number.isFinite(number) && number > 0 ? number : undefined;
};
const areaNumber = typeof data.areaValue === 'number' && Number.isFinite(data.areaValue) && data.areaValue > 0
  ? data.areaValue : areaFromText(data.area);
const addressParts = [data.address, data.ward, data.district].filter((value): value is string => typeof value === 'string' && value.trim().length > 0);
const apartmentSchema = {
  '@type': 'Apartment',
  '@id': `${pageUrl}#apartment`,
  name: data.title,
  description: seoDescription,
  url: pageUrl,
  ...(images.length ? { image: images } : {}),
  ...(areaNumber !== undefined ? { floorSize: { '@type': 'QuantitativeValue', value: areaNumber, unitCode: 'MTK' } } : {}),
  ...(typeof data.bedrooms === 'number' && data.bedrooms >= 0 ? { numberOfBedrooms: data.bedrooms } : {}),
  ...(typeof data.bathrooms === 'number' && data.bathrooms >= 0 ? { numberOfBathroomsTotal: data.bathrooms } : {}),
  ...(addressParts.length ? { address: { '@type': 'PostalAddress', streetAddress: data.address || undefined, addressLocality: [data.ward, data.district].filter(Boolean).join(', ') || undefined, addressRegion: 'Đà Nẵng', addressCountry: 'VN' } } : {}),
};

// priceValue trong CMS tính bằng triệu VND. Chỉ khai báo Offer cho tin bán,
// vì giá thuê có thể theo ngày hoặc tháng và chưa có trường đơn vị giá riêng.
const salePrice = !isRent && typeof data.priceValue === 'number' && Number.isFinite(data.priceValue) && data.priceValue > 0
  ? Math.round(data.priceValue * 1_000_000) : undefined;
const offerSchema = salePrice !== undefined ? {
  '@type': 'Offer',
  '@id': `${pageUrl}#offer`,
  url: pageUrl,
  price: salePrice,
  priceCurrency: 'VND',
  availability: data.listingStatus === 'available'
    ? 'https://schema.org/InStock'
    : 'https://schema.org/SoldOut',
  itemOffered: { '@id': `${pageUrl}#apartment` },
} : undefined;
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Căn hộ', item: `${siteUrl}/can-ho/` },
    { '@type': 'ListItem', position: 3, name: data.title, item: pageUrl },
  ],
};
const regionBreadcrumb = region ? {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Căn hộ', item: `${siteUrl}/can-ho/` },
    { '@type': 'ListItem', position: 3, name: `Căn hộ ${region.name}`, item: pageUrl },
  ],
} : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@graph': region ? [regionBreadcrumb] : [apartmentSchema, ...(offerSchema ? [offerSchema] : []), breadcrumbSchema],
};
---
<Base title={seoTitle} description={seoDescription} image={region ? undefined : (data.image || undefined)} imageAlt={data.imageAlt || data.title}>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  {region ? (
    <section class="region-page">
      <div class="property-wrap">
        <nav class="breadcrumbs" aria-label="Đường dẫn">
          <a href="/">Trang chủ</a><span>/</span><a href="/can-ho/">Căn hộ</a><span>/</span><span aria-current="page">{region.name}</span>
        </nav>
        <h1>Căn Hộ {region.name} Đà Nẵng</h1>
        <p class="region-lead">Khám phá căn hộ đang bán và cho thuê tại khu vực {region.name}, Đà Nẵng. Danh sách cập nhật từ hệ thống quản trị.</p>
        <p class="region-count">{regionApartments.length} căn hộ đang giao dịch</p>
        {regionApartments.length ? (
          <>
            <div class="region-grid">
              {regionApartments.map((item, index) => (
                <article class="region-card" data-region-card data-page={Math.floor(index / 12) + 1} hidden={index >= 12}>
                  <a class="region-image" href={`/can-ho/${encodeURIComponent(item.id)}/`}>
                    {item.data.image && <img src={item.data.image} alt={item.data.imageAlt || item.data.title} loading="lazy" />}
                    {item.data.featured && <span class="region-pin">Nổi bật</span>}
                  </a>
                  <div class="region-info">
                    <p class="region-type">{item.data.transaction === 'ban' ? 'Căn hộ đang bán' : 'Căn hộ cho thuê'}</p>
                    <h2><a href={`/can-ho/${encodeURIComponent(item.id)}/`}>{item.data.title}</a></h2>
                    <p class="region-location">{[item.data.address, item.data.ward, item.data.district].filter(Boolean).join(' · ')}</p>
                    <p class="region-price">{item.data.price || 'Liên hệ'}</p>
                    <p class="region-meta">{[item.data.area, item.data.bedrooms != null ? `${item.data.bedrooms} phòng ngủ` : ''].filter(Boolean).join(' · ')}</p>
                    <a class="region-detail" href={`/can-ho/${encodeURIComponent(item.id)}/`}>Xem chi tiết →</a>
                  </div>
                </article>
              ))}
            </div>
            {regionApartments.length > 12 && (
              <nav class="region-pagination" aria-label="Phân trang căn hộ">
                <button type="button" id="region-prev" disabled>← Trước</button>
                <span id="region-page-label">Trang 1 / {Math.ceil(regionApartments.length / 12)}</span>
                <button type="button" id="region-next">Tiếp →</button>
              </nav>
            )}
          </>
        ) : (
          <div class="region-empty">Hiện chưa có căn hộ còn giao dịch tại {region.name}. Vui lòng <a href="tel:0869437415">liên hệ 0869 437 415</a> để được tư vấn.</div>
        )}
        <p class="back-link"><a href="/can-ho/">← Xem tất cả căn hộ Đà Nẵng</a></p>
      </div>
    </section>
  ) : (
  <main class="property-page">
    <div class="property-wrap">
      <nav class="breadcrumbs" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a>
        <span aria-hidden="true">/</span>
        <a href="/can-ho/">Căn hộ</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{data.title}</span>
      </nav>

      <div class="property-intro">
        <div class="intro-text">
          <span class="transaction-label">{typeLabel}</span>
          {locationLine && <p class="property-address">{locationLine}</p>}
          {projectName && <p class="project-name">Dự án: {projectName}</p>}
        </div>
        <span class:list={['status', { inactive: !isAvailable }]}>{statusLabel}</span>
      </div>

      <PropertyDetail property={data} kind="can-ho" phone="0869437415" zalo="0869437415">
        <Content />
      </PropertyDetail>

      <p class="back-link"><a href="/can-ho/">← Xem các căn hộ khác</a></p>
    </div>
  </main>
  )}
  <script is:inline>
    (() => {
      const cards = [...document.querySelectorAll('[data-region-card]')];
      if (!cards.length) return;
      const total = Math.ceil(cards.length / 12);
      let page = 1;
      const prev = document.getElementById('region-prev');
      const next = document.getElementById('region-next');
      const label = document.getElementById('region-page-label');
      const show = () => {
        cards.forEach((card) => { card.hidden = Number(card.dataset.page) !== page; });
        if (prev) prev.disabled = page === 1;
        if (next) next.disabled = page === total;
        if (label) label.textContent = `Trang ${page} / ${total}`;
      };
      prev?.addEventListener('click', () => { if (page > 1) { page--; show(); } });
      next?.addEventListener('click', () => { if (page < total) { page++; show(); } });
      show();
    })();
  </script>

  <style>
    .region-page { background:#f5f8fb; color:#19334d; padding:30px 0 65px; }
    .region-page h1 { font-size:clamp(27px,4vw,38px); margin:16px 0 12px; }
    .region-lead { color:#587187; line-height:1.7; }
    .region-count { font-weight:700; margin:20px 0; }
    .region-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; }
    .region-card { overflow:hidden; background:#fff; border:1px solid #e1e8ee; border-radius:12px; }
    .region-card[hidden] { display:none!important; }
    .region-image { display:block; position:relative; aspect-ratio:16/10; background:#e6edf4; }
    .region-image img { width:100%; height:100%; object-fit:cover; display:block; }
    .region-pin { position:absolute; top:10px; left:10px; background:#173f60; color:#fff; border-radius:5px; padding:5px 9px; font-size:12px; }
    .region-info { padding:17px; }
    .region-type { font-size:12px; color:#986e2f; font-weight:700; }
    .region-info h2 { font-size:19px; line-height:1.45; margin:9px 0; }
    .region-info h2 a { color:#19334d; text-decoration:none; }
    .region-location,.region-meta { color:#65798b; font-size:13px; }
    .region-price { color:#c42626; font-size:20px; font-weight:800; }
    .region-detail { color:#1a5d8c; font-weight:700; }
    .region-pagination { display:flex; justify-content:center; align-items:center; gap:16px; margin-top:30px; }
    .region-pagination button { padding:10px 16px; border:1px solid #cbd7e3; background:#fff; border-radius:8px; cursor:pointer; }
    .region-pagination button:disabled { opacity:.45; cursor:default; }
    .region-empty { padding:28px; background:#fff; border-radius:12px; }
    @media(max-width:900px) { .region-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @media(max-width:600px) { .region-grid { grid-template-columns:1fr; } }
    .property-page { background:#f5f8fb; color:#19334d; padding:30px 0 65px; }
    .property-wrap { max-width:1160px; margin:0 auto; padding:0 20px; }
    .breadcrumbs { display:flex; flex-wrap:wrap; gap:9px; font-size:13px; color:#68798a; margin-bottom:20px; overflow-wrap:anywhere; }
    .breadcrumbs a, .back-link a { color:#1a5d8c; }
    .property-intro { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; margin-bottom:18px; }
    .intro-text { min-width:0; }
    .transaction-label { color:#996e2d; font-weight:700; font-size:13px; text-transform:uppercase; }
    .property-address { color:#62788b; margin:7px 0 0; line-height:1.5; }
    .project-name { color:#62788b; margin:5px 0 0; line-height:1.5; }
    .status { background:#e5f5ec; color:#14663a; border-radius:30px; padding:8px 14px; font-size:13px; font-weight:700; white-space:nowrap; }
    .status.inactive { background:#f2e9e6; color:#8c3d32; }
    .back-link { margin-top:28px; }
    @media(max-width:767px) {
      .property-wrap { padding:0 14px; }
      .property-intro { flex-direction:column; gap:10px; }
    }
  </style>
</Base>
