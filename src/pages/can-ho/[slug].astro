  <script is:inline>
    (() => {
      const cards = [...document.querySelectorAll('[data-region-card]')];
      if (!cards.length) return;
      const total = Math.ceil(cards.length / 12);
      const grid = document.querySelector('.region-grid');
      const sort = document.getElementById('region-sort');
      const originalOrder = new Map(cards.map((card, index) => [card, index]));
      const number = (card, key) => { const value = card.dataset[key]; return value === undefined || value === '' ? null : Number(value); };
      let page = 1;
      const sortCards = () => {
        const mode = sort?.value || 'default';
        cards.sort((a, b) => {
          if (mode === 'newest') return (number(b, 'regionDate') || 0) - (number(a, 'regionDate') || 0) || originalOrder.get(a) - originalOrder.get(b);
          if (mode === 'price-asc' || mode === 'price-desc' || mode === 'area-desc') {
            const key = mode === 'area-desc' ? 'regionArea' : 'regionPrice';
            const left = number(a, key), right = number(b, key);
            if (left === null && right !== null) return 1;
            if (right === null && left !== null) return -1;
            if (left !== null && right !== null && left !== right) return mode === 'price-asc' ? left - right : right - left;
          }
          return originalOrder.get(a) - originalOrder.get(b);
        });
        cards.forEach((card, index) => { card.dataset.page = String(Math.floor(index / 12) + 1); grid?.appendChild(card); });
      };
      const prev = document.getElementById('region-prev');
      const next = document.getElementById('region-next');
      const label = document.getElementById('region-page-label');
      const show = () => {
        cards.forEach((card) => { card.hidden = Number(card.dataset.page) !== page; });
        if (prev) prev.disabled = page === 1;
        if (next) next.disabled = page === total;
        if (label) label.textContent = `Trang ${page} / ${total}`;
      };
      sort?.addEventListener('change', () => { page = 1; sortCards(); show(); });
      prev?.addEventListener('click', () => { if (page > 1) { page--; show(); } });
      next?.addEventListener('click', () => { if (page < total) { page++; show(); } });
      show();
    })();
  </script>

