---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('bai-viet');
  return articles
    .filter((entry) => entry.data.status === 'published')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
const projects = (await getCollection('du-an')).filter(item => item.data.status === 'published');
const articles = (await getCollection('bai-viet')).filter(item => item.data.status === 'published' && item.id !== entry.id);
const relatedArticles = data.project ? articles.filter(item => item.data.project === data.project).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 6) : [];
// Căn hộ còn giao dịch thuộc dự án được gắn với bài viết.
const relatedApartments = data.project
  ? (await getCollection('can-ho')).filter(item =>
      item.data.status !== 'draft'
      && item.data.listingStatus === 'available'
      && item.data.project === data.project)
  : [];
const saleApartments = relatedApartments.filter(item => item.data.transaction === 'ban').slice(0, 6);
const rentApartments = relatedApartments.filter(item => item.data.transaction !== 'ban').slice(0, 6);
const formatApartmentPrice = (value: unknown) => {
  if (value === undefined || value === null || value === '') return 'Liên hệ';
  return String(value);
};
const isLandArticle = data.category === 'tho-cu';
const linkedProject = data.project ? projects.find(item => item.id === data.project && item.data.status === 'published') : undefined;
const consultantHeading = isLandArticle ? 'Mua nhà Đà Nẵng' : (linkedProject?.data.title || 'Bất động sản Đà Nẵng');
const featuredProjects = [...projects].sort((a, b) => Number(b.id === data.project) - Number(a.id === data.project)).slice(0, 8);
const siteUrl = 'https://canhodanang.store';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const seoTitle = data.seoTitle?.trim() || data.title;
const description = data.description?.trim() || `Tin tức bất động sản Đà Nẵng: ${data.title}`;
const image = data.ogImage || data.image || undefined;
const dateText = data.date instanceof Date && !Number.isNaN(data.date.getTime())
  ? data.date.toISOString() : undefined;
const updatedText = data.updatedAt instanceof Date && !Number.isNaN(data.updatedAt.getTime())
  ? data.updatedAt.toISOString() : dateText;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${pageUrl}#article`,
      headline: data.title,
      description,
      mainEntityOfPage: pageUrl,
      url: pageUrl,
      ...(image ? { image: new URL(image, siteUrl).href } : {}),
      ...(dateText ? { datePublished: dateText } : {}),
      ...(updatedText ? { dateModified: updatedText } : {}),
      publisher: { '@type': 'Organization', name: 'Căn Hộ Đà Nẵng', url: siteUrl },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Tin tức', item: `${siteUrl}/tin-tuc/` },
        { '@type': 'ListItem', position: 3, name: data.title, item: pageUrl },
      ],
    },
  ],
};
---
<Base title={seoTitle} description={description} image={image} imageAlt={data.imageAlt || data.title} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <main class="news-page">
    <div class="news-layout"><article class="news-wrap">
      <nav class="breadcrumbs" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a><span aria-hidden="true">/</span>
        <a href="/tin-tuc/">Tin tức</a><span aria-hidden="true">/</span>
        <span aria-current="page">{data.title}</span>
      </nav>
      <header class="news-header">
        <h1>{data.title}</h1>
        {dateText && <time datetime={dateText}>{new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Asia/Ho_Chi_Minh' }).format(data.date)}</time>}
        <p class="lead">{description}</p>
      </header>
      {data.image && <img class="cover" src={data.image} alt={data.imageAlt || data.title} loading="eager" decoding="async" />}
      <div class="article-body"><Content /></div>
      <!-- CMS shortcode: place [[FORM_TU_VAN]] on its own line in article Markdown. -->
      <template id="news-lead-template">
        <section class="news-lead-box" aria-label="Đăng ký nhận tư vấn">
          <h2>Nhận tư vấn bất động sản</h2>
          <p>Để lại thông tin, chuyên viên sẽ liên hệ hỗ trợ anh/chị.</p>
          <form action="https://docs.google.com/forms/d/e/1FAIpQLScpdMvW3g0dfHdc4sx_k9Mps05ObD57aOzy1ugbEY0UBBENqQ/formResponse" method="POST" target="news-lead-target">
            <label>Họ và tên <span>*</span><input name="entry.1817354620" type="text" autocomplete="name" maxlength="120" placeholder="Nhập họ và tên" required /></label>
            <label>Số điện thoại <span>*</span><input name="entry.996658541" type="tel" autocomplete="tel" inputmode="tel" pattern="[0-9+ .()-]{9,18}" placeholder="Nhập số điện thoại" required /></label>
            <label>Thông tin quan tâm <span>*</span><textarea name="entry.2014010319" rows="3" maxlength="1000" placeholder="" required></textarea></label>
            <label class="news-lead-consent"><input type="checkbox" required /> Tôi đồng ý cung cấp thông tin để được liên hệ tư vấn.</label>
            <button type="submit">Gửi thông tin tư vấn</button>
            <small>Thông tin được gửi đến Google Forms. Vui lòng liên hệ Zalo nếu cần hỗ trợ ngay.</small>
          </form>
        </section>
      </template>
      <iframe name="news-lead-target" title="Gửi thông tin Google Forms" hidden></iframe>
      <script is:inline>
        (() => {
          const article = document.querySelector('.news-page .article-body');
          const template = document.getElementById('news-lead-template');
          if (!article || !template) return;
          const marker = '[[FORM_TU_VAN]]';
          // Only replace plain-text shortcode, never interpret arbitrary CMS HTML.
          const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT);
          const matches = [];
          while (walker.nextNode()) {
            const node = walker.currentNode;
            if (node.textContent?.includes(marker) && !node.parentElement?.closest('script,style,code,pre')) matches.push(node);
          }
          matches.forEach(node => {
            const parts = (node.textContent || '').split(marker);
            const fragment = document.createDocumentFragment();
            parts.forEach((part, index) => {
              if (part) fragment.appendChild(document.createTextNode(part));
              if (index < parts.length - 1) {
                const form = template.content.firstElementChild.cloneNode(true);
                const text = form.querySelector('textarea');
                if (text) text.value = '';
                fragment.appendChild(form);
              }
            });
            const parent = node.parentElement;
            if (parent?.tagName === 'P' && parent.textContent.trim() === marker) parent.replaceWith(fragment);
            else node.replaceWith(fragment);
          });
        })();
      </script>
      {linkedProject && relatedApartments.length > 0 && <section class="news-apartments" aria-label={`Căn hộ tại ${linkedProject.data.title}`}>
        <div class="news-apartments-heading">
          <h2>Căn hộ đang bán và cho thuê tại {linkedProject.data.title}</h2>
          <a href={`/du-an/${linkedProject.id}/`}>Xem dự án →</a>
        </div>
        {[
          { title: 'Căn hộ đang bán', items: saleApartments },
          { title: 'Căn hộ cho thuê', items: rentApartments },
        ].filter(group => group.items.length > 0).map(group => <div class="news-apartment-group">
          <h3>{group.title}</h3>
          <div class="news-apartment-grid">{group.items.map(item => <a class="news-apartment-card" href={`/can-ho/${encodeURIComponent(item.id)}/`}>
            {item.data.image ? <img src={item.data.image} alt={item.data.title} loading="lazy" decoding="async" /> : <div class="news-apartment-placeholder">Căn hộ Đà Nẵng</div>}
            <div class="news-apartment-info">
              <strong>{item.data.title}</strong>
              <span class="news-apartment-price">{formatApartmentPrice(item.data.price)}</span>
              <span class="news-apartment-meta">{[item.data.area ? `${item.data.area} m²` : '', item.data.bedrooms ? `${item.data.bedrooms} phòng ngủ` : ''].filter(Boolean).join(' · ')}</span>
              <span class="news-apartment-detail">Xem chi tiết →</span>
            </div>
          </a>)}</div>
        </div>)}
      </section>}
      <section class="article-share" aria-label="Chia sẻ bài viết">
        <p>Chia sẻ bài viết này</p>
        <div class="share-actions">
          <a class="share-facebook" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Chia sẻ lên Facebook">Facebook</a>
          <a class="share-zalo" href={`https://zalo.me/share?url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Chia sẻ qua Zalo">Zalo</a>
          <button class="share-copy" type="button" data-copy-url={pageUrl}>Copy link</button>
        </div>
        <span class="share-feedback" aria-live="polite"></span>
      </section>
      {linkedProject && <section class="related-articles" aria-label="Tin tức liên quan dự án">
        <h2>Tin tức liên quan dự án {linkedProject.data.title}</h2>
        {relatedArticles.length > 0 ? <div class="related-list">{relatedArticles.map(item => <a class="related-item" href={`/tin-tuc/${item.id}/`}>{item.data.image ? <img src={item.data.image} alt={item.data.imageAlt || item.data.title} loading="lazy" /> : <span class="related-placeholder" aria-hidden="true">Tin tức</span>}<span class="related-info"><time datetime={item.data.date.toISOString()}>{new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Asia/Ho_Chi_Minh' }).format(item.data.date)}</time><strong>{item.data.title}</strong>{item.data.description && <span class="related-description">{item.data.description}</span>}</span></a>)}</div> : <p class="related-empty">Chưa có bài viết liên quan khác về dự án này.</p>}
      </section>}
      <script>
        document.querySelectorAll<HTMLButtonElement>('.share-copy').forEach(button => {
          button.addEventListener('click', async () => {
            const url = button.dataset.copyUrl || window.location.href;
            const feedback = button.closest('.article-share')?.querySelector('.share-feedback');
            try {
              await navigator.clipboard.writeText(url);
              if (feedback) feedback.textContent = 'Đã sao chép liên kết!';
            } catch {
              if (feedback) feedback.textContent = 'Không thể sao chép tự động. Vui lòng sao chép từ thanh địa chỉ.';
            }
          });
        });
      </script>
    </article>
    <aside class="news-sidebar" aria-label="Thông tin tư vấn và danh sách dự án">
      <div class="sidebar-sticky">
        <section class="consultant-card">
          <div class="consultant-heading"><span>{isLandArticle ? 'Tư vấn bất động sản' : 'Nhận thông tin dự án'}</span><strong>{consultantHeading}</strong></div>
          <div class="consultant-body">
            <div class="consultant-avatar"><img src="/uploads/tu-van-vien-vest.jpg" alt="Chuyên viên tư vấn bất động sản Đà Nẵng" loading="lazy" onerror="this.style.display='none'" /></div>
            <h2>Mr. Kiều Nguyễn</h2><p>Hỗ trợ thông tin dự án và căn hộ</p>
            <a class="consultant-zalo" href="https://zalo.me/0869437415" target="_blank" rel="noopener noreferrer">Chat qua Zalo</a>
            <a class="consultant-call" href="tel:0869437415">☎ 0869 437 415</a>
          </div>
        </section>
        {featuredProjects.length > 0 && <section class="sidebar-projects"><h2>Danh sách dự án</h2><ul>{featuredProjects.map(project => <li><a href={`/du-an/${project.id}/`}>{project.data.image && <img src={project.data.image} alt="" loading="lazy" />}<span>{project.data.title}</span><span aria-hidden="true">›</span></a></li>)}</ul><a class="all-projects" href="/du-an/">Xem tất cả dự án →</a></section>}
      </div>
    </aside></div>
  </main>
  <style>
    .news-page{background:#f5f8fb;min-height:65vh;padding:28px 16px 70px;color:#213547}
    .news-layout{max-width:1250px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px;align-items:start}
    .news-wrap{min-width:0;background:#fff;border-radius:16px;padding:clamp(20px,3vw,38px);box-shadow:0 4px 24px #18334d0a}
    .news-sidebar{min-width:0;position:sticky;top:88px;align-self:start}.sidebar-sticky{display:grid;gap:16px;max-height:calc(100vh - 105px);overflow-y:auto;scrollbar-width:thin}
    .consultant-card,.sidebar-projects{background:#fff;border:1px solid #e0e7ef;border-radius:14px;overflow:hidden;box-shadow:0 6px 22px #102c4915}
    .consultant-heading{background:linear-gradient(125deg,#10365e,#185d8c);color:#fff;padding:17px 14px;text-align:center;display:grid;gap:5px;font-size:16px}.consultant-heading strong{font-size:20px;color:#f4c16b;line-height:1.35}
    .consultant-body{padding:20px 16px;text-align:center}.consultant-avatar{width:150px;height:150px;margin:0 auto 14px;border:2px solid #b88b41;border-radius:50%;overflow:hidden;background:#edf3f8}.consultant-avatar img{width:100%;height:100%;object-fit:cover;object-position:center 20%}
    .consultant-body h2{font-size:17px;margin:0 0 7px;color:#17334d}.consultant-body p{font-size:13px;color:#718092;margin:0 0 16px}.consultant-zalo,.consultant-call{display:block;padding:12px;border-radius:9px;font-weight:700;text-decoration:none;margin-top:9px}.consultant-zalo{border:1px solid #b9c9dc;color:#135c99}.consultant-call{background:#009d9f;color:#fff}
    .sidebar-projects h2{margin:0;padding:15px;background:#eff5fa;color:#173d62;font-size:18px}.sidebar-projects ul{list-style:none;padding:5px 13px;margin:0}.sidebar-projects li+li{border-top:1px solid #e6edf2}.sidebar-projects li a{display:flex;gap:10px;align-items:center;padding:11px 0;color:#173d62;text-decoration:none;font-weight:650;font-size:13px}.sidebar-projects li img{width:62px;height:48px;object-fit:cover;border-radius:7px;flex-shrink:0}.sidebar-projects li a span:nth-last-child(2){flex:1}.sidebar-projects li a span:last-child{margin-left:auto;font-size:23px}.all-projects{display:block;text-align:center;margin:0 13px 14px;padding:11px;border:1px solid #9eb8d2;border-radius:8px;color:#145b90;text-decoration:none;font-weight:700;font-size:13px}
    .news-apartments{margin-top:34px;padding-top:28px;border-top:1px solid #dce6ef}
    .news-apartments-heading{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:16px}
    .news-apartments-heading h2{font-size:23px;line-height:1.4;color:#173b60;margin:0}
    .news-apartments-heading a{color:#17628e;font-weight:700;text-decoration:none;font-size:14px}
    .news-apartment-group{margin-top:22px}.news-apartment-group h3{font-size:18px;color:#244c6b;margin:0 0 12px}
    .news-apartment-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
    .news-apartment-card{display:block;min-width:0;border:1px solid #e0e8f0;border-radius:12px;overflow:hidden;text-decoration:none;color:#213547;background:#fff;transition:box-shadow .2s}
    .news-apartment-card:hover{box-shadow:0 7px 20px #18334d18}
    .news-apartment-card img,.news-apartment-placeholder{width:100%;height:160px;object-fit:cover;display:block;background:#edf4fa}
    .news-apartment-placeholder{display:grid;place-items:center;color:#7890a3}
    .news-apartment-info{padding:13px;display:grid;gap:7px}
    .news-apartment-info strong{font-size:15px;line-height:1.45}
    .news-apartment-price{font-weight:750;color:#cf3333;font-size:16px}
    .news-apartment-meta{font-size:13px;color:#617789}
    .news-apartment-detail{font-size:13px;font-weight:700;color:#17628e}
    @media(max-width:600px){.news-apartment-grid{grid-template-columns:1fr}.news-apartment-card img,.news-apartment-placeholder{height:190px}}
    .article-share{margin-top:32px;padding-top:22px;border-top:1px solid #e1e8ef}.article-share p{font-size:14px;color:#62758a;margin:0 0 12px}.share-actions{display:flex;flex-wrap:wrap;gap:10px;align-items:center}.share-actions a,.share-actions button{font:inherit;font-size:14px;font-weight:650;border-radius:8px;padding:10px 16px;min-height:42px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer;border:1px solid transparent}.share-facebook{background:#1877f2;color:white}.share-zalo{background:#087de5;color:white}.share-actions .share-copy{background:white;color:#184c73;border-color:#b9cbdc}.share-actions a:hover,.share-actions button:hover{filter:brightness(.94)}.share-feedback{display:block;font-size:13px;color:#24714b;margin-top:9px;min-height:1em}
    .related-articles{margin-top:30px;padding-top:26px;border-top:1px solid #dce6ef}.related-articles h2{font-size:23px;line-height:1.4;color:#173b60;margin:0 0 18px}.related-list{display:grid;gap:16px}.related-item{display:flex;align-items:flex-start;gap:16px;padding:0 0 16px;border-bottom:1px solid #e8edf2;text-decoration:none;color:#173b60}.related-item img,.related-placeholder{width:180px;height:110px;object-fit:cover;border-radius:9px;flex-shrink:0}.related-placeholder{display:grid;place-items:center;background:#edf4fa;color:#51738f}.related-info{display:grid;gap:6px;min-width:0}.related-info time{font-size:12px;color:#78899a}.related-info strong{font-size:17px;line-height:1.45}.related-description{font-size:13px;line-height:1.6;color:#62758a;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.related-item:hover strong{text-decoration:underline}.related-empty{font-size:14px;color:#728294;margin:0 0 10px}
    @media(max-width:600px){.related-item img,.related-placeholder{width:110px;height:88px}.related-info strong{font-size:15px}.related-description{display:none}}
    @media(max-width:980px){.news-layout{grid-template-columns:minmax(0,1fr)}.news-sidebar{position:static}.sidebar-sticky{max-height:none;overflow:visible;grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:640px){.sidebar-sticky{grid-template-columns:1fr}}
    .breadcrumbs{display:flex;gap:9px;flex-wrap:wrap;color:#718092;font-size:13px;margin-bottom:24px;overflow-wrap:anywhere}
    .breadcrumbs a,.news-footer a{color:#17628e;text-decoration:none}
    .news-header h1{font-size:clamp(27px,4vw,42px);line-height:1.3;margin:0 0 16px;color:#183b58}
    .category{color:#ad7c32;font-size:13px;font-weight:700;text-transform:uppercase;margin:0}
    .news-header time{color:#6d7e8b;font-size:14px}
    .lead{font-size:17px;line-height:1.75;color:#536879;margin:20px 0 26px}
    .cover{display:block;width:100%;max-height:490px;object-fit:cover;border-radius:12px;margin-bottom:28px}
    .article-body{font-size:16px;line-height:1.85;overflow-wrap:anywhere}
    .article-body :global(.news-lead-box){margin:28px 0;padding:24px;background:linear-gradient(145deg,#fff3d6,#fce3ad);border:1px solid #d9a85a;border-radius:14px;box-shadow:0 8px 26px #a77a3826}
    .article-body :global(.news-lead-box h2){margin:0 0 8px;font-size:23px;color:#173d62}
    .article-body :global(.news-lead-box p){margin:0 0 16px;color:#64748b}
    .article-body :global(.news-lead-box form){display:grid;gap:12px}
    .article-body :global(.news-lead-box label){display:grid;gap:5px;font-size:14px;font-weight:650}
    .article-body :global(.news-lead-box label span){color:#c53030}
    .article-body :global(.news-lead-box input:not([type="checkbox"])),.article-body :global(.news-lead-box textarea){width:100%;box-sizing:border-box;padding:12px;border:1px solid #cbd5e1;border-radius:8px;font:inherit;font-size:16px;background:white}
    .article-body :global(.news-lead-consent){display:flex!important;align-items:flex-start;gap:8px;font-weight:400!important}
    .article-body :global(.news-lead-consent input){margin-top:5px}
    .article-body :global(.news-lead-box button){background:#a77a38;color:white;border:0;border-radius:8px;padding:13px;font-weight:700;cursor:pointer}
    .article-body :global(.news-lead-box small){font-size:12px;color:#66788a;line-height:1.5}
    .article-body :global(h2){font-size:25px;line-height:1.4;margin:30px 0 12px}
    .article-body :global(h3){font-size:20px;margin:24px 0 10px}
    .article-body :global(p){margin:0 0 18px}
    .article-body :global(img){max-width:100%;height:auto;border-radius:10px}
    .article-body :global(a){color:#17628e}
    .article-body :global(ul),.article-body :global(ol){padding-left:24px;margin-bottom:18px}
    .project-related{background:#f3f7fa;border:1px solid #e1eaf1;border-radius:12px;padding:20px;margin-top:28px}.project-related h2{font-size:19px;margin:0 0 10px;color:#193b58}.project-related a{color:#17628e;font-weight:700;text-decoration:none}.project-related p{margin:8px 0 0;color:#65788a;font-size:14px}
    @media(max-width:600px){.news-page{padding:14px 10px 45px}.news-wrap{padding:20px 16px}.lead{font-size:15px}}
  </style>
</Base>
