---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('bai-viet');
  return articles
    .filter((entry) => entry.data.status === 'published')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
const projects = (await getCollection('du-an')).filter(item => item.data.status === 'published');
const articles = (await getCollection('bai-viet')).filter(item => item.data.status === 'published' && item.id !== entry.id);
const relatedArticles = articles.sort((a, b) => {
  const score = (item: typeof a) => (data.project && item.data.project === data.project ? 2 : 0) + (data.category && item.data.category === data.category ? 1 : 0);
  return score(b) - score(a) || b.data.date.getTime() - a.data.date.getTime();
}).slice(0, 6);
const isLandArticle = data.category === 'tho-cu';
const linkedProject = data.project ? projects.find(item => item.id === data.project && item.data.status === 'published') : undefined;
const consultantHeading = isLandArticle ? 'Mua nhà Đà Nẵng' : (linkedProject?.data.title || 'Bất động sản Đà Nẵng');
const featuredProjects = [...projects].sort((a, b) => Number(b.id === data.project) - Number(a.id === data.project)).slice(0, 8);
const siteUrl = 'https://canhodanang.store';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const seoTitle = data.seoTitle?.trim() || data.title;
const description = data.description?.trim() || `Tin tức bất động sản Đà Nẵng: ${data.title}`;
const image = data.ogImage || data.image || undefined;
const dateText = data.date instanceof Date && !Number.isNaN(data.date.getTime())
  ? data.date.toISOString() : undefined;
const updatedText = data.updatedAt instanceof Date && !Number.isNaN(data.updatedAt.getTime())
  ? data.updatedAt.toISOString() : dateText;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${pageUrl}#article`,
      headline: data.title,
      description,
      mainEntityOfPage: pageUrl,
      url: pageUrl,
      ...(image ? { image: new URL(image, siteUrl).href } : {}),
      ...(dateText ? { datePublished: dateText } : {}),
      ...(updatedText ? { dateModified: updatedText } : {}),
      publisher: { '@type': 'Organization', name: 'Căn Hộ Đà Nẵng', url: siteUrl },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Tin tức', item: `${siteUrl}/tin-tuc/` },
        { '@type': 'ListItem', position: 3, name: data.title, item: pageUrl },
      ],
    },
  ],
};
---
<Base title={seoTitle} description={description} image={image} imageAlt={data.imageAlt || data.title} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <main class="news-page">
    <div class="news-layout"><article class="news-wrap">
      <nav class="breadcrumbs" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a><span aria-hidden="true">/</span>
        <a href="/tin-tuc/">Tin tức</a><span aria-hidden="true">/</span>
        <span aria-current="page">{data.title}</span>
      </nav>
      <header class="news-header">
        <h1>{data.title}</h1>
        {dateText && <time datetime={dateText}>{new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Asia/Ho_Chi_Minh' }).format(data.date)}</time>}
        <p class="lead">{description}</p>
      </header>
      {data.image && <img class="cover" src={data.image} alt={data.imageAlt || data.title} loading="eager" decoding="async" />}
      <div class="article-body"><Content /></div>
      <section class="related-articles" aria-label="Tin tức khác về dự án"><h2>{linkedProject ? `Xem tin tức khác về ${linkedProject.data.title}` : 'Xem tin tức bất động sản khác'}</h2>{relatedArticles.length > 0 && <ul>{relatedArticles.map(item => <li><a href={`/tin-tuc/${item.id}/`}>{item.data.title}</a></li>)}</ul>}<div class="related-links">{linkedProject && <a href={`/du-an/${linkedProject.id}/`}>Xem chi tiết dự án {linkedProject.data.title} →</a>}<a href="/tin-tuc/">Xem tất cả tin tức →</a></div></section>
      <footer class="news-footer">
        <a href="/">← Về trang chủ</a>
        <a href="tel:0869437415">Liên hệ tư vấn: 0869 437 415</a>
      </footer>
    </article>
    <aside class="news-sidebar" aria-label="Thông tin tư vấn và danh sách dự án">
      <div class="sidebar-sticky">
        <section class="consultant-card">
          <div class="consultant-heading"><span>{isLandArticle ? 'Tư vấn bất động sản' : 'Nhận thông tin dự án'}</span><strong>{consultantHeading}</strong></div>
          <div class="consultant-body">
            <div class="consultant-avatar"><img src="/uploads/tu-van-vien-vest.jpg" alt="Chuyên viên tư vấn bất động sản Đà Nẵng" loading="lazy" onerror="this.style.display='none'" /></div>
            <h2>Mr. Kiều Nguyễn</h2><p>Hỗ trợ thông tin dự án và căn hộ</p>
            <a class="consultant-zalo" href="https://zalo.me/0869437415" target="_blank" rel="noopener noreferrer">Chat qua Zalo</a>
            <a class="consultant-call" href="tel:0869437415">☎ 0869 437 415</a>
          </div>
        </section>
        {featuredProjects.length > 0 && <section class="sidebar-projects"><h2>Danh sách dự án</h2><ul>{featuredProjects.map(project => <li><a href={`/du-an/${project.id}/`}>{project.data.image && <img src={project.data.image} alt="" loading="lazy" />}<span>{project.data.title}</span><span aria-hidden="true">›</span></a></li>)}</ul><a class="all-projects" href="/du-an/">Xem tất cả dự án →</a></section>}
      </div>
    </aside></div>
  </main>
  <style>
    .news-page{background:#f5f8fb;min-height:65vh;padding:28px 16px 70px;color:#213547}
    .news-layout{max-width:1250px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px;align-items:start}
    .news-wrap{min-width:0;background:#fff;border-radius:16px;padding:clamp(20px,3vw,38px);box-shadow:0 4px 24px #18334d0a}
    .news-sidebar{min-width:0;position:sticky;top:88px;align-self:start}.sidebar-sticky{display:grid;gap:16px;max-height:calc(100vh - 105px);overflow-y:auto;scrollbar-width:thin}
    .consultant-card,.sidebar-projects{background:#fff;border:1px solid #e0e7ef;border-radius:14px;overflow:hidden;box-shadow:0 6px 22px #102c4915}
    .consultant-heading{background:linear-gradient(125deg,#10365e,#185d8c);color:#fff;padding:17px 14px;text-align:center;display:grid;gap:5px;font-size:16px}.consultant-heading strong{font-size:20px;color:#f4c16b;line-height:1.35}
    .consultant-body{padding:20px 16px;text-align:center}.consultant-avatar{width:150px;height:150px;margin:0 auto 14px;border:2px solid #b88b41;border-radius:50%;overflow:hidden;background:#edf3f8}.consultant-avatar img{width:100%;height:100%;object-fit:cover;object-position:center 20%}
    .consultant-body h2{font-size:17px;margin:0 0 7px;color:#17334d}.consultant-body p{font-size:13px;color:#718092;margin:0 0 16px}.consultant-zalo,.consultant-call{display:block;padding:12px;border-radius:9px;font-weight:700;text-decoration:none;margin-top:9px}.consultant-zalo{border:1px solid #b9c9dc;color:#135c99}.consultant-call{background:#009d9f;color:#fff}
    .sidebar-projects h2{margin:0;padding:15px;background:#eff5fa;color:#173d62;font-size:18px}.sidebar-projects ul{list-style:none;padding:5px 13px;margin:0}.sidebar-projects li+li{border-top:1px solid #e6edf2}.sidebar-projects li a{display:flex;gap:10px;align-items:center;padding:11px 0;color:#173d62;text-decoration:none;font-weight:650;font-size:13px}.sidebar-projects li img{width:62px;height:48px;object-fit:cover;border-radius:7px;flex-shrink:0}.sidebar-projects li a span:nth-last-child(2){flex:1}.sidebar-projects li a span:last-child{margin-left:auto;font-size:23px}.all-projects{display:block;text-align:center;margin:0 13px 14px;padding:11px;border:1px solid #9eb8d2;border-radius:8px;color:#145b90;text-decoration:none;font-weight:700;font-size:13px}
    .related-articles{margin-top:32px;padding-top:20px;border-top:1px solid #dce6ef}.related-articles h2{font-size:22px;color:#173b60;margin:0 0 14px}.related-articles ul{margin:0;padding-left:20px}.related-articles li{margin:9px 0;line-height:1.6}.related-articles a{color:#175e9b;text-decoration:none}.related-articles a:hover{text-decoration:underline}.related-links{display:flex;gap:12px 24px;flex-wrap:wrap;margin-top:16px;font-weight:650}
    @media(max-width:980px){.news-layout{grid-template-columns:minmax(0,1fr)}.news-sidebar{position:static}.sidebar-sticky{max-height:none;overflow:visible;grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:640px){.sidebar-sticky{grid-template-columns:1fr}}
    .breadcrumbs{display:flex;gap:9px;flex-wrap:wrap;color:#718092;font-size:13px;margin-bottom:24px;overflow-wrap:anywhere}
    .breadcrumbs a,.news-footer a{color:#17628e;text-decoration:none}
    .news-header h1{font-size:clamp(27px,4vw,42px);line-height:1.3;margin:0 0 16px;color:#183b58}
    .category{color:#ad7c32;font-size:13px;font-weight:700;text-transform:uppercase;margin:0}
    .news-header time{color:#6d7e8b;font-size:14px}
    .lead{font-size:17px;line-height:1.75;color:#536879;margin:20px 0 26px}
    .cover{display:block;width:100%;max-height:490px;object-fit:cover;border-radius:12px;margin-bottom:28px}
    .article-body{font-size:16px;line-height:1.85;overflow-wrap:anywhere}
    .article-body :global(h2){font-size:25px;line-height:1.4;margin:30px 0 12px}
    .article-body :global(h3){font-size:20px;margin:24px 0 10px}
    .article-body :global(p){margin:0 0 18px}
    .article-body :global(img){max-width:100%;height:auto;border-radius:10px}
    .article-body :global(a){color:#17628e}
    .article-body :global(ul),.article-body :global(ol){padding-left:24px;margin-bottom:18px}
    .project-related{background:#f3f7fa;border:1px solid #e1eaf1;border-radius:12px;padding:20px;margin-top:28px}.project-related h2{font-size:19px;margin:0 0 10px;color:#193b58}.project-related a{color:#17628e;font-weight:700;text-decoration:none}.project-related p{margin:8px 0 0;color:#65788a;font-size:14px}
    .news-footer{background:#f0f5fa;border:1px solid #dce6ef;border-radius:10px;margin-top:28px;padding:18px 20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;font-weight:600}.news-footer a{color:#145b90!important;text-decoration:none}.news-footer a:hover{text-decoration:underline}
    @media(max-width:600px){.news-page{padding:14px 10px 45px}.news-wrap{padding:20px 16px}.lead{font-size:15px}}
  </style>
</Base>
