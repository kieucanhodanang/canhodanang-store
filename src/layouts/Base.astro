
---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Căn Hộ Đà Nẵng | Mua Bán, Cho Thuê & Dự Án',
  description = 'Thông tin căn hộ Đà Nẵng mua bán, cho thuê, dự án bất động sản và thị trường nhà đất.',
  image = '/og-default.jpg',
  noindex = false,
} = Astro.props;

const siteUrl = 'https://canhodanang.store';

const canonicalUrl = new URL(
  Astro.url.pathname,
  siteUrl
).href;

const imageUrl = new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {noindex && (
      <meta name="robots" content="noindex,follow" />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Căn Hộ Đà Nẵng" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="header">
      <div class="wrap headflex">
        <a class="brand" href="/" aria-label="Căn Hộ Đà Nẵng - Trang chủ">
          CĂN HỘ ĐÀ NẴNG
        </a>

        <nav aria-label="Menu chính">
          <a href="/">Trang chủ</a>
          <a href="/can-ho/">Căn hộ</a>
          <a href="/du-an/">Dự án</a>
          <a href="/biet-thu/">Biệt thự</a>
          <a href="/nha-dat-tho-cu/">Nhà đất thổ cư</a>
          <a href="/tin-tuc/">Tin tức</a>
          <a href="/lien-he/">Liên hệ</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <h3>CĂN HỘ ĐÀ NẴNG</h3>

        <p>
          Thông tin căn hộ mua bán, cho thuê, dự án
          và bất động sản tại Đà Nẵng.
        </p>

        <p>
          Hotline:
          <a href="tel:0869437415">
            0869 437 415
          </a>
        </p>

        <p>
          Email:
          <a href="mailto:batdongsandanang8888@gmail.com">
            batdongsandanang8888@gmail.com
          </a>
        </p>

        <p>
          © {new Date().getFullYear()} canhodanang.store
        </p>
      </div>
    </footer>
  </body>
</html>
