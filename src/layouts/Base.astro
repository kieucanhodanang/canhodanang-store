---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = 'Căn Hộ Đà Nẵng | Mua Bán, Cho Thuê & Dự Án',
  description = 'Thông tin căn hộ Đà Nẵng mua bán, cho thuê, dự án bất động sản và thị trường nhà đất.',
  image = '/og-default.jpg',
  imageAlt = 'Căn Hộ Đà Nẵng',
  noindex = false,
  type = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

// Đặt đường dẫn logo sau khi tải ảnh lên public/uploads, ví dụ: '/uploads/logo-kieu-nguyen.png'.
const brandLogo = '';
const siteUrl = 'https://canhodanang.store';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(image, siteUrl).href;
const websiteId = `${siteUrl}/#website`;
const pageId = `${canonicalUrl}#webpage`;

// Dữ liệu menu và logo lấy trực tiếp từ Decap CMS khi Cloudflare build.
const projects = (await getCollection('du-an'))
  .filter((item) => item.data.status === 'published')
  .sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999)
    || a.data.title.localeCompare(b.data.title, 'vi'));

const menuProjects = projects.filter((item) => item.data.showInMenu !== false);
const logoProjects = projects
  .filter((item) => item.data.distributionStatus === 'dang-phan-phoi'
    && item.data.showLogoInFooter !== false && Boolean(item.data.logo))
  .sort((a, b) => (a.data.logoOrder ?? 999) - (b.data.logoOrder ?? 999)
    || a.data.title.localeCompare(b.data.title, 'vi'));

const projectUrl = (id: string) => `/du-an/${encodeURIComponent(id)}/`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: `${siteUrl}/`,
      name: 'Căn Hộ Đà Nẵng',
      inLanguage: 'vi-VN',
    },
    {
      '@type': 'WebPage',
      '@id': pageId,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'vi-VN',
      isPartOf: { '@id': websiteId },
      ...(image ? { primaryImageOfPage: { '@type': 'ImageObject', url: imageUrl } } : {}),
      ...(modifiedTime ? { dateModified: modifiedTime } : {}),
    },
  ],
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Căn Hộ Đà Nẵng" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="header site-gold-header">
      <div class="wrap site-header-inner">
        <a class="brand site-brand" href="/" aria-label="Căn Hộ Đà Nẵng - Trang chủ">
          {brandLogo ? <img class="site-brand-logo" src={brandLogo} alt="Logo Căn Hộ Đà Nẵng" width="44" height="44" /> : <span class="site-brand-logo-placeholder" aria-hidden="true">⌂</span>}
          <span>CĂN HỘ ĐÀ NẴNG</span>
        </a>
        <button class="mobile-menu-toggle" type="button" aria-expanded="false"
          aria-controls="site-main-nav" aria-label="Mở menu">
          <span class="hamburger-lines" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
        <nav id="site-main-nav" class="site-main-nav" aria-label="Menu chính">
          <a class="mobile-primary-link" href="/mua-ban/">Mua bán</a>
          <a class="mobile-primary-link" href="/cho-thue/">Cho thuê</a>
          <details class="site-dropdown mobile-secondary-link">
            <summary>Dự án <span class="nav-chevron" aria-hidden="true"></span></summary>
            <div class="site-dropdown-panel">
              {menuProjects.map((project) => <a href={projectUrl(project.id)}>{project.data.title}</a>)}
              <a class="all-projects" href="/du-an/">Xem tất cả dự án</a>
            </div>
          </details>
          <a class="mobile-secondary-link" href="/nha-dat-tho-cu/">Nhà đất</a>
          <a class="mobile-secondary-link" href="/tin-tuc/">Tin tức</a>
          <a class="mobile-secondary-link nav-contact" href="tel:0869437415"><span class="phone-icon" aria-hidden="true">☎</span> Liên hệ 0869 437 415</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-layout">
        <section class="footer-projects" aria-label="Dự án đang phân phối">
          <h2>DỰ ÁN ĐANG PHÂN PHỐI</h2>
          {logoProjects.length > 0 ? (
            <div class="footer-carousel" data-footer-carousel>
              <div class="footer-logo-track">
                {logoProjects.map((project) => (
                  <a class="footer-logo-item" href={projectUrl(project.id)}
                    aria-label={`Giới thiệu dự án ${project.data.title}`}>
                    <img src={project.data.logo!}
                      alt={project.data.logoAlt || `Logo dự án ${project.data.title}`}
                      loading="lazy" decoding="async" />
                  </a>
                ))}
              </div>
              {logoProjects.length > 3 && (
                <div class="footer-carousel-actions">
                  <button type="button" data-slide-prev aria-label="Xem logo dự án trước">‹</button>
                  <button type="button" data-slide-next aria-label="Xem logo dự án tiếp theo">›</button>
                </div>
              )}
            </div>
          ) : (
            <p class="footer-empty">Logo dự án sẽ hiển thị khi được cập nhật trong mục Dự án.</p>
          )}
        </section>
        <section class="footer-contact" aria-label="Thông tin liên hệ">
          <h2>THÔNG TIN LIÊN HỆ</h2>
          <p class="footer-contact-name">CĂN HỘ ĐÀ NẴNG</p>
          <p class="footer-mobile-owner">Mr. Kiều Nguyễn</p>
          <p>Hotline: <a href="tel:0869437415">0869 437 415</a></p>
          <p>Email: <a href="mailto:batdongsandanang8888@gmail.com">batdongsandanang8888@gmail.com</a></p>
          <p class="footer-copyright">© {new Date().getFullYear()} canhodanang.store. Bảo lưu mọi quyền.</p>
        </section>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const toggle = document.querySelector('.mobile-menu-toggle');
        const nav = document.getElementById('site-main-nav');
        if (toggle && nav) {
          toggle.addEventListener('click', () => {
            const open = toggle.getAttribute('aria-expanded') !== 'true';
            toggle.setAttribute('aria-expanded', String(open));
            nav.classList.toggle('is-open', open);
          });
        }

        const dropdowns = document.querySelectorAll('.site-dropdown');
        const desktopHover = window.matchMedia('(min-width: 1151px) and (hover: hover) and (pointer: fine)');
        dropdowns.forEach((dropdown) => {
          // Desktop: mở ngay khi rê chuột, đóng khi chuột rời menu và submenu.
          dropdown.addEventListener('mouseenter', () => {
            if (!desktopHover.matches) return;
            dropdowns.forEach((other) => { if (other !== dropdown) other.open = false; });
            dropdown.open = true;
          });
          dropdown.addEventListener('mouseleave', () => {
            if (desktopHover.matches) dropdown.open = false;
          });
          dropdown.addEventListener('toggle', () => {
            if (dropdown.open) dropdowns.forEach((other) => {
              if (other !== dropdown) other.open = false;
            });
          });
        });
        document.addEventListener('click', (event) => {
          dropdowns.forEach((dropdown) => {
            if (!dropdown.contains(event.target)) dropdown.open = false;
          });
        });

        const carousel = document.querySelector('[data-footer-carousel]');
        if (!carousel) return;
        const track = carousel.querySelector('.footer-logo-track');
        const items = [...track.querySelectorAll('.footer-logo-item')];
        if (items.length <= 3) return;
        let current = 0;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const move = (delta) => {
          current = (current + delta + items.length) % items.length;
          const item = items[current];
          track.scrollTo({ left: item.offsetLeft - track.offsetLeft, behavior: reduceMotion ? 'instant' : 'smooth' });
        };
        carousel.querySelector('[data-slide-prev]')?.addEventListener('click', () => move(-1));
        carousel.querySelector('[data-slide-next]')?.addEventListener('click', () => move(1));
        if (!reduceMotion) {
          let timer;
          const start = () => { if (!timer) timer = window.setInterval(() => move(1), 4000); };
          const stop = () => { window.clearInterval(timer); timer = undefined; };
          carousel.addEventListener('mouseenter', stop);
          carousel.addEventListener('mouseleave', start);
          carousel.addEventListener('focusin', stop);
          carousel.addEventListener('focusout', start);
          document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
          start();
        }
      })();
    </script>

    <style>
      .site-gold-header { background:#a77a38; color:#fff; border-bottom:1px solid #8c642e; }
      .site-header-inner { display:flex; align-items:center; justify-content:space-between; gap:20px; min-height:82px; }
      .site-brand { display:inline-flex; align-items:center; gap:11px; color:#fff !important; text-decoration:none; font-size:clamp(16px,1.5vw,23px); font-weight:800; white-space:nowrap; }
      .site-brand-logo, .site-brand-logo-placeholder { width:44px; height:44px; flex:0 0 44px; object-fit:contain; background:#fff; color:#a77a38; border-radius:8px; }
      .site-brand-logo-placeholder { display:grid; place-items:center; font-size:27px; }
      .site-main-nav { display:flex; align-items:center; gap:clamp(8px,1.2vw,21px); }
      .site-main-nav > a, .site-dropdown > summary {
        font-size:clamp(14px,1.05vw,17px); font-weight:700; text-decoration:none; white-space:nowrap; cursor:pointer;
        color:#fff !important;
      }
      .site-main-nav > a:hover, .site-dropdown > summary:hover { color:#fff5d8 !important; }
      .site-dropdown { position:relative; }
      .site-dropdown > summary { list-style:none; display:flex; align-items:center; gap:5px; }
      .site-dropdown > summary::-webkit-details-marker { display:none; }
      .nav-chevron {
        width:7px; height:7px; display:inline-block; flex:0 0 7px;
        border-right:1.7px solid currentColor; border-bottom:1.7px solid currentColor;
        transform:translateY(-2px) rotate(45deg); transition:transform .18s ease;
      }
      .site-dropdown[open] > summary .nav-chevron { transform:translateY(2px) rotate(225deg); }
      .site-dropdown-panel {
        position:absolute; z-index:50; top:100%; left:0; min-width:235px;
        max-width:min(340px,90vw); padding:9px; background:#fff; color:#172b40;
        border:1px solid #e6e9ed; border-top:3px solid #d4a85e; border-radius:0 0 9px 9px; box-shadow:0 14px 35px #0b203326;
        display:flex; flex-direction:column;
      }
      .site-dropdown-panel a { padding:13px 14px; text-decoration:none; color:#172b40 !important; border-radius:6px; font-size:14px; }
      .site-dropdown-panel a:hover, .site-dropdown-panel a:focus-visible { background:#f0f4f8; }
      .site-dropdown-panel .all-projects { border-top:1px solid #e5eaf0; margin-top:4px; color:#956c27 !important; }
      .mobile-menu-toggle { display:none; }
      .nav-contact { background:#8e632b; border-radius:7px; padding:12px 13px; }
      .phone-icon { font-size:18px; margin-right:4px; }
      @media (min-width:1151px) {
        .site-dropdown:hover .site-dropdown-panel { display:flex; }
      }
      .hamburger-lines { display:flex; flex-direction:column; gap:5px; }
      .hamburger-lines i { display:block; width:25px; height:3px; background:#fff; border-radius:3px; }
      .site-footer { background:#10243a; color:#e8eef5; padding:38px 0; }
      .footer-layout { display:grid; grid-template-columns:minmax(0,3fr) minmax(0,2fr); gap:36px; }
      .site-footer h2 { color:#d4a85e; font-size:15px; letter-spacing:.035em; margin:0 0 20px; }
      .footer-logo-track { display:flex; gap:12px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
      .footer-logo-track::-webkit-scrollbar { display:none; }
      .footer-logo-item {
        flex:0 0 calc((100% - 24px)/3); height:108px; box-sizing:border-box; background:#fff;
        border-radius:10px; padding:12px; display:flex; align-items:center; justify-content:center;
        scroll-snap-align:start;
      }
      .footer-logo-item img { display:block; width:100%; height:100%; object-fit:contain; }
      .footer-carousel-actions { display:flex; justify-content:flex-end; gap:10px; margin-top:10px; }
      .footer-carousel-actions button {
        border:1px solid #728398; border-radius:7px; background:transparent; color:#fff;
        min-width:36px; min-height:36px; font-size:24px; cursor:pointer;
      }
      .footer-contact p { margin:0 0 12px; overflow-wrap:anywhere; }
      .footer-contact a { color:inherit; }
      .footer-contact-name { font-weight:700; }
      .footer-copyright { font-size:12px; color:#bac7d6; padding-top:12px; }
      .footer-mobile-owner { display:none; }
      .footer-empty { color:#bac7d6; font-size:13px; }
      @media (max-width:1150px) {
        .site-header-inner { flex-wrap:wrap; gap:0; padding-top:12px; padding-bottom:8px; }
        .site-brand { flex:1; font-size:clamp(16px,4vw,22px); }
        .mobile-menu-toggle { display:inline-flex; align-items:center; justify-content:center; min-width:48px; min-height:48px;
          border:1px solid #e5c98c; border-radius:8px; background:#956b32; cursor:pointer; }
        .site-main-nav { display:grid; flex:0 0 100%; width:100%; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0; padding-top:10px; }
        .site-main-nav > .mobile-primary-link { display:flex; align-items:center; justify-content:center; min-height:52px; font-size:16px; border-top:1px solid #c49a59; }
        .site-main-nav > .mobile-primary-link:first-child { border-right:1px solid #c49a59; }
        .site-main-nav.is-open > .mobile-secondary-link { border-top:1px solid #c49a59; font-size:16px; }
        .site-main-nav.is-open > .mobile-secondary-link > summary { width:100%; box-sizing:border-box; }
        .site-main-nav.is-open > .mobile-secondary-link:not(details) { display:flex; }
        .site-main-nav > .mobile-secondary-link { display:none; }
        .site-main-nav.is-open > .mobile-secondary-link { display:flex; }
        .site-main-nav.is-open > details.mobile-secondary-link { display:block; }
        .site-main-nav.is-open > .mobile-secondary-link { grid-column:1/-1; }
        .site-main-nav.is-open > .nav-contact { border-radius:0; background:transparent; }
        .site-main-nav > .mobile-secondary-link, .site-dropdown > summary { min-height:50px; padding:0 12px; align-items:center; }
        .site-dropdown > summary { display:flex; }
        .site-dropdown-panel { position:static; max-width:none; box-shadow:none; min-width:0; margin:0 8px 8px; }
        .site-dropdown-panel a { min-height:44px; display:flex; align-items:center; }
      }
      @media (max-width:767px) {
        .footer-layout { grid-template-columns:minmax(0,1fr); gap:30px; }
        .site-brand-logo, .site-brand-logo-placeholder { width:38px; height:38px; flex-basis:38px; }
        .site-brand { font-size:17px; }
        .footer-logo-item { height:78px; padding:6px; }
        .footer-mobile-owner { display:block; color:#d4a85e; font-size:19px; font-weight:700; }
      }
    </style>
  </body>
</html>
