---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import homepage from '../data/homepage.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = 'Căn Hộ Đà Nẵng | Mua Bán, Cho Thuê & Dự Án',
  description = 'Thông tin căn hộ Đà Nẵng mua bán, cho thuê, dự án bất động sản và thị trường nhà đất.',
  image = '/og-default.jpg',
  imageAlt = 'Căn Hộ Đà Nẵng',
  noindex = false,
  type = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

// Đặt đường dẫn logo sau khi tải ảnh lên public/uploads, ví dụ: '/uploads/logo-kieu-nguyen.png'.
const brandLogo = '';
const siteUrl = 'https://canhodanang.store';
// Thống nhất canonical theo dạng URL có dấu / cuối (trừ đường dẫn tệp).
const pathname = Astro.url.pathname;
const canonicalPath = pathname === '/' || pathname.endsWith('/') || /\/[^/]+\.[a-z0-9]+$/i.test(pathname)
  ? pathname
  : `${pathname}/`;
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const imageUrl = new URL(image, siteUrl).href;
const websiteId = `${siteUrl}/#website`;
const organizationId = `${siteUrl}/#organization`;
const pageId = `${canonicalUrl}#webpage`;

// Dữ liệu menu và logo lấy trực tiếp từ Decap CMS khi Cloudflare build.
const projects = (await getCollection('du-an'))
  .filter((item) => item.data.status === 'published')
  .sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999)
    || a.data.title.localeCompare(b.data.title, 'vi'));

const menuProjects = projects.filter((item) => item.data.showInMenu !== false && item.data.distributionStatus === 'dang-phan-phoi');
const logoProjects = projects
  .filter((item) => item.data.distributionStatus === 'dang-phan-phoi'
    && item.data.showLogoInFooter !== false && Boolean(item.data.logo))
  .sort((a, b) => (a.data.logoOrder ?? 999) - (b.data.logoOrder ?? 999)
    || a.data.title.localeCompare(b.data.title, 'vi'));

// Banner nổi hai bên: đọc cấu hình từ homepage.json (sẽ thêm trường qua CMS ở bước kế tiếp).
type FloatingBanner = { enabled?: boolean; image?: string; link?: string; alt?: string };
const bannerSettings = (homepage as typeof homepage & {
  floatingBanners?: { left?: FloatingBanner; right?: FloatingBanner };
}).floatingBanners;
const floatingBanners = ([
  { side: 'left', config: bannerSettings?.left },
  { side: 'right', config: bannerSettings?.right },
] as const).filter(({ config }) => config?.enabled === true && Boolean(config.image?.trim()));
const safeBannerLink = (value?: string) => {
  if (!value) return '#';
  const link = value.trim();
  return link.startsWith('/') && !link.startsWith('//') ? link
    : /^https:\/\//i.test(link) ? link : '#';
};
const projectUrl = (id: string) => `/du-an/${encodeURIComponent(id)}/`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Căn Hộ Đà Nẵng',
      url: `${siteUrl}/`,
      email: 'batdongsandanang8888@gmail.com',
      telephone: '+84869437415',
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+84869437415',
        contactType: 'customer service',
        availableLanguage: 'Vietnamese',
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: `${siteUrl}/`,
      name: 'Căn Hộ Đà Nẵng',
      inLanguage: 'vi-VN',
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'WebPage',
      '@id': pageId,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'vi-VN',
      isPartOf: { '@id': websiteId },
      publisher: { '@id': organizationId },
      ...(publishedTime ? { datePublished: publishedTime } : {}),
      ...(image ? { primaryImageOfPage: { '@type': 'ImageObject', url: imageUrl } } : {}),
      ...(modifiedTime ? { dateModified: modifiedTime } : {}),
    },
  ],
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Căn Hộ Đà Nẵng" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="header site-gold-header">
      <div class="wrap site-header-inner">
        <a class="brand site-brand" href="/" aria-label="Căn Hộ Đà Nẵng - Trang chủ">
          {brandLogo ? <img class="site-brand-logo" src={brandLogo} alt="Logo Căn Hộ Đà Nẵng" width="44" height="44" /> : <span class="site-brand-logo-placeholder" aria-hidden="true">⌂</span>}
          <span>CĂN HỘ ĐÀ NẴNG</span>
        </a>
        <button class="mobile-menu-toggle" type="button" aria-expanded="false"
          aria-controls="site-main-nav" aria-label="Mở menu">
          <span class="hamburger-lines" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
        <nav id="site-main-nav" class="site-main-nav" aria-label="Menu chính">
          <details class="site-dropdown">
            <summary>Dự án đang bán <span class="nav-chevron" aria-hidden="true"></span></summary>
            <div class="site-dropdown-panel">
              {menuProjects.map((project) => <a href={projectUrl(project.id)}>{project.data.title}</a>)}
              <a class="all-projects" href="/du-an/">Xem tất cả dự án</a>
            </div>
          </details>
          <a href="/cho-thue/">Cho thuê</a>
          <a href="/nha-dat-tho-cu/">Nhà đất</a>
          <a class="nav-contact" href="tel:0869437415">Liên hệ 0869 437 415</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    {floatingBanners.length > 0 && (
      <aside class="floating-ads" aria-label="Banner giới thiệu dự án">
        {floatingBanners.map(({ side, config }) => (
          <div class={`floating-ad floating-ad--${side}`} data-floating-ad>
            <button type="button" class="floating-ad-close" aria-label={`Đóng banner ${side === 'left' ? 'bên trái' : 'bên phải'}`} data-floating-close>×</button>
            <a href={safeBannerLink(config?.link)} aria-label={config?.alt || 'Xem thông tin dự án'} rel={safeBannerLink(config?.link).startsWith('https://') ? 'noopener noreferrer' : undefined}>
              <img src={config!.image} alt={config?.alt || 'Banner dự án'} width="210" height="500" loading="lazy" decoding="async" />
            </a>
          </div>
        ))}
      </aside>
    )}

    <footer class="site-footer">
      <div class="wrap footer-layout">
        <section class="footer-projects" aria-label="Dự án đang phân phối">
          <h2>DỰ ÁN ĐANG PHÂN PHỐI</h2>
          {logoProjects.length > 0 ? (
            <div class="footer-carousel" data-footer-carousel>
              <div class="footer-logo-track">
                {logoProjects.map((project) => (
                  <a class="footer-logo-item" href={projectUrl(project.id)}
                    aria-label={`Giới thiệu dự án ${project.data.title}`}>
                    <img src={project.data.logo!}
                      alt={project.data.logoAlt || `Logo dự án ${project.data.title}`}
                      loading="lazy" decoding="async" />
                  </a>
                ))}
              </div>
              {logoProjects.length > 3 && (
                <div class="footer-carousel-actions">
                  <button type="button" data-slide-prev aria-label="Xem logo dự án trước">‹</button>
                  <button type="button" data-slide-next aria-label="Xem logo dự án tiếp theo">›</button>
                </div>
              )}
            </div>
          ) : (
            <p class="footer-empty">Logo dự án sẽ hiển thị khi được cập nhật trong mục Dự án.</p>
          )}
        </section>
        <section class="footer-contact" aria-label="Thông tin liên hệ">
          <h2>THÔNG TIN LIÊN HỆ</h2>
          <p class="footer-contact-name">CĂN HỘ ĐÀ NẴNG</p>
          <p class="footer-mobile-owner">Mr. Kiều Nguyễn</p>
          <p>Hotline: <a href="tel:0869437415">0869 437 415</a></p>
          <p>Email: <a href="mailto:batdongsandanang8888@gmail.com">batdongsandanang8888@gmail.com</a></p>
          <p class="footer-copyright">© {new Date().getFullYear()} canhodanang.store. Bảo lưu mọi quyền.</p>
        </section>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const ads = [...document.querySelectorAll('[data-floating-ad]')];
        if (!ads.length) return;
        const desktop = window.matchMedia('(min-width: 1600px)');
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        const hero = document.querySelector('.cms-hero, .hero');
        const footer = document.querySelector('.site-footer');
         const contentCandidates = [...document.querySelectorAll('main .wrap, main .container, main .content-wrap, .site-header-inner')];
         const bannerWidth = 210;
         const safeGap = 12;
         const edgeGap = 8;
         const measureContent = () => {
           const candidates = contentCandidates.map((element) => element.getBoundingClientRect())
             .filter((rect) => rect.width >= 600 && rect.width < window.innerWidth - 24);
           if (!candidates.length) return null;
           // Chọn khung nội dung rộng nhất để không chồng lên các khối khác.
           return candidates.reduce((widest, rect) => rect.width > widest.width ? rect : widest);
         };
        const closed = new WeakSet();
        let queued = false;
        const update = () => {
          queued = false;
          const viewport = window.innerHeight;
          const heroBottom = hero ? hero.getBoundingClientRect().bottom : 0;
          const passedTop = hero ? heroBottom < 0 : window.scrollY > 320;
          const footerTop = footer ? footer.getBoundingClientRect().top : Infinity;
          // Mờ dần trong 220px trước vùng cuối trang; ẩn trước khi chạm footer.
          const fadeOut = Math.max(0, Math.min(1, (footerTop - viewport * 0.76) / 220));
          const opacity = desktop.matches && passedTop ? fadeOut : 0;
          ads.forEach((ad) => {
            const value = closed.has(ad) ? 0 : opacity;
            ad.style.opacity = String(value);
            ad.style.transform = `translateY(-50%) translateX(${(1 - value) * (ad.classList.contains('floating-ad--left') ? -18 : 18)}px)`;
            ad.style.pointerEvents = value > 0.98 ? 'auto' : 'none';
            ad.setAttribute('aria-hidden', value < 0.01 ? 'true' : 'false');
            ad.querySelectorAll('a,button').forEach((control) => {
              control.tabIndex = value > 0.98 ? 0 : -1;
            });
          });
        };
        const requestUpdate = () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(update);
          }
        };
        ads.forEach((ad) => ad.querySelector('[data-floating-close]')?.addEventListener('click', () => {
          closed.add(ad);
          requestUpdate();
        }));
        window.addEventListener('scroll', requestUpdate, { passive: true });
        window.addEventListener('resize', requestUpdate, { passive: true });
        desktop.addEventListener('change', requestUpdate);
        reduced.addEventListener('change', requestUpdate);
        requestUpdate();
      })();
    </script>
    <script is:inline>
      (() => {
        // Desktop: chỉ thu chiều cao header khi cuộn, giữ nguyên toàn bộ menu.
        const header = document.querySelector('.site-gold-header');
        const desktopHeader = window.matchMedia('(min-width: 1151px)');
        let scrollPending = false;
        const updateHeader = () => {
          if (header) header.classList.toggle('is-compact', desktopHeader.matches && window.scrollY > 80);
          scrollPending = false;
        };
        window.addEventListener('scroll', () => {
          if (!scrollPending) {
            scrollPending = true;
            window.requestAnimationFrame(updateHeader);
          }
        }, { passive: true });
        desktopHeader.addEventListener('change', updateHeader);
        updateHeader();

        const toggle = document.querySelector('.mobile-menu-toggle');
        const nav = document.getElementById('site-main-nav');
        if (toggle && nav) {
          toggle.addEventListener('click', () => {
            const open = toggle.getAttribute('aria-expanded') !== 'true';
            toggle.setAttribute('aria-expanded', String(open));
            nav.classList.toggle('is-open', open);
          });
        }

        const dropdowns = document.querySelectorAll('.site-dropdown');
        const desktopHover = window.matchMedia('(min-width: 1151px) and (hover: hover) and (pointer: fine)');
        dropdowns.forEach((dropdown) => {
          // Desktop: mở ngay khi rê chuột, đóng khi chuột rời menu và submenu.
          dropdown.addEventListener('mouseenter', () => {
            if (!desktopHover.matches) return;
            dropdowns.forEach((other) => { if (other !== dropdown) other.open = false; });
            dropdown.open = true;
          });
          dropdown.addEventListener('mouseleave', () => {
            if (desktopHover.matches) dropdown.open = false;
          });
          dropdown.addEventListener('toggle', () => {
            if (dropdown.open) dropdowns.forEach((other) => {
              if (other !== dropdown) other.open = false;
            });
          });
        });
        document.addEventListener('click', (event) => {
          dropdowns.forEach((dropdown) => {
            if (!dropdown.contains(event.target)) dropdown.open = false;
          });
        });

        const carousel = document.querySelector('[data-footer-carousel]');
        if (!carousel) return;
        const track = carousel.querySelector('.footer-logo-track');
        const items = [...track.querySelectorAll('.footer-logo-item')];
        if (items.length <= 3) return;
        let current = 0;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const move = (delta) => {
          current = (current + delta + items.length) % items.length;
          const item = items[current];
          track.scrollTo({ left: item.offsetLeft - track.offsetLeft, behavior: reduceMotion ? 'instant' : 'smooth' });
        };
        carousel.querySelector('[data-slide-prev]')?.addEventListener('click', () => move(-1));
        carousel.querySelector('[data-slide-next]')?.addEventListener('click', () => move(1));
        if (!reduceMotion) {
          let timer;
          const start = () => { if (!timer) timer = window.setInterval(() => move(1), 4000); };
          const stop = () => { window.clearInterval(timer); timer = undefined; };
          carousel.addEventListener('mouseenter', stop);
          carousel.addEventListener('mouseleave', start);
          carousel.addEventListener('focusin', stop);
          carousel.addEventListener('focusout', start);
          document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
          start();
        }
      })();
    </script>

    <style>
      .site-gold-header { position:sticky; top:0; z-index:1000; width:100%; background:#a77a38; color:#fff; border-bottom:1px solid #8c642e; box-shadow:0 3px 12px #00000012; }
      .site-header-inner { display:flex; align-items:center; justify-content:space-between; gap:14px; height:84px; min-height:0; flex-wrap:nowrap; padding-top:0; padding-bottom:0; transition:height .22s ease; }
      .site-brand { display:inline-flex; align-items:center; gap:11px; color:#fff !important; text-decoration:none; font-size:clamp(16px,1.4vw,21px); font-weight:800; white-space:nowrap; flex:0 0 auto; }
      .site-brand-logo, .site-brand-logo-placeholder { width:44px; height:44px; flex:0 0 44px; object-fit:contain; background:#fff; color:#a77a38; border-radius:8px; transition:width .22s ease,height .22s ease,flex-basis .22s ease; }
      .site-brand-logo-placeholder { display:grid; place-items:center; font-size:27px; }
      .site-main-nav { display:flex; flex:0 0 auto; min-width:0; flex-wrap:nowrap; align-items:center; justify-content:flex-end; gap:clamp(10px,1.2vw,20px); }
      .site-main-nav > a, .site-dropdown > summary {
        font-size:16px; font-weight:700; text-decoration:none; white-space:nowrap; cursor:pointer;
        color:#fff !important;
      }
      .site-main-nav > a:hover, .site-dropdown > summary:hover { color:#fff5d8 !important; }
      .site-dropdown { position:relative; }
      .site-dropdown > summary { list-style:none; display:flex; align-items:center; gap:5px; }
      .site-dropdown > summary::-webkit-details-marker { display:none; }
      .nav-chevron {
        width:7px; height:7px; display:inline-block; flex:0 0 7px;
        border-right:1.7px solid currentColor; border-bottom:1.7px solid currentColor;
        transform:translateY(-2px) rotate(45deg); transition:transform .18s ease;
      }
      .site-dropdown[open] > summary .nav-chevron { transform:translateY(2px) rotate(225deg); }
      .site-dropdown-panel {
        position:absolute; z-index:50; top:100%; left:0; min-width:235px;
        max-width:min(340px,90vw); padding:9px; background:#fff; color:#172b40;
        border:1px solid #e6e9ed; border-top:3px solid #d4a85e; border-radius:0 0 9px 9px; box-shadow:0 14px 35px #0b203326;
        display:flex; flex-direction:column;
      }
      .site-dropdown-panel a { padding:13px 14px; text-decoration:none; color:#172b40 !important; border-radius:6px; font-size:14px; }
      .site-dropdown-panel a:hover, .site-dropdown-panel a:focus-visible { background:#f0f4f8; }
      .site-dropdown-panel .all-projects { border-top:1px solid #e5eaf0; margin-top:4px; color:#956c27 !important; }
      .mobile-menu-toggle { display:none; }
      .nav-contact { background:#8e632b; border-radius:7px; padding:12px 13px; }
      .phone-icon { font-size:18px; margin-right:4px; }
      /* Desktop: một hàng duy nhất, logo trái – menu phải, không xuống dòng. */
      @media (min-width:1151px) {
        .site-gold-header .site-header-inner { display:flex !important; flex-direction:row !important; flex-wrap:nowrap !important; align-items:center !important; justify-content:space-between !important; }
        .site-gold-header .site-brand { flex:0 0 auto !important; width:auto !important; }
        .site-gold-header .mobile-menu-toggle { display:none !important; }
        .site-gold-header .site-main-nav { display:flex !important; flex:0 0 auto !important; flex-direction:row !important; flex-wrap:nowrap !important; align-items:center !important; width:auto !important; margin:0 !important; padding:0 !important; }
        .site-gold-header .site-main-nav > a, .site-gold-header .site-dropdown { flex:0 0 auto; }
        .site-gold-header .site-dropdown > summary { white-space:nowrap; }
        .site-gold-header.is-compact .site-header-inner { height:58px; }
        .site-dropdown:hover .site-dropdown-panel { display:flex; }
      }
      .hamburger-lines { display:flex; flex-direction:column; gap:5px; }
      .hamburger-lines i { display:block; width:25px; height:3px; background:#fff; border-radius:3px; }
      .floating-ad {
        position:fixed; z-index:90; top:50%; width:210px; height:500px;
        opacity:0; pointer-events:none; transform:translateY(-50%);
        transition:opacity .45s ease, transform .45s ease;
        filter:drop-shadow(0 5px 16px #0a253330);
      }
      .floating-ad--left { left:8px; }
      .floating-ad--right { right:8px; }
      .floating-ad a { display:block; width:100%; height:100%; border-radius:9px; overflow:hidden; }
      .floating-ad img { display:block; width:100%; height:100%; object-fit:cover; }
      .floating-ad-close {
        position:absolute; z-index:1; right:-9px; top:-10px; width:29px; height:29px;
        border:1px solid #d9e1e8; border-radius:50%; background:#fff; color:#24384d;
        font-size:22px; line-height:1; cursor:pointer;
      }
      @media (max-width:1599px) { .floating-ads { display:none; } }
      @media (prefers-reduced-motion:reduce) { .floating-ad { transition:none; } }
      .site-footer { background:#10243a; color:#e8eef5; padding:38px 0; }
      .footer-layout { display:grid; grid-template-columns:minmax(0,3fr) minmax(0,2fr); gap:36px; }
      .site-footer h2 { color:#d4a85e; font-size:15px; letter-spacing:.035em; margin:0 0 20px; }
      .footer-logo-track { display:flex; gap:12px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
      .footer-logo-track::-webkit-scrollbar { display:none; }
      .footer-logo-item {
        flex:0 0 calc((100% - 24px)/3); height:108px; box-sizing:border-box; background:#fff;
        border-radius:10px; padding:12px; display:flex; align-items:center; justify-content:center;
        scroll-snap-align:start;
      }
      .footer-logo-item img { display:block; width:100%; height:100%; object-fit:contain; }
      .footer-carousel-actions { display:flex; justify-content:flex-end; gap:10px; margin-top:10px; }
      .footer-carousel-actions button {
        border:1px solid #728398; border-radius:7px; background:transparent; color:#fff;
        min-width:36px; min-height:36px; font-size:24px; cursor:pointer;
      }
      .footer-contact p { margin:0 0 12px; overflow-wrap:anywhere; }
      .footer-contact a { color:inherit; }
      .footer-contact-name { font-weight:700; }
      .footer-copyright { font-size:12px; color:#bac7d6; padding-top:12px; }
      .footer-mobile-owner { display:none; }
      .footer-empty { color:#bac7d6; font-size:13px; }
      @media (prefers-reduced-motion:reduce) {
        .site-header-inner,.site-brand-logo,.site-brand-logo-placeholder { transition:none; }
      }
      @media (min-width:1151px) and (max-width:1350px) {
        .site-brand { font-size:17px; }
        .site-main-nav { gap:10px; }
        .site-main-nav > a, .site-dropdown > summary { font-size:14px; }
        .nav-contact { padding:10px 9px; }
      }
      @media (max-width:1150px) {
        .site-header-inner { height:auto; min-height:72px; flex-wrap:wrap; gap:0; padding-top:12px; padding-bottom:8px; }
        .site-brand { flex:1; font-size:clamp(16px,4vw,22px); }
