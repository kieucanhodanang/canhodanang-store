---
/**
 * Shared property detail UI for can-ho and nha-dat-tho-cu.
 * Usage: <PropertyDetail property={entry.data} kind="can-ho"><Content /></PropertyDetail>
 * kind: 'can-ho' | 'nha-dat-tho-cu'
 */
interface Property {
  title: string;
  description?: string | null;
  image?: string | null;
  imageAlt?: string | null;
  gallery?: string[] | null;
  price?: string | null;
  priceValue?: number | null; // million VND
  area?: string | null;
  areaValue?: number | null; // square metres
  bedrooms?: number | null;
  bathrooms?: number | null;
  floors?: number | null;
  frontage?: string | null;
  roadWidth?: string | null;
  balconyDirection?: string | null;
  furniture?: string | null;
  interior?: string | null;
  address?: string | null;
  district?: string | null;
  ward?: string | null;
  direction?: string | null;
  legal?: string | null;
  transaction?: 'ban' | 'cho-thue' | 'cho-thue-ngay';
  listingStatus?: 'available' | 'closed' | 'paused';
  propertyType?: string | null;
}
interface Props {
  property: Property;
  kind?: 'can-ho' | 'nha-dat-tho-cu';
  phone?: string;
  zalo?: string;
}
const {
  property,
  kind = 'can-ho',
  phone = '0869437415',
  zalo = '0869437415',
} = Astro.props;
const gallery = Array.from(new Set([property.image, ...(property.gallery ?? [])].filter((item): item is string => typeof item === 'string' && item.trim().length > 0)));
const isSale = (property.transaction ?? 'ban') === 'ban';
const pricePerSqm = isSale && typeof property.priceValue === 'number' && property.priceValue > 0 && typeof property.areaValue === 'number' && property.areaValue > 0
  ? new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 2 }).format(property.priceValue / property.areaValue)
  : null;
const areaLabel = kind === 'can-ho' ? 'Diện tích' : 'Diện tích đất';
// Bổ sung m² cho diện tích dạng số hoặc chuỗi chưa có đơn vị.
const formatArea = (value: string | number | null | undefined): string | null => {
  if (value === null || value === undefined || String(value).trim() === '') return null;
  const text = String(value).trim();
  if (/^(?:\d+(?:[.,]\d+)?)(?:\s*(?:m²|m2|㎡))?$/i.test(text)) {
    return `${text.replace(/\s*(?:m²|m2|㎡)$/i, '')} m²`;
  }
  return text;
};
const formattedArea = formatArea(property.area) ?? formatArea(property.areaValue);
const specs = [
  { label: isSale ? 'Giá bán' : 'Giá thuê', value: property.price || 'Liên hệ', price: true },
  { label: areaLabel, value: formattedArea ?? 'Đang cập nhật' },
  kind === 'can-ho'
    ? { label: 'Phòng ngủ', value: typeof property.bedrooms === 'number' ? `${property.bedrooms} PN` : 'Đang cập nhật' }
    : { label: 'Số tầng', value: typeof property.floors === 'number' ? `${property.floors} tầng` : 'Đang cập nhật' },
];
// Chỉ hiển thị thông số thực sự có dữ liệu trong CMS.
const details = [
  { icon: 'tag', label: isSale ? 'Giá bán' : 'Giá thuê', value: property.price },
  { icon: 'area', label: areaLabel, value: formattedArea },
  { icon: 'bed', label: 'Số phòng ngủ', value: property.bedrooms != null ? `${property.bedrooms} phòng` : null },
  { icon: 'bath', label: 'Số phòng tắm, vệ sinh', value: property.bathrooms != null ? `${property.bathrooms} phòng` : null },
  { icon: 'floors', label: 'Số tầng', value: kind !== 'can-ho' && property.floors != null ? `${property.floors} tầng` : null },
  { icon: 'compass', label: kind === 'can-ho' ? 'Hướng căn hộ' : 'Hướng nhà', value: property.direction },
  { icon: 'compass', label: 'Hướng ban công', value: property.balconyDirection },
  { icon: 'frontage', label: 'Mặt tiền', value: kind !== 'can-ho' ? property.frontage : null },
  { icon: 'road', label: 'Đường vào', value: kind !== 'can-ho' ? property.roadWidth : null },
  { icon: 'legal', label: 'Pháp lý', value: property.legal },
  { icon: 'furniture', label: 'Nội thất', value: property.interior ?? property.furniture },
  { icon: 'home', label: 'Loại hình', value: property.propertyType },
  { icon: 'location', label: 'Địa chỉ', value: property.address },
  { icon: 'location', label: 'Phường / xã', value: property.ward },
  { icon: 'location', label: 'Khu vực', value: property.district },
].filter((item) => item.value !== null && item.value !== undefined && String(item.value).trim() !== '');
const uniqueId = `property-${Math.random().toString(36).slice(2, 10)}`;
---

<section class="property-detail" data-property-detail={uniqueId} aria-label={`Thông tin ${property.title}`}>
  {gallery.length > 0 && (
    <div class="property-gallery" aria-label="Thư viện hình ảnh bất động sản">
      <div class="gallery-main">
        <img class="gallery-featured" src={gallery[0]} alt={property.imageAlt || property.title} loading="eager" decoding="async" />
        {gallery.length > 1 && (
          <>
            <button type="button" class="gallery-arrow prev" aria-label="Ảnh trước">&#10094;</button>
            <button type="button" class="gallery-arrow next" aria-label="Ảnh tiếp theo">&#10095;</button>
            <span class="gallery-count" aria-live="polite">1 / {gallery.length}</span>
          </>
        )}
      </div>
      {gallery.length > 1 && (
        <div class="gallery-thumbs" aria-label="Chọn ảnh">
          {gallery.map((src, index) => (
            <button type="button" class:list={['gallery-thumb', { active: index === 0 }]} data-index={index} aria-label={`Xem ảnh ${index + 1}`} aria-pressed={index === 0}>
              <img src={src} alt={`Ảnh ${index + 1} của ${property.title}`} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      )}
    </div>
  )}

  <h1 class="property-title">{property.title}</h1>
  {property.listingStatus === 'closed' && <p class="property-status">Bất động sản này đã giao dịch</p>}
  {property.listingStatus === 'paused' && <p class="property-status">Bất động sản đang tạm ngừng giao dịch</p>}

  <div class="spec-grid">
    {specs.map((spec) => (
      <div class="spec-card">
        <strong class:list={['spec-value', { 'price-text': spec.price }]}>{spec.value}</strong>
        <span class="spec-label">{spec.label}</span>
      </div>
    ))}
    {pricePerSqm && (
    <div class="unit-price-card">
      <strong>{pricePerSqm} triệu/m²</strong>
      <span>Đơn giá theo diện tích {kind === 'can-ho' ? 'căn hộ' : 'đất'}</span>
    </div>
    )}
  </div>

  <div class="contact-actions" aria-label="Liên hệ tư vấn">
    <a class="contact-call" href={`tel:${phone.replace(/[^\d+]/g, '')}`}><span aria-hidden="true">☎</span> Gọi tư vấn</a>
    <a class="contact-zalo" href={`https://zalo.me/${encodeURIComponent(zalo)}`} target="_blank" rel="noopener noreferrer">Nhắn Zalo</a>
  </div>

  <section class="property-info" aria-label="Thông tin chi tiết">
    <h2>Thông tin chi tiết {kind === 'can-ho' ? 'căn hộ' : 'nhà đất'}</h2>
    <div class="property-description is-collapsed" id={`${uniqueId}-description`}>
      {property.description && <p class="summary-description">{property.description}</p>}
      <div class="cms-body"><slot /></div>
    </div>
    <button type="button" class="description-toggle" aria-controls={`${uniqueId}-description`} aria-expanded="false">
      <span>Xem thêm</span><svg class="description-hover-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
    </button>
  </section>

  {details.length > 0 && (
    <section class="property-parameters" aria-label="Thông số bất động sản">
      <h2>Thông số bất động sản</h2>
      <dl class="parameters-grid">
        {details.map((item) => (
          <div class="parameter-row">
            <svg class="parameter-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {item.icon === 'tag' && <><circle cx="9" cy="12" r="7"/><path d="M9 8v8m3-6H8m7 2h6"/></>}
              {item.icon === 'area' && <><rect x="4" y="6" width="16" height="13" rx="1"/><path d="M4 3h16M2 6v13m20-13v13"/></>}
              {item.icon === 'bed' && <><path d="M3 5v15M21 12v8M3 16h18M3 12h18v4M6 9h5a2 2 0 0 1 2 2v1"/></>}
              {item.icon === 'bath' && <><path d="M3 13h18v2a6 6 0 0 1-6 6H9a6 6 0 0 1-6-6v-2ZM6 13V6a3 3 0 0 1 6 0M8 21v1m8-1v1"/></>}
              {item.icon === 'floors' && <><rect x="5" y="3" width="10" height="18"/><path d="M15 10h5v11M8 7h2m-2 4h2m-2 4h2m-2 6v-3h4v3m5-7h1m-1 3h1"/></>}
              {item.icon === 'compass' && <><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5 5-2Z"/></>}
              {item.icon === 'frontage' && <><path d="M4 6h16M4 18h16M7 3 4 6l3 3M17 3l3 3-3 3M7 15l-3 3 3 3m10-6 3 3-3 3"/></>}
              {item.icon === 'road' && <><path d="M8 3 4 21m12-18 4 18M12 4v4m0 4v4m0 4v1"/></>}
              {item.icon === 'legal' && <><path d="M6 2h9l5 5v15H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm9 0v5h5M8 12h8m-8 4h8"/></>}
              {item.icon === 'furniture' && <><path d="M4 11V8a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v3M3 12a2 2 0 0 1 4 0v4h10v-4a2 2 0 0 1 4 0v7H3v-7Zm3 7v2m12-2v2"/></>}
              {item.icon === 'home' && <><path d="m3 11 9-8 9 8v10H3V11Zm6 10v-8h6v8"/></>}
              {item.icon === 'location' && <><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></>}
            </svg>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-property-detail]').forEach((root) => {
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const featured = root.querySelector<HTMLImageElement>('.gallery-featured');
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('.gallery-thumb'));
    const counter = root.querySelector<HTMLElement>('.gallery-count');
    let current = 0;
    const showImage = (index: number) => {
      if (!featured || !thumbs.length) return;
      current = (index + thumbs.length) % thumbs.length;
      const img = thumbs[current].querySelector<HTMLImageElement>('img');
      if (!img) return;
      featured.src = img.src;
      featured.alt = img.alt;
      thumbs.forEach((button, i) => {
        button.classList.toggle('active', i === current);
        button.setAttribute('aria-pressed', String(i === current));
      });
      if (counter) counter.textContent = `${current + 1} / ${thumbs.length}`;
    };
    thumbs.forEach((button, index) => button.addEventListener('click', () => showImage(index)));
    root.querySelector('.gallery-arrow.prev')?.addEventListener('click', () => showImage(current - 1));
    root.querySelector('.gallery-arrow.next')?.addEventListener('click', () => showImage(current + 1));
    const content = root.querySelector<HTMLElement>('.property-description');
    const toggle = root.querySelector<HTMLButtonElement>('.description-toggle');
    if (content && toggle) {
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(expanded));
        content.classList.toggle('is-collapsed', !expanded);
        const label = toggle.querySelector('span');
        if (label) label.textContent = expanded ? 'Thu gọn' : 'Xem thêm';
      });
    }
  });
</script>

<style>
  .property-detail{width:100%;max-width:1100px;margin:0 auto;color:#202b32;font-family:inherit}
  .property-gallery{margin-bottom:22px}.gallery-main{position:relative;overflow:hidden;border-radius:18px;background:#000;aspect-ratio:16/9}
  .gallery-featured{width:100%;height:100%;object-fit:contain;display:block}.gallery-arrow{position:absolute;top:50%;transform:translateY(-50%);width:43px;height:43px;border:0;border-radius:50%;background:rgba(255,255,255,.92);color:#26343b;cursor:pointer;font-size:22px;box-shadow:0 2px 12px #0002}
  .gallery-arrow.prev{left:14px}.gallery-arrow.next{right:14px}.gallery-arrow:hover{background:#fff}.gallery-count{position:absolute;right:16px;bottom:14px;border-radius:20px;background:#0009;color:#fff;padding:6px 12px;font-size:13px}
  .gallery-thumbs{display:flex;gap:10px;overflow-x:auto;padding:12px 2px 3px}.gallery-thumb{flex:0 0 108px;height:72px;border:3px solid transparent;border-radius:11px;overflow:hidden;padding:0;background:#000;cursor:pointer}.gallery-thumb.active{border-color:#176347}.gallery-thumb img{width:100%;height:100%;object-fit:contain;display:block}
  .property-title{font-size:clamp(23px,3vw,32px);line-height:1.35;font-weight:750;margin:8px 0 18px}.property-status{display:inline-block;padding:8px 12px;background:#fff1ed;border-radius:8px;color:#a3432a;font-weight:600;margin:0 0 14px}
  .spec-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.spec-card,.unit-price-card{background:#fff;border:1px solid #dce4e8;border-radius:11px;padding:13px 7px;text-align:center;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:5px;min-width:0;box-shadow:0 2px 8px #142e4310}
  .spec-value{font-size:clamp(15px,1.7vw,19px);line-height:1.3;overflow-wrap:anywhere}.price-text,.unit-price-card strong{color:#a82424}.spec-label,.unit-price-card span{font-size:11px;color:#66737a;line-height:1.35}.unit-price-card{margin:0}.unit-price-card strong{font-size:clamp(14px,1.6vw,18px);line-height:1.3}
  .contact-actions{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0 22px}.contact-actions a{display:flex;justify-content:center;align-items:center;gap:9px;min-height:52px;border-radius:12px;text-decoration:none;font-size:16px;font-weight:700;transition:filter .2s}.contact-actions a:hover{filter:brightness(.95)}.contact-call{background:#176347;color:white}.contact-zalo{background:#e9edef;color:#25353b}
  .property-info{background:#f5f6f7;border-radius:16px;padding:22px}.property-info h2{font-size:21px;margin:0 0 14px}.property-description{position:relative;line-height:1.75;overflow-wrap:anywhere}.property-description.is-collapsed{max-height:148px;overflow:hidden}.property-description.is-collapsed:after{content:"";position:absolute;left:0;right:0;bottom:0;height:66px;background:linear-gradient(transparent,#f5f6f7);pointer-events:none}.summary-description{margin:0 0 12px;white-space:pre-line}.details-list{display:grid;grid-template-columns:1fr 1fr;gap:0 20px;margin:0 0 14px}.detail-row{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid #e3e7e9;padding:9px 0}.detail-row dt{color:#6a777e}.detail-row dd{margin:0;font-weight:600;text-align:right}.cms-body :global(img){max-width:100%;height:auto;border-radius:10px}.cms-body :global(p){margin:0 0 12px}.cms-body :global(h2),.cms-body :global(h3){margin:18px 0 10px}
  .description-toggle{display:flex;align-items:center;justify-content:center;gap:5px;width:max-content;max-width:100%;min-height:36px;margin:8px auto 0;padding:4px 8px;background:transparent;border:0;border-radius:0;color:#176347;font-weight:700;font-size:14px;cursor:pointer}.description-toggle:hover{background:transparent;text-decoration:underline}.description-hover-icon{width:16px;height:16px;opacity:0;transform:translateX(-5px);transition:opacity .18s ease,transform .18s ease}.description-toggle:hover .description-hover-icon,.description-toggle:focus-visible .description-hover-icon{opacity:1;transform:translateX(0)}
  .property-parameters{margin-top:22px;background:#fff;border:1px solid #e5e9eb;border-radius:16px;padding:24px}.property-parameters h2{font-size:22px;margin:0 0 16px}.parameters-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:30px;margin:0}.parameter-row{display:grid;grid-template-columns:25px minmax(100px,1fr) minmax(0,1fr);align-items:center;gap:12px;min-height:50px;border-bottom:1px solid #e9edef;padding:10px 0}.parameter-icon{width:22px;height:22px;color:#263c49}.parameter-row dt{font-size:14px;font-weight:550}.parameter-row dd{font-size:14px;margin:0;overflow-wrap:anywhere}
  @media(max-width:640px){.gallery-main{aspect-ratio:4/3;border-radius:13px}.gallery-thumb{flex-basis:78px;height:57px}.spec-grid{gap:5px}.spec-card,.unit-price-card{padding:9px 3px;min-height:76px}.spec-value{font-size:13px}.unit-price-card strong{font-size:12px}.spec-label,.unit-price-card span{font-size:10px}.contact-actions{gap:8px}.contact-actions a{font-size:14px;min-height:49px}.property-info{padding:16px}.property-info h2{font-size:19px}.parameters-grid{grid-template-columns:1fr}.property-parameters{padding:16px}.parameter-row{grid-template-columns:24px minmax(95px,1fr) minmax(0,1fr);gap:9px}.gallery-arrow{width:35px;height:35px}}
</style>
